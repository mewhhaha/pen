// Where each number sits in a devtools frame answer: the milliseconds since the
// frame before; the game's frame phases in milliseconds (guest, waited for an
// overlapped guest, packet decode, validation, rendering, surface acquisition,
// presentation, explicit pacing waits, housekeeping, and their total), each -1
// when the frame was not timed or did not run. Drawing phases do not overlap:
// render covers preparation, uploads, command encoding, queue submission and the
// developer overlay, excluding acquire and present calls; acquire and present
// include any waits inside those calls. Pace covers browser GPU backpressure and
// repaint waits (zero natively, whose event-loop pacing is outside the measured
// frame). These are wall-clock call durations, not thread CPU time; driver
// stalls inside queue submission remain in render. Housekeeping includes audio,
// input and capture work. Then its packet's bytes; the renderer's draw calls,
// instanced ones and instances; the frame's meshes and brushes; the game's
// memory in bytes; the frame's width and height in pixels; and the timeline: the
// next frame's position, 1 when paused, replaying, keeping history or
// overlapping frames, and the frame an input recording started at, or -1. Then
// the renderer's culling: draws and instances left out of the camera's view, and
// casters left out of the shadow maps (once for each map); the triangles drawn;
// the render scale the scene drew at; and the GPU's milliseconds over a recent
// frame's shadow maps, culling, scene, the passes after it, sprites and insets,
// and the whole frame, each -1 where the GPU has no timestamps.
const devtools_frame_interval = 0
const devtools_frame_guest = 1
const devtools_frame_wait = 2
const devtools_frame_decode = 3
const devtools_frame_validate = 4
const devtools_frame_render = 5
const devtools_frame_acquire = 6
const devtools_frame_present = 7
const devtools_frame_pace = 8
const devtools_frame_housekeeping = 9
const devtools_frame_total = 10
const devtools_frame_packet = 11
const devtools_frame_draw_calls = 12
const devtools_frame_instanced_draw_calls = 13
const devtools_frame_instances = 14
const devtools_frame_meshes = 15
const devtools_frame_brushes = 16
const devtools_frame_memory = 17
const devtools_frame_width = 18
const devtools_frame_height = 19
const devtools_frame_position = 20
const devtools_frame_paused = 21
const devtools_frame_replaying = 22
const devtools_frame_history = 23
const devtools_frame_pipelined = 24
const devtools_frame_recording = 25
const devtools_frame_culled = 26
const devtools_frame_shadow_culled = 27
