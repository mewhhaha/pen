  destination[base + 3] := canonical[at + 0]
  at := at + 1
  destination[base + 4] := canonical[at + 0]
  destination[base + 5] := canonical[at + 1]
  destination[base + 6] := canonical[at + 2]
  at := at + 3
  destination[base + 7] := canonical[at + 0]
  destination[base + 8] := canonical[at + 1]
  destination[base + 9] := canonical[at + 2]
  at := at + 3
  destination[base + 10] := canonical[at + 0]
  at := at + 1
  destination[base + 11] := canonical[at + 0]
  at := at + 1
  return at

const listener_into = func (canonical: Array F32) -> (start: U32) -> (destination: ResizeArray F32) -> (children: ResizeArray F32) -> (extras: ResizeArray F32): U32 => return do:
  let at = start
  let base = destination.length
  for 0 .. 9:
    @storage.push destination 0.0
  destination[base + 0] := canonical[at + 0]
  destination[base + 1] := canonical[at + 1]
  destination[base + 2] := canonical[at + 2]
  at := at + 3
  destination[base + 3] := canonical[at + 0]
  destination[base + 4] := canonical[at + 1]
  destination[base + 5] := canonical[at + 2]
  at := at + 3
  destination[base + 6] := canonical[at + 0]
  destination[base + 7] := canonical[at + 1]
  destination[base + 8] := canonical[at + 2]
  at := at + 3
  return at

const panner_into = func (canonical: Array F32) -> (start: U32) -> (destination: ResizeArray F32) -> (children: ResizeArray F32) -> (extras: ResizeArray F32): U32 => return do:
  let at = start
  let base = destination.length
  for 0 .. 15:
    @storage.push destination 0.0
  destination[base + 0] := canonical[at + 0]
  at := at + 1
  destination[base + 1] := canonical[at + 0]
  at := at + 1
  destination[base + 2] := canonical[at + 0]
  destination[base + 3] := canonical[at + 1]
  destination[base + 4] := canonical[at + 2]
  at := at + 3
  destination[base + 5] := canonical[at + 0]
  destination[base + 6] := canonical[at + 1]
  destination[base + 7] := canonical[at + 2]
  at := at + 3
  destination[base + 8] := canonical[at + 0]
  at := at + 1
  destination[base + 9] := canonical[at + 0]
  at := at + 1
  destination[base + 10] := canonical[at + 0]
  at := at + 1
  destination[base + 11] := canonical[at + 0]
  at := at + 1
  destination[base + 12] := canonical[at + 0]
  at := at + 1
  destination[base + 13] := canonical[at + 0]
  at := at + 1
  destination[base + 14] := canonical[at + 0]
  at := at + 1
  return at

const instance_into = func (canonical: Array F32) -> (start: U32) -> (destination: ResizeArray F32) -> (children: ResizeArray F32) -> (extras: ResizeArray F32): U32 => return do:
  let at = start
  let base = destination.length
  for 0 .. 26:
    @storage.push destination 0.0
  destination[base + 0] := canonical[at + 0]
  at := at + 1
  destination[base + 1] := canonical[at + 0]
  at := at + 1
  destination[base + 2] := canonical[at + 0]
  at := at + 1
  destination[base + 3] := canonical[at + 0]
  at := at + 1
  destination[base + 4] := canonical[at + 0]
  at := at + 1
  destination[base + 5] := canonical[at + 0]
  destination[base + 6] := canonical[at + 1]
  destination[base + 7] := canonical[at + 2]
  destination[base + 8] := canonical[at + 3]
  destination[base + 9] := canonical[at + 4]
  destination[base + 10] := canonical[at + 5]
  destination[base + 11] := canonical[at + 6]
  destination[base + 12] := canonical[at + 7]
  destination[base + 13] := canonical[at + 8]
  destination[base + 14] := canonical[at + 9]
  destination[base + 15] := canonical[at + 10]
  destination[base + 16] := canonical[at + 11]
  destination[base + 17] := canonical[at + 12]
  destination[base + 18] := canonical[at + 13]
  destination[base + 19] := canonical[at + 14]
  destination[base + 20] := canonical[at + 15]
  at := at + 16
  let present = lanes.integer canonical[at] 1
  at := at + 1
  if present == 1:
    destination[base + 21] := 4.0
    destination[base + 22] := canonical[at + 0]
    destination[base + 23] := canonical[at + 1]
    destination[base + 24] := canonical[at + 2]
    destination[base + 25] := canonical[at + 3]
    at := at + 4
  return at

const instance_removal_into = func (canonical: Array F32) -> (start: U32) -> (destination: ResizeArray F32) -> (children: ResizeArray F32) -> (extras: ResizeArray F32): U32 => return do:
  let at = start
  let base = destination.length
  for 0 .. 2:
    @storage.push destination 0.0
  destination[base + 0] := canonical[at + 0]
  at := at + 1
  destination[base + 1] := canonical[at + 0]
  at := at + 1
  return at

// Canonical render values streamed into named packet, inset-draw and extra pools.
