// Bounce: a ball in a walled yard. The arrow keys roll it; it bounces off
// the walls with a blip, and each bounce sets a marker on the far wall. It
// builds on pen's bindings alone (pen/), with two things of its own that its
// pen.json declares: the Kick event, which pushes the ball, and the Score
// section, which says every frame how the ball is doing (`pen packets` writes
// it out by name).
import * as array from "std/array"
import * as extensions from "pen/extensions"
import * as frame from "pen/frame"
import * as protocol from "pen/protocol"
import * as types from "pen/types"
import * as program from "pen/program"
import * as codec from "pen/protocol_render"
import { Vec3 } from "std/vector"
import { meshes, materials, sounds } from "./assets/catalog.json"

// The version of the state `save` makes.
const schema = 1

// How far the yard runs from its middle, the ball's radius, how fast the
// held arrows speed it up (units a second, each second), and how much of its
// speed it loses each second.
const yard = 4.0
const radius = 0.5
const push = 6.0
const drag = 0.3

// The arrows held, a bit each.
const left = 1
const right = 2
const up = 4
const down = 8
const all = 15

type World is data = $World { x: F32, z: F32, vx: F32, vz: F32, bounces: U32, held: U32 }

const create = func () => return $World { x: 0.0, z: 0.0, vx: 0.0, vz: 0.0, bounces: 0, held: 0 }

// The world as lanes, for quicksaves, time travel and reloads, and back.
const save = func (world: World) => return
  #[world.x, world.z, world.vx, world.vz, U32.to_f32 world.bounces, U32.to_f32 world.held]
const restore = func state => return $World {
  x: (state.at 0), z: (state.at 1), vx: (state.at 2), vz: (state.at 3), bounces: F32.to_u32 (state.at 4), held: F32.to_u32 (state.at 5),
}

// The arrow a key is, as its bit; 0 for any other key.
const arrow = func (code: U32) => return do:
  if code == protocol.key_arrow_left:
    return left
  if code == protocol.key_arrow_right:
    return right
  if code == protocol.key_arrow_up:
    return up
  if code == protocol.key_arrow_down:
    return down
  return 0

// What an event does to the world: an arrow held or let go, a kick.
const take = func (world: World) => return func (event: extensions.Event) => return do:
  let next = world
  if let $extensions.Kick { x, z } = event:
    next.vx := self + x
    next.vz := self + z
  if let $extensions.Pen ($protocol.KeyDown code) = event:
    next.held := self | arrow code
  if let $extensions.Pen ($protocol.KeyUp code) = event:
    next.held := self & (all ^ arrow code)
  if let $extensions.Pen $protocol.FocusLost = event:
    next.held := 0
  return next

// How much the held arrows `positive` and `negative` push along their axis.
const pushed = func (held: U32) => return func (positive: U32) => return func (negative: U32) => return do:
  let force = 0.0
  if (held & positive) != 0:
    force := self + push
  if (held & negative) != 0:
    force := self - push
  return force

// The ball `seconds` later: pushed by the arrows held, slowed by drag and
// turned back by the walls; and whether it hit one.
const roll = func (world: World) => return func (seconds: F32) => return do:
  let slowed = 1.0 - drag * seconds
  let vx = (world.vx + pushed world.held right left * seconds) * slowed
  let vz = (world.vz + pushed world.held down up * seconds) * slowed
  let x = world.x + vx * seconds
  let z = world.z + vz * seconds
  let edge = yard - radius
  let hit = false
  if x > edge:
    x := edge + edge - self
    vx := 0.0 - F32.abs vx
    hit := true
  if x < 0.0 - edge:
    x := 0.0 - edge - edge - self
    vx := F32.abs vx
    hit := true
  if z > edge:
    z := edge + edge - self
    vz := 0.0 - F32.abs vz
    hit := true
  if z < 0.0 - edge:
    z := 0.0 - edge - edge - self
    vz := F32.abs vz
    hit := true
  let bounces = world.bounces
  if hit:
    bounces := self + 1
  return ($World { x, z, vx, vz, bounces, held: world.held }, hit)

const vec4 = func x => return func y => return func z => return func w => return $types.Vec4 { x, y, z, w }

// A mesh stretched by (sx, sy, sz), then moved to (x, y, z); column-major,
// as the packet carries matrices.
const placed = func (x: F32) => return func (y: F32) => return func (z: F32) => return func (sx: F32) => return func (sy: F32) => return func (sz: F32) => return
  $types.Mat4 { x: vec4 sx 0.0 0.0 0.0, y: vec4 0.0 sy 0.0 0.0, z: vec4 0.0 0.0 sz 0.0, w: vec4 x y z 1.0 }

const draw = func (mesh: U32) => return func (material: U32) => return func (transform: types.Mat4) => return
  { mesh, material, transform }

// The eye at `eye`, looking at `target`, the sky up.
const look_at = func (eye: Vec3) => return func (target: Vec3) => return do:
  let forward = (target - eye).normalized
  let side = (forward.cross ($Vec3 { x: 0.0, y: 1.0, z: 0.0 })).normalized
  let above = side.cross forward
  return $types.Mat4 {
    x: vec4 side.x above.x (0.0 - forward.x) 0.0,
    y: vec4 side.y above.y (0.0 - forward.y) 0.0,
    z: vec4 side.z above.z (0.0 - forward.z) 0.0,
    w: vec4 (0.0 - side.dot eye) (0.0 - above.dot eye) (forward.dot eye) 1.0,
  }

// A perspective seeing `focal` (1 over the tangent of half the vertical field
// of view) at `aspect`, into WebGPU's depth of 0 to 1.
const perspective = func (focal: F32) => return func (aspect: F32) => return do:
  let near = 0.1
  let far = 100.0
  return $types.Mat4 {
    x: vec4 (focal / aspect) 0.0 0.0 0.0,
    y: vec4 0.0 focal 0.0 0.0,
    z: vec4 0.0 0.0 (0.0 - far / (far - near)) (-1.0),
    w: vec4 0.0 0.0 (0.0 - near * far / (far - near)) 0.0,
  }

// From above the near wall, down over the yard.
const camera = look_at ($Vec3 { x: 0.0, y: 7.5, z: 7.0 }) ($Vec3 { x: 0.0, y: -0.5, z: 0.6 })

// The floor and the four walls round it.
const wall = yard + 0.15
const yard_draws = #[
  draw meshes.box materials.floor (placed 0.0 (-0.6) 0.0 (yard + 0.3) 0.1 (yard + 0.3)),
  draw meshes.box materials.wall (placed wall (-0.2) 0.0 0.15 0.4 (yard + 0.3)),
  draw meshes.box materials.wall (placed (0.0 - wall) (-0.2) 0.0 0.15 0.4 (yard + 0.3)),
  draw meshes.box materials.wall (placed 0.0 (-0.2) wall (yard + 0.3) 0.4 0.15),
  draw meshes.box materials.wall (placed 0.0 (-0.2) (0.0 - wall) (yard + 0.3) 0.4 0.15),
]

// A marker on the far wall for each bounce, sixteen at most.
const markers = func (bounces: U32) => return
  #[draw meshes.box materials.marker (placed (U32.to_f32 index * 0.5 - 3.75) 0.35 (0.0 - wall) 0.15 0.15 0.15)
    | index <- array.generate (min bounces 16) identity]

// What the world looks like, and the blip of a bounce.
const view = func (world: World) -> (hit: Bool) -> (input: extensions.Input) -> (draws: ResizeArray codec.MeshDraw) -> (sounds_out: ResizeArray types.Sound) => return do:
  @storage.truncate draws 0
  @storage.truncate sounds_out 0
  let drawn = frame.header schema
  drawn.view := camera
  drawn.projection := perspective 1.8 (input.width / input.height)
  drawn.clear := $types.Color { r: 0.55, g: 0.7, b: 0.85, a: 1.0 }
  drawn.ambient := $types.Vector { x: 0.3, y: 0.32, z: 0.36 }
  drawn.light_direction := $types.Vector { x: -0.35, y: -1.0, z: -0.5 }
  let ball = draw meshes.ball materials.ball (placed world.x 0.0 world.z radius radius radius)
  @storage.push draws ball
  for item in yard_draws:
    @storage.push draws item
  for item in markers world.bounces:
    @storage.push draws item
  if hit:
    @storage.push sounds_out ($types.Sound { clip: sounds.bounce, bus: 0, gain: 0.5, pan: world.x / yard, pitch: 1.0, lowpass: 24000.0, reverb: 0.0 })
  return drawn

// One frame: the events, then the ball rolls on (a tenth of a second at
// most), then how it looks and its Score.
const step = func (world: World) => return func (input: extensions.Input) => return do:
  let taken = world
  for event in input.events:
    taken := take taken event
  let (next, hit) = roll taken (min input.elapsed 0.1)
  return (next, hit)

// One Score section, encoded after the render packet with its fixed framing.
const score = func (world: World) => return do:
  let packet: ResizeArray F32 = #[protocol.extensions_marker, 1.0]
  extensions.append_score #[$extensions.Score {
    bounces: world.bounces, speed: F32.sqrt (world.vx * world.vx + world.vz * world.vz),
  }] packet
  return @storage.freeze packet

// Compile-known callbacks operate on one named world pool. Presentation rejection
// needs no cache repair here; it never rolls simulation back.
const acknowledge = func access -> published => return ()
const execute = func access -> operation -> payload -> outgoing => return do:
  let world = access.world
  let events = access.events
  let draws = access.draws
  let sounds: ResizeArray types.Sound = access.sounds
  let rendered: ResizeArray F32 = access.rendered
  case operation of
    1 => do:
      world[0] := create ()
      program.append (save world[0]) outgoing
    2 => do:
      let input = extensions.decode_input_into payload events
      let (next, hit) = step world[0] input
      world[0] := next
      let header = view next hit input draws sounds
      codec.encode_mesh_frame header (&draws[0..draws.length]) (&sounds[0..sounds.length]) rendered
      program.append rendered outgoing
      program.append (score next) outgoing
    3 => program.append (save world[0]) outgoing
    4 => do:
      world[0] := restore payload
      program.append (save world[0]) outgoing
    _ => @panic "scenes are not supported"

const run = func host => return do:
  let world: Array World = #[create ()]
  let events: ResizeArray extensions.Event = #[]
  let draws: ResizeArray codec.MeshDraw = #[]
  let sounds: ResizeArray types.Sound = #[]
  let rendered: ResizeArray F32 = #[]
  let incoming: ResizeArray F32 = #[]
  let outgoing: ResizeArray F32 = #[]
  let access = {world, events, draws, sounds, rendered}
  use program.run execute acknowledge access schema false incoming outgoing host
  return ()

const game = { schema, create, step, save, restore }
