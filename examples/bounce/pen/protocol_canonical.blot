  stream.output[154] := canonical[at + 0]
  at := at + 1
  stream.output[156] := canonical[at + 0]
  at := at + 1
  stream.output[157] := canonical[at + 0]
  stream.output[158] := canonical[at + 1]
  at := at + 2
  stream.output[159] := canonical[at + 0]
  at := at + 1
  stream.output[174] := canonical[at + 0]
  at := at + 1
  stream.output[175] := canonical[at + 0]
  at := at + 1
  stream.output[176] := canonical[at + 0]
  at := at + 1
  stream.output[177] := canonical[at + 0]
  at := at + 1
  stream.output[178] := canonical[at + 0]
  at := at + 1
  let state_start: U32 = stream.output.length
  let state_count: U32 = 0
  state_count := lanes.integer canonical[at] lanes.max_integer
  at := at + 1
  for index in 0 .. state_count:
    @storage.push stream.output canonical[at + index]
  at := at + state_count
  stream.output[2] := U32.to_f32 (stream.output.length - state_start)
  let draws_start: U32 = stream.output.length
  let draws_count = lanes.integer canonical[at] lanes.max_integer
  at := at + 1
  stream.at := at
  for 0 .. draws_count:
    stream := draw_into canonical stream
  at := stream.at
  stream.output[3] := U32.to_f32 draws_count
  let solids_start: U32 = stream.output.length
  let solids_count = lanes.integer canonical[at] lanes.max_integer
  at := at + 1
  stream.at := at
  for 0 .. solids_count:
    stream := solid_into canonical stream
  at := stream.at
  stream.output[4] := U32.to_f32 solids_count
  stream.output[5] := U32.to_f32 (stream.output.length - solids_start)
  let decals_start: U32 = stream.output.length
  let decals_count = lanes.integer canonical[at] lanes.max_integer
  at := at + 1
  stream.at := at
  for 0 .. decals_count:
    stream := decal_into canonical stream
  at := stream.at
  stream.output[6] := U32.to_f32 decals_count
  let sounds_start: U32 = stream.output.length
  let sounds_count = lanes.integer canonical[at] lanes.max_integer
  at := at + 1
  stream.at := at
  for 0 .. sounds_count:
