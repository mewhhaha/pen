  ]

// A InstanceRemoval's lanes.
func encode_instance_removal (instance_removal: types.InstanceRemoval) =>
  return #[
    U32.to_f32 (instance_removal.id_low), U32.to_f32 (instance_removal.id_high),
  ]

// A Draw's extra, at most protocol.max_draw_extra of them, for the packet's last
// section.
func encode_draw_extra (draw: types.Draw) =>
  let kept = min draw.extra.length protocol.max_draw_extra
  return #[lane | index <- array.generate kept identity, lane <- vec4_lanes draw.extra[index]]

func vec4_lanes (v: types.Vec4) => #[v.x, v.y, v.z, v.w]

func encode_render_views (packet: types.RenderHeader) -> collections -> project -> context -> (encoded: own #[~F32]) =>
