// Solid: its faces' count, then each of them.
const encode_solid = func (solid: types.Solid) => return do:
  let faces = solid.faces
  let encoded = @array.fill (protocol.solid_floats + faces.length * protocol.solid_face_floats) 0.0
  encoded[0] := U32.to_f32 faces.length
