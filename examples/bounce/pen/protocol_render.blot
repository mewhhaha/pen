// FieldPatch: its material, width, height, x, z, columns, rows, then its values.
func encode_field_patch (field_patch: types.FieldPatch) =>
  return array.concat #[
    U32.to_f32 (field_patch.material), U32.to_f32 (field_patch.width),
    U32.to_f32 (field_patch.height), U32.to_f32 (field_patch.x),
    U32.to_f32 (field_patch.z), U32.to_f32 (field_patch.columns),
    U32.to_f32 (field_patch.rows),
  ] field_patch.values

// UiNode: its id, parent, role, x, y, width, height, focusable, focused,
// disabled, hidden, modal, checked, expanded, selected, live, value, minimum,
// maximum, step, actions, text_length, name_length, description_length, then its
// text.
func encode_ui_node (ui_node: types.UiNode) =>
  return array.concat #[
    U32.to_f32 (ui_node.id), U32.to_f32 (ui_node.parent),
    U32.to_f32 (ui_node.role), ui_node.x, ui_node.y, ui_node.width,
