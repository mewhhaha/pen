  for i in 0 .. solids_count:
    let source = collections.solids[i]
    let solid = project.solid context source
    let count: U32 = solid.faces.length
    @storage.push encoded (U32.to_f32 count)
    for i in 0 .. count:
      let item = solid.faces.at i
      @storage.push encoded (item.normal.x)
      @storage.push encoded (item.normal.y)
      @storage.push encoded (item.normal.z)
      @storage.push encoded (item.distance)
      @storage.push encoded (U32.to_f32 (item.material))
  encoded[start + 5] := U32.to_f32 ((encoded.length - solids_start))
  for i in 0 .. decals_count:
    let source = collections.decals[i]
    let decal: types.Decal = project.decal context source
    @storage.push encoded (U32.to_f32 (decal.material))
    let $types.Mat4 { x: transform_x, y: transform_y, z: transform_z, w: transform_w } = decal.transform
    @storage.push encoded (transform_x.x)
    @storage.push encoded (transform_x.y)
    @storage.push encoded (transform_x.z)
    @storage.push encoded (transform_x.w)
    @storage.push encoded (transform_y.x)
    @storage.push encoded (transform_y.y)
    @storage.push encoded (transform_y.z)
    @storage.push encoded (transform_y.w)
    @storage.push encoded (transform_z.x)
    @storage.push encoded (transform_z.y)
    @storage.push encoded (transform_z.z)
    @storage.push encoded (transform_z.w)
    @storage.push encoded (transform_w.x)
    @storage.push encoded (transform_w.y)
    @storage.push encoded (transform_w.z)
    @storage.push encoded (transform_w.w)
    @storage.push encoded (decal.opacity)
  for i in 0 .. sounds_count:
    let source = collections.sounds[i]
    let sound: types.Sound = project.sound context source
    @storage.push encoded (U32.to_f32 (sound.clip))
    @storage.push encoded (U32.to_f32 (sound.bus))
    @storage.push encoded (sound.gain)
    @storage.push encoded (sound.pan)
    @storage.push encoded (sound.pitch)
    @storage.push encoded (sound.lowpass)
    @storage.push encoded (sound.reverb)
  for i in 0 .. sprites_count:
    let source = collections.sprites[i]
    let (x, y, width, height, u0, v0, u1, v1, material) = project.sprite_rect context source
    let (c0, c1, c2, c3) = project.sprite_color context source
    let (p0, p1, p2, p3) = project.sprite_parameters context source
    @storage.push encoded (x)
    @storage.push encoded (y)
    @storage.push encoded (width)
    @storage.push encoded (height)
    @storage.push encoded (u0)
    @storage.push encoded (v0)
    @storage.push encoded (u1)
    @storage.push encoded (v1)
    @storage.push encoded (c0)
    @storage.push encoded (c1)
    @storage.push encoded (c2)
    @storage.push encoded (c3)
    @storage.push encoded (U32.to_f32 material)
    @storage.push encoded (p0)
    @storage.push encoded (p1)
    @storage.push encoded (p2)
    @storage.push encoded (p3)
  for i in 0 .. insets_count:
    let source = collections.insets[i]
    let inset = project.inset context source
    @storage.push encoded (inset.x)
    @storage.push encoded (inset.y)
    @storage.push encoded (inset.width)
    @storage.push encoded (inset.height)
    let $types.Mat4 { x: view_x, y: view_y, z: view_z, w: view_w } = inset.view
    @storage.push encoded (view_x.x)
    @storage.push encoded (view_x.y)
    @storage.push encoded (view_x.z)
    @storage.push encoded (view_x.w)
    @storage.push encoded (view_y.x)
    @storage.push encoded (view_y.y)
    @storage.push encoded (view_y.z)
    @storage.push encoded (view_y.w)
    @storage.push encoded (view_z.x)
    @storage.push encoded (view_z.y)
    @storage.push encoded (view_z.z)
    @storage.push encoded (view_z.w)
    @storage.push encoded (view_w.x)
    @storage.push encoded (view_w.y)
    @storage.push encoded (view_w.z)
    @storage.push encoded (view_w.w)
    let $types.Mat4 { x: projection_x, y: projection_y, z: projection_z, w: projection_w } = inset.projection
    @storage.push encoded (projection_x.x)
    @storage.push encoded (projection_x.y)
    @storage.push encoded (projection_x.z)
    @storage.push encoded (projection_x.w)
    @storage.push encoded (projection_y.x)
    @storage.push encoded (projection_y.y)
    @storage.push encoded (projection_y.z)
    @storage.push encoded (projection_y.w)
    @storage.push encoded (projection_z.x)
    @storage.push encoded (projection_z.y)
    @storage.push encoded (projection_z.z)
    @storage.push encoded (projection_z.w)
    @storage.push encoded (projection_w.x)
    @storage.push encoded (projection_w.y)
    @storage.push encoded (projection_w.z)
    @storage.push encoded (projection_w.w)
    @storage.push encoded (inset.ambient.x)
    @storage.push encoded (inset.ambient.y)
    @storage.push encoded (inset.ambient.z)
    @storage.push encoded (inset.light_direction.x)
    @storage.push encoded (inset.light_direction.y)
    @storage.push encoded (inset.light_direction.z)
    @storage.push encoded (inset.light_color.x)
    @storage.push encoded (inset.light_color.y)
    @storage.push encoded (inset.light_color.z)
    @storage.push encoded (U32.to_f32 (inset.draws.length))
    @storage.push encoded (inset.pixel_size)
    @storage.push encoded (U32.to_f32 (inset.after_sprites))
  let inset_draws_start = encoded.length
  for parent in 0 .. insets_count:
    let children = project.inset_draws context collections.insets[parent]
    let count: U32 = children.length
    for i in 0 .. count:
      let source = children.at i
      let (mesh, material) = project.draw_metadata context source
      let (m0, m1, m2, m3, m4, m5, m6, m7, m8, m9, m10, m11, m12, m13, m14, m15) = project.draw_transform context source
      let (present, p0, p1, p2, p3) = project.draw_parameters context source
      @storage.push encoded (U32.to_f32 mesh)
      @storage.push encoded (U32.to_f32 material)
      @storage.push encoded (m0)
      @storage.push encoded (m1)
      @storage.push encoded (m2)
      @storage.push encoded (m3)
      @storage.push encoded (m4)
      @storage.push encoded (m5)
      @storage.push encoded (m6)
      @storage.push encoded (m7)
      @storage.push encoded (m8)
      @storage.push encoded (m9)
      @storage.push encoded (m10)
      @storage.push encoded (m11)
      @storage.push encoded (m12)
      @storage.push encoded (m13)
      @storage.push encoded (m14)
      @storage.push encoded (m15)
      @storage.push encoded (present)
      @storage.push encoded (p0)
      @storage.push encoded (p1)
      @storage.push encoded (p2)
      @storage.push encoded (p3)
      @storage.push encoded (U32.to_f32 (project.extra_count context source))
  encoded[start + 10] := U32.to_f32 ((encoded.length - inset_draws_start) / 24)
  let preferences_start = encoded.length
  for i in 0 .. preferences_count:
    let source = collections.preferences[i]
    @storage.push encoded source
  encoded[start + 11] := U32.to_f32 ((encoded.length - preferences_start))
  let fields_start = encoded.length
  for i in 0 .. fields_count:
    let source = collections.fields[i]
    let field = project.field context source
    @storage.push encoded (U32.to_f32 (field.material))
    @storage.push encoded (U32.to_f32 (field.width))
    @storage.push encoded (U32.to_f32 (field.height))
    @storage.push encoded (U32.to_f32 (field.x))
    @storage.push encoded (U32.to_f32 (field.z))
    @storage.push encoded (U32.to_f32 (field.columns))
    @storage.push encoded (U32.to_f32 (field.rows))
    let count: U32 = field.values.length
    for i in 0 .. count:
      let item = field.values.at i
      @storage.push encoded item
  encoded[start + 131] := U32.to_f32 ((encoded.length - fields_start))
  let ui_start = encoded.length
  for i in 0 .. ui_count:
    let source = collections.ui[i]
    let ui = project.ui context source
    @storage.push encoded (U32.to_f32 (ui.id))
    @storage.push encoded (U32.to_f32 (ui.parent))
    @storage.push encoded (U32.to_f32 (ui.role))
    @storage.push encoded (ui.x)
    @storage.push encoded (ui.y)
    @storage.push encoded (ui.width)
    @storage.push encoded (ui.height)
    @storage.push encoded (lanes.bit ui.focusable)
    @storage.push encoded (lanes.bit ui.focused)
    @storage.push encoded (lanes.bit ui.disabled)
    @storage.push encoded (lanes.bit ui.hidden)
    @storage.push encoded (lanes.bit ui.modal)
    @storage.push encoded (U32.to_f32 (ui.checked))
    @storage.push encoded (U32.to_f32 (ui.expanded))
    @storage.push encoded (U32.to_f32 (ui.selected))
    @storage.push encoded (U32.to_f32 (ui.live))
    @storage.push encoded (ui.value)
    @storage.push encoded (ui.minimum)
    @storage.push encoded (ui.maximum)
    @storage.push encoded (ui.step)
    @storage.push encoded (U32.to_f32 (ui.actions))
    @storage.push encoded (U32.to_f32 (ui.text_length))
    @storage.push encoded (U32.to_f32 (ui.name_length))
    @storage.push encoded (U32.to_f32 (ui.description_length))
    let count: U32 = ui.text.length
    for i in 0 .. count:
      let item = ui.text.at i
      @storage.push encoded item
  encoded[start + 133] := U32.to_f32 ((encoded.length - ui_start))
  let services_start = encoded.length
  for i in 0 .. services_count:
    let source = collections.services[i]
    let service = project.service context source
    @storage.push encoded (U32.to_f32 (service.request))
    @storage.push encoded (U32.to_f32 (service.service))
    @storage.push encoded (U32.to_f32 (service.operation))
    @storage.push encoded (service.a)
    @storage.push encoded (service.b)
    @storage.push encoded (service.c)
    @storage.push encoded (service.d)
    @storage.push encoded (U32.to_f32 (service.value_count))
    let count: U32 = service.values.length
    for i in 0 .. count:
      let item = service.values.at i
      @storage.push encoded item
  encoded[start + 135] := U32.to_f32 ((encoded.length - services_start))
  for i in 0 .. buses_count:
    let source = collections.buses[i]
    let buse: types.Bus = project.buse context source
    @storage.push encoded (buse.gain)
    @storage.push encoded (buse.lowpass)
    @storage.push encoded (buse.reverb)
  for i in 0 .. voices_count:
    let source = collections.voices[i]
    let voice: types.Voice = project.voice context source
    @storage.push encoded (U32.to_f32 (voice.id))
    @storage.push encoded (U32.to_f32 (voice.clip))
    @storage.push encoded (U32.to_f32 (voice.bus))
    @storage.push encoded (voice.gain)
    @storage.push encoded (voice.pan)
    @storage.push encoded (voice.pitch)
    @storage.push encoded (voice.lowpass)
    @storage.push encoded (voice.reverb)
    @storage.push encoded (lanes.bit voice.looping)
    @storage.push encoded (voice.start)
    @storage.push encoded (voice.fade_in)
    @storage.push encoded (voice.fade_out)
  for i in 0 .. poses_count:
    let source = collections.poses[i]
    let pose: types.Pose = project.pose context source
    @storage.push encoded (U32.to_f32 (pose.draw))
    @storage.push encoded (U32.to_f32 (pose.clip))
    @storage.push encoded (pose.time)
    @storage.push encoded (pose.weight)
  for i in 0 .. emitters_count:
    let source = collections.emitters[i]
    let emitter: types.Emitter = project.emitter context source
    @storage.push encoded (U32.to_f32 (emitter.material))
    let $types.Mat4 { x: transform_x, y: transform_y, z: transform_z, w: transform_w } = emitter.transform
    @storage.push encoded (transform_x.x)
    @storage.push encoded (transform_x.y)
    @storage.push encoded (transform_x.z)
    @storage.push encoded (transform_x.w)
    @storage.push encoded (transform_y.x)
    @storage.push encoded (transform_y.y)
    @storage.push encoded (transform_y.z)
    @storage.push encoded (transform_y.w)
    @storage.push encoded (transform_z.x)
    @storage.push encoded (transform_z.y)
    @storage.push encoded (transform_z.z)
    @storage.push encoded (transform_z.w)
    @storage.push encoded (transform_w.x)
    @storage.push encoded (transform_w.y)
    @storage.push encoded (transform_w.z)
    @storage.push encoded (transform_w.w)
    @storage.push encoded (U32.to_f32 (emitter.seed))
    @storage.push encoded (emitter.time)
    @storage.push encoded (emitter.duration)
    @storage.push encoded (emitter.rate)
    @storage.push encoded (emitter.lifetime)
    @storage.push encoded (emitter.radius)
    @storage.push encoded (emitter.velocity.x)
    @storage.push encoded (emitter.velocity.y)
    @storage.push encoded (emitter.velocity.z)
    @storage.push encoded (emitter.spread)
    @storage.push encoded (emitter.gravity.x)
    @storage.push encoded (emitter.gravity.y)
    @storage.push encoded (emitter.gravity.z)
    @storage.push encoded (emitter.drag)
    @storage.push encoded (emitter.size_start)
    @storage.push encoded (emitter.size_end)
    @storage.push encoded (emitter.color_start.r)
    @storage.push encoded (emitter.color_start.g)
    @storage.push encoded (emitter.color_start.b)
    @storage.push encoded (emitter.color_start.a)
    @storage.push encoded (emitter.color_end.r)
    @storage.push encoded (emitter.color_end.g)
    @storage.push encoded (emitter.color_end.b)
    @storage.push encoded (emitter.color_end.a)
    @storage.push encoded (lanes.bit emitter.additive)
  for i in 0 .. lights_count:
    let source = collections.lights[i]
    let light: types.Light = project.light context source
    @storage.push encoded (light.position.x)
    @storage.push encoded (light.position.y)
    @storage.push encoded (light.position.z)
    @storage.push encoded (light.radius)
    @storage.push encoded (light.color.x)
    @storage.push encoded (light.color.y)
    @storage.push encoded (light.color.z)
    @storage.push encoded (light.direction.x)
    @storage.push encoded (light.direction.y)
    @storage.push encoded (light.direction.z)
    @storage.push encoded (light.inner)
    @storage.push encoded (light.outer)
  for i in 0 .. listener_count:
    let source = collections.listener[i]
    let listener: types.Listener = project.listener context source
    @storage.push encoded (listener.position.x)
    @storage.push encoded (listener.position.y)
    @storage.push encoded (listener.position.z)
    @storage.push encoded (listener.forward.x)
    @storage.push encoded (listener.forward.y)
    @storage.push encoded (listener.forward.z)
    @storage.push encoded (listener.up.x)
    @storage.push encoded (listener.up.y)
    @storage.push encoded (listener.up.z)
  for i in 0 .. panners_count:
    let source = collections.panners[i]
    let panner: types.Panner = project.panner context source
    @storage.push encoded (U32.to_f32 (panner.voice))
    @storage.push encoded (U32.to_f32 (panner.sound))
    @storage.push encoded (panner.position.x)
    @storage.push encoded (panner.position.y)
    @storage.push encoded (panner.position.z)
    @storage.push encoded (panner.orientation.x)
    @storage.push encoded (panner.orientation.y)
    @storage.push encoded (panner.orientation.z)
    @storage.push encoded (U32.to_f32 (panner.distance_model))
    @storage.push encoded (panner.ref_distance)
    @storage.push encoded (panner.max_distance)
    @storage.push encoded (panner.rolloff)
    @storage.push encoded (panner.cone_inner)
    @storage.push encoded (panner.cone_outer)
    @storage.push encoded (panner.cone_outer_gain)
  for i in 0 .. instances_count:
    let source = collections.instances[i]
    let (id_low, id_high, order, mesh, material) = project.instance_metadata context source
    let (m0, m1, m2, m3, m4, m5, m6, m7, m8, m9, m10, m11, m12, m13, m14, m15) = project.instance_transform context source
    let (present, p0, p1, p2, p3) = project.instance_parameters context source
    @storage.push encoded (U32.to_f32 id_low)
    @storage.push encoded (U32.to_f32 id_high)
    @storage.push encoded (U32.to_f32 order)
    @storage.push encoded (U32.to_f32 mesh)
    @storage.push encoded (U32.to_f32 material)
    @storage.push encoded (m0)
    @storage.push encoded (m1)
    @storage.push encoded (m2)
    @storage.push encoded (m3)
    @storage.push encoded (m4)
    @storage.push encoded (m5)
    @storage.push encoded (m6)
    @storage.push encoded (m7)
    @storage.push encoded (m8)
    @storage.push encoded (m9)
    @storage.push encoded (m10)
    @storage.push encoded (m11)
    @storage.push encoded (m12)
    @storage.push encoded (m13)
    @storage.push encoded (m14)
    @storage.push encoded (m15)
    @storage.push encoded (present)
    @storage.push encoded (p0)
    @storage.push encoded (p1)
    @storage.push encoded (p2)
    @storage.push encoded (p3)
  for i in 0 .. instance_removals_count:
    let source = collections.instance_removals[i]
    let instance_removal: types.InstanceRemoval = project.instance_removal context source
    @storage.push encoded (U32.to_f32 (instance_removal.id_low))
    @storage.push encoded (U32.to_f32 (instance_removal.id_high))
  for i in 0 .. draws_count:
    let source = collections.draws[i]
    project.append_extra context source encoded
  for parent in 0 .. insets_count:
    let children = project.inset_draws context collections.insets[parent]
    let count: U32 = children.length
    for i in 0 .. count:
      let source = children.at i
      project.append_extra context source encoded
  return encoded

func measure_render_floats collections -> project -> context =>
  let total: U32 = protocol.packet_header_floats
  let state_count: U32 = collections.state.length
  let draws_count: U32 = collections.draws.length
  let solids_count: U32 = collections.solids.length
  let decals_count: U32 = collections.decals.length
  let sounds_count: U32 = collections.sounds.length
  let sprites_count: U32 = collections.sprites.length
  let insets_count: U32 = collections.insets.length
  let preferences_count: U32 = collections.preferences.length
  let fields_count: U32 = collections.fields.length
  let ui_count: U32 = collections.ui.length
  let services_count: U32 = collections.services.length
  let buses_count: U32 = collections.buses.length
  let voices_count: U32 = collections.voices.length
  let poses_count: U32 = collections.poses.length
  let emitters_count: U32 = collections.emitters.length
  let lights_count: U32 = collections.lights.length
  let listener_count: U32 = collections.listener.length
  let panners_count: U32 = collections.panners.length
  let instances_count: U32 = collections.instances.length
  let instance_removals_count: U32 = collections.instance_removals.length
  total := self + state_count
  total := self + draws_count * 24
  for i in 0 .. solids_count:
    let source = collections.solids[i]
    let solid = project.solid context source
    let count: U32 = solid.faces.length
    total := self + 1 + count * 5
  total := self + decals_count * 18
  total := self + sounds_count * 7
  total := self + sprites_count * 17
  total := self + insets_count * 48
  for parent in 0 .. insets_count:
    let children = project.inset_draws context collections.insets[parent]
    total := self + children.length * 24
  total := self + preferences_count
  for i in 0 .. fields_count:
    let source = collections.fields[i]
    let field = project.field context source
    let count: U32 = field.values.length
    total := self + 7 + count
  for i in 0 .. ui_count:
    let source = collections.ui[i]
    let ui = project.ui context source
    let count: U32 = ui.text.length
    total := self + 24 + count
  for i in 0 .. services_count:
    let source = collections.services[i]
    let service = project.service context source
    let count: U32 = service.values.length
    total := self + 8 + count
  total := self + buses_count * 3
  total := self + voices_count * 12
  total := self + poses_count * 4
  total := self + emitters_count * 42
  total := self + lights_count * 12
  total := self + listener_count * 9
  total := self + panners_count * 15
  total := self + instances_count * 26
  total := self + instance_removals_count * 2
  for i in 0 .. draws_count:
    let source = collections.draws[i]
    total := self + (project.extra_count context source) * 4
  for parent in 0 .. insets_count:
    let children = project.inset_draws context collections.insets[parent]
    let count: U32 = children.length
    for i in 0 .. count:
      let source = children.at i
      total := self + (project.extra_count context source) * 4
  return total

// Flat mesh draws (no parameters/extras) and sounds, into the packet it is given and returns.
type MeshDraw = { mesh: U32, material: U32, transform: types.Mat4 }
func encode_mesh_frame (packet: types.RenderHeader) -> (draws: &[MeshDraw]) -> (sounds: &[types.Sound]) -> (encoded: own #[~F32]) =>
  @storage.truncate encoded 0
  for 0 .. (protocol.packet_header_floats + draws.length * 24 + sounds.length * 7):
    @storage.push encoded 0.0
  encoded[0] := protocol.packet_magic
  encoded[1] := U32.to_f32 packet.schema
  encoded[2] := 0.0
  encoded[3] := U32.to_f32 draws.length
  encoded[4] := 0.0
  encoded[5] := 0.0
  encoded[6] := 0.0
  encoded[7] := U32.to_f32 sounds.length
  encoded[8] := 0.0
  encoded[9] := 0.0
  encoded[10] := 0.0
  encoded[11] := 0.0
  encoded[12] := lanes.bit packet.save_requested
  encoded[13] := lanes.bit packet.load_requested
  encoded[14] := lanes.bit packet.scene_save_requested
  encoded[15] := lanes.bit packet.scene_load_requested
  encoded[16] := lanes.bit packet.checkpoint_requested
  encoded[17] := lanes.bit packet.undo_requested
  encoded[18] := lanes.bit packet.redo_requested
  encoded[19] := lanes.bit packet.exit_requested
  let $types.Mat4 { x: view_x, y: view_y, z: view_z, w: view_w } = packet.view
  encoded[20] := view_x.x
  encoded[21] := view_x.y
  encoded[22] := view_x.z
  encoded[23] := view_x.w
  encoded[24] := view_y.x
  encoded[25] := view_y.y
  encoded[26] := view_y.z
  encoded[27] := view_y.w
  encoded[28] := view_z.x
  encoded[29] := view_z.y
  encoded[30] := view_z.z
  encoded[31] := view_z.w
  encoded[32] := view_w.x
  encoded[33] := view_w.y
  encoded[34] := view_w.z
  encoded[35] := view_w.w
  let $types.Mat4 { x: projection_x, y: projection_y, z: projection_z, w: projection_w } = packet.projection
  encoded[36] := projection_x.x
  encoded[37] := projection_x.y
  encoded[38] := projection_x.z
  encoded[39] := projection_x.w
  encoded[40] := projection_y.x
  encoded[41] := projection_y.y
  encoded[42] := projection_y.z
  encoded[43] := projection_y.w
  encoded[44] := projection_z.x
  encoded[45] := projection_z.y
  encoded[46] := projection_z.z
  encoded[47] := projection_z.w
  encoded[48] := projection_w.x
  encoded[49] := projection_w.y
  encoded[50] := projection_w.z
  encoded[51] := projection_w.w
  encoded[52] := packet.clear.r
  encoded[53] := packet.clear.g
  encoded[54] := packet.clear.b
  encoded[55] := packet.clear.a
  encoded[56] := packet.ambient.x
  encoded[57] := packet.ambient.y
  encoded[58] := packet.ambient.z
  encoded[59] := packet.light_direction.x
  encoded[60] := packet.light_direction.y
  encoded[61] := packet.light_direction.z
  encoded[62] := packet.light_color.x
  encoded[63] := packet.light_color.y
  encoded[64] := packet.light_color.z
  encoded[65] := packet.aberration.x
  encoded[66] := packet.aberration.y
  encoded[67] := U32.to_f32 (packet.quality.msaa)
  encoded[68] := lanes.bit packet.quality.fxaa
  encoded[69] := packet.quality.scale
  encoded[70] := U32.to_f32 (packet.quality.filtering)
  encoded[71] := lanes.bit packet.quality.occlusion
  encoded[72] := lanes.bit packet.quality.sky
  encoded[73] := lanes.bit packet.quality.effects
  encoded[74] := packet.sky.zenith.x
  encoded[75] := packet.sky.zenith.y
  encoded[76] := packet.sky.zenith.z
  encoded[77] := packet.sky.horizon.x
  encoded[78] := packet.sky.horizon.y
  encoded[79] := packet.sky.horizon.z
  encoded[80] := packet.sky.ground.x
  encoded[81] := packet.sky.ground.y
  encoded[82] := packet.sky.ground.z
  encoded[83] := packet.sky.sun.x
  encoded[84] := packet.sky.sun.y
  encoded[85] := packet.sky.sun.z
  encoded[86] := packet.sky.night
  encoded[87] := packet.fog.radius
  encoded[88] := packet.fog.density
  encoded[89] := packet.fog.height
  let $types.Mat4 { x: shadow_view_x, y: shadow_view_y, z: shadow_view_z, w: shadow_view_w } = packet.shadow.view
  encoded[90] := shadow_view_x.x
  encoded[91] := shadow_view_x.y
  encoded[92] := shadow_view_x.z
  encoded[93] := shadow_view_x.w
  encoded[94] := shadow_view_y.x
  encoded[95] := shadow_view_y.y
  encoded[96] := shadow_view_y.z
  encoded[97] := shadow_view_y.w
  encoded[98] := shadow_view_z.x
  encoded[99] := shadow_view_z.y
  encoded[100] := shadow_view_z.z
  encoded[101] := shadow_view_z.w
  encoded[102] := shadow_view_w.x
  encoded[103] := shadow_view_w.y
  encoded[104] := shadow_view_w.z
  encoded[105] := shadow_view_w.w
  let $types.Mat4 { x: shadow_projection_x, y: shadow_projection_y, z: shadow_projection_z, w: shadow_projection_w } = packet.shadow.projection
  encoded[106] := shadow_projection_x.x
  encoded[107] := shadow_projection_x.y
  encoded[108] := shadow_projection_x.z
  encoded[109] := shadow_projection_x.w
  encoded[110] := shadow_projection_y.x
  encoded[111] := shadow_projection_y.y
  encoded[112] := shadow_projection_y.z
  encoded[113] := shadow_projection_y.w
  encoded[114] := shadow_projection_z.x
  encoded[115] := shadow_projection_z.y
  encoded[116] := shadow_projection_z.z
  encoded[117] := shadow_projection_z.w
  encoded[118] := shadow_projection_w.x
  encoded[119] := shadow_projection_w.y
  encoded[120] := shadow_projection_w.z
  encoded[121] := shadow_projection_w.w
  encoded[122] := packet.shadow.texel
  encoded[123] := U32.to_f32 (packet.shadow.texels)
  encoded[124] := packet.blur
  encoded[125] := lanes.bit packet.quality.bloom
  encoded[126] := packet.clouds.cover
  encoded[127] := packet.clouds.drift.x
  encoded[128] := packet.clouds.drift.z
  encoded[129] := lanes.bit packet.hide_cursor
  encoded[130] := 0.0
  encoded[131] := 0.0
  encoded[132] := 0.0
  encoded[133] := 0.0
  encoded[134] := 0.0
  encoded[135] := 0.0
  encoded[136] := 0.0
  encoded[137] := 0.0
  encoded[138] := 0.0
  encoded[139] := 0.0
  encoded[140] := lanes.bit packet.quality.taa
  encoded[141] := 0.0
  encoded[142] := 0.0
  encoded[143] := 0.0
  encoded[144] := lanes.bit packet.loading
  encoded[145] := lanes.bit packet.show_captions
  encoded[146] := lanes.bit packet.retained_enabled
  encoded[147] := lanes.bit packet.retained_reset
  encoded[148] := U32.to_f32 (packet.retained_after)
  encoded[149] := 0.0
  encoded[150] := 0.0
  let at: U32 = protocol.packet_header_floats
  for draw in draws:
    encoded[at + 0] := U32.to_f32 (draw.mesh)
    encoded[at + 1] := U32.to_f32 (draw.material)
    let $types.Mat4 { x: transform_x, y: transform_y, z: transform_z, w: transform_w } = draw.transform
    encoded[at + 2] := transform_x.x
    encoded[at + 3] := transform_x.y
    encoded[at + 4] := transform_x.z
    encoded[at + 5] := transform_x.w
    encoded[at + 6] := transform_y.x
    encoded[at + 7] := transform_y.y
    encoded[at + 8] := transform_y.z
    encoded[at + 9] := transform_y.w
    encoded[at + 10] := transform_z.x
    encoded[at + 11] := transform_z.y
    encoded[at + 12] := transform_z.z
    encoded[at + 13] := transform_z.w
    encoded[at + 14] := transform_w.x
    encoded[at + 15] := transform_w.y
    encoded[at + 16] := transform_w.z
    encoded[at + 17] := transform_w.w
    at := self + 24
  for sound in sounds:
    encoded[at + 0] := U32.to_f32 (sound.clip)
    encoded[at + 1] := U32.to_f32 (sound.bus)
    encoded[at + 2] := sound.gain
    encoded[at + 3] := sound.pan
    encoded[at + 4] := sound.pitch
    encoded[at + 5] := sound.lowpass
    encoded[at + 6] := sound.reverb
    at := self + 7
  return encoded
