// The events the host sends, as their lanes hold them.
type Event is data =
  | $KeyDown U32
  | $KeyUp U32
  | $PointerDown { button: U32, x: F32, y: F32 }
  | $PointerUp { button: U32, x: F32, y: F32 }
  | $PointerMove { x: F32, y: F32 }
  | $Wheel { x: F32, y: F32, delta: F32 }
  | $FocusLost
  | $AssetChanged
  | $Console { command: U32, argument: U32 }
  | $Preference { index: U32, value: F32 }
  | $Tune { index: U32, value: F32 }
  | $UiAction { node: U32, action: U32, value: F32 }
  | $ServiceAnswer { request: U32, status: U32, value: F32, length: U32 }
  | $ServiceData { request: U32, a: F32, b: F32, c: F32 }
  | $GamepadConnected { pad: U32, standard: U32 }
  | $GamepadDisconnected { pad: U32 }
  | $GamepadButton { button: U32, pad: U32, value: F32, pressed: U32 }
  | $GamepadAxis { axis: U32, pad: U32, value: F32 }
  | $Action { action: U32, value: F32, device: U32 }
  | $TextInput { character: U32, composing: U32 }
  | $Composition { length: U32, cursor: U32 }
  | $MouseMotion { dx: F32, dy: F32 }
  | $Touch { id: U32, x: F32, y: F32, phase: U32 }
  | $Pan { touches: U32, dx: F32, dy: F32 }
  | $Pinch { x: F32, y: F32, scale: F32 }
  | $Player { index: U32 }
  | $SessionStarted { restored: U32 }
  | $RendererReady

type Input is data = $Input { elapsed: F32, width: F32, height: F32, events: &[Event], state: &[F32] }

// An event's lanes from `start`: its tag, then code, x, y, delta. The code lane
// holds a whole number; lanes an event does not use are zero.
const decode_event = func values => return func (start: U32) => return do:
  let tag = lanes.integer (values.at (start)) 28
  let code = lanes.integer (values.at (start + 1)) lanes.max_integer
  let x = (values.at (start + 2))
  let y = (values.at (start + 3))
  let delta = (values.at (start + 4))
  return case tag of
    1 => do:
      use lanes.require (x == 0.0)
      use lanes.require (y == 0.0)
      use lanes.require (delta == 0.0)
      return $KeyDown code
    2 => do:
      use lanes.require (x == 0.0)
      use lanes.require (y == 0.0)
      use lanes.require (delta == 0.0)
      return $KeyUp code
    3 => do:
      use lanes.require (code <= 7)
      use lanes.require (delta == 0.0)
      return $PointerDown { button: code, x, y }
    4 => do:
      use lanes.require (code <= 7)
      use lanes.require (delta == 0.0)
      return $PointerUp { button: code, x, y }
    5 => do:
      use lanes.require (code == 0)
      use lanes.require (delta == 0.0)
      return $PointerMove { x, y }
    6 => do:
      use lanes.require (code == 0)
      return $Wheel { x, y, delta }
    7 => do:
      use lanes.require (code == 0)
      use lanes.require (x == 0.0)
      use lanes.require (y == 0.0)
      use lanes.require (delta == 0.0)
      return $FocusLost
    8 => do:
      use lanes.require (code == 0)
      use lanes.require (x == 0.0)
      use lanes.require (y == 0.0)
      use lanes.require (delta == 0.0)
      return $AssetChanged
    9 => do:
      use lanes.require (y == 0.0)
      use lanes.require (delta == 0.0)
      return $Console { command: code, argument: lanes.integer x lanes.max_integer }
    10 => do:
      use lanes.require (y == 0.0)
      use lanes.require (delta == 0.0)
      return $Preference { index: code, value: x }
    11 => do:
      use lanes.require (y == 0.0)
      use lanes.require (delta == 0.0)
      return $Tune { index: code, value: x }
    12 => do:
      use lanes.require (code <= 7)
      use lanes.require (delta == 0.0)
      return $UiAction { node: lanes.integer x lanes.max_integer, action: code, value: y }
    13 => do:
      use lanes.require (code <= 3)
      return $ServiceAnswer { request: lanes.integer x lanes.max_integer, status: code, value: y, length: lanes.integer delta lanes.max_integer }
    14 => do:
      return $ServiceData { request: code, a: x, b: y, c: delta }
    15 => do:
      use lanes.require (code <= 15)
      use lanes.require (y == 0.0)
      use lanes.require (delta == 0.0)
      return $GamepadConnected { pad: code, standard: lanes.integer x lanes.max_integer }
    16 => do:
      use lanes.require (code <= 15)
      use lanes.require (x == 0.0)
      use lanes.require (y == 0.0)
      use lanes.require (delta == 0.0)
      return $GamepadDisconnected { pad: code }
    17 => do:
      use lanes.require (code <= 31)
      return $GamepadButton { button: code, pad: lanes.integer x lanes.max_integer, value: y, pressed: lanes.integer delta lanes.max_integer }
    18 => do:
      use lanes.require (code <= 15)
      use lanes.require (delta == 0.0)
      return $GamepadAxis { axis: code, pad: lanes.integer x lanes.max_integer, value: y }
    19 => do:
      use lanes.require (code <= 255)
      use lanes.require (delta == 0.0)
      return $Action { action: code, value: x, device: lanes.integer y lanes.max_integer }
    20 => do:
      use lanes.require (code <= 1114111)
      use lanes.require (y == 0.0)
      use lanes.require (delta == 0.0)
      return $TextInput { character: code, composing: lanes.integer x lanes.max_integer }
    21 => do:
      use lanes.require (y == 0.0)
      use lanes.require (delta == 0.0)
      return $Composition { length: code, cursor: lanes.integer x lanes.max_integer }
    22 => do:
      use lanes.require (code == 0)
      use lanes.require (delta == 0.0)
      return $MouseMotion { dx: x, dy: y }
    23 => do:
      use lanes.require (code <= 31)
      return $Touch { id: code, x, y, phase: lanes.integer delta lanes.max_integer }
    24 => do:
      use lanes.require (code <= 31)
      use lanes.require (delta == 0.0)
      return $Pan { touches: code, dx: x, dy: y }
    25 => do:
      use lanes.require (code == 0)
      return $Pinch { x, y, scale: delta }
    26 => do:
      use lanes.require (code <= 255)
      use lanes.require (x == 0.0)
      use lanes.require (y == 0.0)
      use lanes.require (delta == 0.0)
      return $Player { index: code }
    27 => do:
      use lanes.require (code <= 1)
      use lanes.require (x == 0.0)
      use lanes.require (y == 0.0)
      use lanes.require (delta == 0.0)
      return $SessionStarted { restored: code }
    28 => do:
      use lanes.require (code == 0)
      use lanes.require (x == 0.0)
      use lanes.require (y == 0.0)
      use lanes.require (delta == 0.0)
      return $RendererReady
    _ => @panic "invalid input event tag"

// The input packet: the seconds since the last frame, the viewport's width and
// height, the event and state counts, the events and the state. Anything else
// traps.
const decode_input_into = func values -> (events: ResizeArray Event) => return do:
  use lanes.require (values.length >= frame_header_floats)
  use lanes.finite values
  let elapsed = (values.at (0))
  use lanes.require (elapsed >= 0.0)
  let width = (values.at (1))
  let height = (values.at (2))
  use lanes.require (width > 0.0)
  use lanes.require (height > 0.0)
  let event_count = lanes.integer (values.at (3)) max_events
  let state_count = lanes.integer (values.at (4)) max_state_floats
  let state_start = frame_header_floats + event_count * event_floats
  use lanes.require (values.length == state_start + state_count)
  @storage.truncate events 0
  for index in 0 .. event_count:
    @storage.push events (decode_event values (frame_header_floats + index * event_floats))
  return $Input {
    state: values.view state_start (state_start + state_count),
    elapsed, width, height,
    events: &events[0..events.length],
  }
