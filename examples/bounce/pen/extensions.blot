// Generated by pen codegen from this checkout's pen.json `protocol`:
// declare the game's events and sections there and run `pen codegen`, not this file.
//
// The game's own events and render sections, which its pen.json declares
// under `protocol`, beside pen's. Its owner-aware host serves these packets.
import * as array from "std/array"
import * as lanes from "./lanes"
import * as protocol from "./protocol"
import * as types from "./types"

// Each event's and section's tag.
const kick_tag = 1
const score_tag = 1

// The events the host sends: pen's, and the game's own.
// Kick: Pushes the ball: adds to its velocity along x and z, in units a second.
type Event is data =
  | $Pen protocol.Event
  | $Kick { x: F32, z: F32 }

type Input is data = $Input { elapsed: F32, width: F32, height: F32, events: &[Event], state: &[F32] }

// An event's lanes from `start`: one of pen's, or one of the game's, which
// travels as pen's Game event: its tag, then its values in the lanes after,
// those it has no field for zero.
const decode_event = func values => return func (start: U32) => return do:
  if (values.at (start)) != U32.to_f32 protocol.game_tag:
    return $Pen (protocol.decode_event values start)
  let tag = lanes.integer (values.at (start + 1)) protocol.max_extension_tag
  let lanes_after = #[(values.at (start + 2)), (values.at (start + 3)), (values.at (start + 4))]
  return case tag of
    1 => do:
      use lanes.require (lanes_after[2] == 0.0)
      return $Kick { x: lanes_after[0], z: lanes_after[1] }
    _ => @panic "unknown game event"

// The input packet, as protocol.decode_input_into reads it, with the game's own
// events.
const decode_input_into = func values -> (events: ResizeArray Event) => return do:
  use lanes.require (values.length >= protocol.frame_header_floats)
  use lanes.finite values
  let elapsed = (values.at (0))
  use lanes.require (elapsed >= 0.0)
  let width = (values.at (1))
  let height = (values.at (2))
  use lanes.require (width > 0.0)
  use lanes.require (height > 0.0)
  let event_count = lanes.integer (values.at (3)) protocol.max_events
  let state_count = lanes.integer (values.at (4)) protocol.max_state_floats
  let state_start = protocol.frame_header_floats + event_count * protocol.event_floats
  use lanes.require (values.length == state_start + state_count)
  @storage.truncate events 0
  for index in 0 .. event_count:
    @storage.push events (decode_event values (protocol.frame_header_floats + index * protocol.event_floats))
  return $Input {
    state: values.view state_start (state_start + state_count),
    elapsed, width, height,
    events: &events[0..events.length],
  }

// Score: How the ball is doing, every frame: how often it has hit a wall, and
// how fast it goes.
type Score is data = $Score { bounces: U32, speed: F32 }
const score_floats = 2
// Append the tag, length and these Scores to a caller-owned extension packet.
const append_score = func (records: Array Score) -> (packet: ResizeArray F32) => return do:
  @storage.push packet (U32.to_f32 score_tag)
  @storage.push packet (U32.to_f32 (records.length * score_floats))
  for record in records:
    @storage.push packet (U32.to_f32 record.bounces)
    @storage.push packet (record.speed)
  return ()
