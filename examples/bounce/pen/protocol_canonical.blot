  at := stream.at
  stream.output[7] := U32.to_f32 sounds_count
  let sprites_start: U32 = stream.output.length
  let sprites_count = lanes.integer canonical[at] lanes.max_integer
  at := at + 1
  stream.at := at
  for 0 .. sprites_count:
