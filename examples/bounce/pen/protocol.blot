// Operation codes run from 0 to this; each service numbers its own.
const max_service_operation = 255
// The most voices one frame may declare.
const max_voices = 256
// The most buses one frame may declare, the master (bus 0) included.
const max_buses = 16
// Voice ids are whole numbers from 1 to this, the wire's exact-integer range.
const max_voice_id = 16777215
// The time constant, in milliseconds, of the glide that takes a voice's or bus's
// gain, pan, pitch, lowpass and reverb toward a frame's new value (WebAudio's
// setTargetAtTime), so that values set every frame do not click.
const audio_glide_ms = 20
// The shortest fade, in milliseconds, of a voice that leaves or changes clip.
const audio_fade_ms = 30
// A lowpass cutoff, in Hz, at or above which a filter is open; hosts also leave
