// The ball's rules, which `pen test-blot` checks. A test module compiles as
// if it were src/test_fixture.blot, so `./game` is src/game.blot.
import * as check from "pen/check"
import * as extensions from "pen/extensions"
import * as protocol from "pen/protocol"
import { game, score } from "./game"

const empty_state: Array F32 = #[]

// A tenth of a second of a 640 x 480 frame, with `events`.
const input = func (events: Array extensions.Event) => return
  $extensions.Input { elapsed: 0.1, width: 640.0, height: 480.0, events: &events[0..events.length], state: &empty_state[0..0] }

const key = func (code: U32) => return $extensions.Pen ($protocol.KeyDown code)

// The world after one frame of `events` from `state`.
const after = func (state: Array F32) => return func (events: Array extensions.Event) => return do:
  let (world, _) = game.step (game.restore state) (input events)
  return game.save world

entry const test_a_kick_sets_it_rolling = func () => return check.report #[
  // x, z, vx, vz, bounces, held: 3 a second, less 3% drag, for a tenth.
  check.near 0.0001 #[0.291, 0.0, 2.91, 0.0, 0.0, 0.0] (after (game.save (game.create ())) #[$extensions.Kick { x: 3.0, z: 0.0 }]),
]

entry const test_it_bounces_off_a_wall = func () => return check.report #[
  // From 3.4 at 2 a second it reaches past the wall at 3.5 and comes back.
  check.near 0.0001 #[3.406, 0.0, -1.94, 0.0, 1.0, 0.0] (after #[3.4, 0.0, 2.0, 0.0, 0.0, 0.0] #[]),
]

entry const test_a_held_arrow_pushes_it = func () => return do:
  let held = after (game.save (game.create ())) #[key protocol.key_arrow_up]
  let let_go = after held #[$extensions.Pen ($protocol.KeyUp protocol.key_arrow_up)]
  return check.report #[
    // Up pushes toward -z: 6 a second, each second, for a tenth.
    check.near 0.0001 #[0.0, -0.0582, 0.0, -0.582, 0.0, 4.0] held,
    check.near 0.0001 #[0.0, 0.0] #[let_go[5], let_go[2]],
  ]

entry const test_its_score_says_how_it_is_doing = func () => return do:
  let (world, _) = game.step (game.restore #[3.4, 0.0, 2.0, 0.0, 4.0, 0.0]) (input #[])
  let section = score world
  return check.report #[
    check.equal #[1.0] #[section[1]],
    check.equal #[U32.to_f32 extensions.score_tag] #[section[2]],
    check.near 0.0001 #[5.0, 1.94] #[section[4], section[5]],
  ]

entry const test_a_saved_world_comes_back = func () => return do:
  let saved = after (game.save (game.create ())) #[key protocol.key_arrow_left, $extensions.Kick { x: 1.0, z: -2.0 }]
  return check.report #[check.equal saved (game.save (game.restore saved))]
