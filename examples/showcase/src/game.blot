// Ink + Pen High-Fidelity Vertical-Slice Showcase & Interactive Scene Editor.
//
// Demonstrates the full Ink + Pen stack in one runnable project:
// - `ink/scene_graph` hierarchical transforms (monolith + floating crystal child)
// - `ink/editor/scene` ray picking, 3D RGB gizmo translate/rotate/scale drags,
//   bounded undo/redo history, and Play-in-Editor snapshot/restore (`P`)
// - `ink/sequencer` Hermite/linear animation during Play-in-Editor
// - `ink/pcg/noise`, `ink/render/foliage`, `ink/render/water` `spark` SIMD kernels
// - `ink/kernel_kits` + `ink/kernel_transport` multi-core `entry kernel` offload
// - Pen high-fidelity GPU pipeline: visual `.matgraph.json` crystal shader,
//   physical sky + volumetric clouds (`1`), 2-tier ray tracing (`2`), DDGI probe
//   volume (`3`), WBOIT stained glass (`4`), TAAU temporal upscale (`5`), AgX
//   tonemapping, LTC rectangular area light + stained-glass cookie projector,
//   deferred PBR floor decal, courtyard reverb zone, and ambient DSP synth pad.
import * as array from "std/array"
import * as kernel from "std/kernel"
import { Vec2, Vec3 } from "std/vector"
import * as camera from "ink/camera"
import * as color from "ink/color"
import * as editor from "ink/editor/scene"
import * as events from "ink/events"
import * as foliage from "ink/render/foliage"
import * as gizmos from "ink/gizmos"
import * as host from "ink/pen/host"
import * as kernel_kits from "ink/kernel_kits"
import * as kernel_transport from "ink/kernel_transport"
import * as keys from "ink/input/keys"
import * as math from "ink/math"
import * as pcg_noise from "ink/pcg/noise"
import * as persist from "ink/persist"
import * as preferences from "ink/preferences"
import * as render from "ink/render"
import * as scene_graph from "ink/scene_graph"
import * as sequencer from "ink/sequencer"
import * as services from "ink/services"
import * as sound from "ink/sound"
import * as transform from "ink/transform"
import * as tree from "ink/ui/tree"
import * as water from "ink/render/water"
import * as program from "pen/program"
import * as protocol from "pen/protocol"
import { meshes, materials, sounds } from "./assets/catalog.json"

const schema: U32 = 1

const arrow_left_bit: U32 = 1
const arrow_right_bit: U32 = 2
const arrow_up_bit: U32 = 4
const arrow_down_bit: U32 = 8
const arrow_all_bits: U32 = 15

const key_1: U32 = 49
const key_2: U32 = 50
const key_3: U32 = 51
const key_4: U32 = 52
const key_5: U32 = 53

const fov_y_rad: F32 = 0.9
const cam_near: F32 = 0.1
const cam_far: F32 = 120.0
const gizmo_handle_len: F32 = 1.75
const gizmo_pick_radius: F32 = 0.25

const default_preferences = preferences.make
  ($preferences.Quality {
    msaa: 1,
    fxaa: false,
    scale: 1.0,
    filtering: 8,
    shadows: 2048,
    occlusion: true,
    sky: true,
    fog: 0.4,
    effects: true,
    bloom: true,
    reflections: 2,
    volumetrics: 1,
  })
  ($preferences.Volumes { master: 0.8, effects: 0.85, music: 0.65 })
  ($preferences.Controls { left_handed: false })

const foliage_wind = $foliage.Wind {
  dir_x: 0.92,
  dir_z: 0.39,
  strength: 0.45,
  gust_freq: 0.55,
  gust_speed: 1.6,
  turbulence: 0.3,
}

const terrain_spec = $kernel_kits.TerrainSpec {
  seed: 1337,
  origin_x: (-6.0),
  origin_z: (-6.0),
  cell_size: 4.0,
  frequency: 0.08,
  octaves: 3,
  ridge_weight: 0.35,
  warp_strength: 0.25,
  amplitude: 1.6,
}

type World is data = $World {
  yaw: F32,
  pitch: F32,
  distance: F32,
  target: Vec3,
  held_arrows: U32,
  time: F32,
  play_time: F32,
  pointer_x: F32,
  pointer_y: F32,
  width: F32,
  height: F32,
  physical_sky: Bool,
  ray_tracing: U32,
  ddgi: Bool,
  oit: Bool,
  upscale: Bool,
  chime_pending: Bool,
  terrain_baked: Bool,
  terrain_height_sum: F32,
  nodes: #[scene_graph.Node],
  editor_state: editor.State,
  history: editor.History,
  pie_snapshot: editor.PlaySnapshot,
}

func make_pose (px: F32) -> (py: F32) -> (pz: F32) -> (sx: F32) -> (sy: F32) -> (sz: F32) : transform.Pose3 =>
  return $transform.Pose3 {
    position: math.vec3 px py pz,
    rotation: math.identity_quat,
    scale: math.vec3 sx sy sz,
  }

func build_initial_nodes () : #[scene_graph.Node] =>
  // Procedural foliage pillar heights via 4-wide `spark` SIMD noise grid.
  let hgrid = pcg_noise.simplex2_grid 1337 (-4.0) (-4.0) 2.5 4 4
  let h0 = 0.85 + abs hgrid[0] * 0.55
  let h1 = 0.85 + abs hgrid[3] * 0.55
  let h2 = 0.85 + abs hgrid[12] * 0.55
  let h3 = 0.85 + abs hgrid[15] * 0.55
  return #[
    // 0: Courtyard floor
    scene_graph.root_node 1 (make_pose 0.0 (-0.2) 0.0 6.5 0.2 6.5) meshes.box materials.floor,
    // 1: Central monolith (parent of crystal)
    scene_graph.root_node 2 (make_pose 0.0 1.2 0.0 0.75 1.2 0.75) meshes.box materials.monolith,
    // 2: Floating iridescent `.matgraph.json` crystal (child of monolith at index 1)
    scene_graph.child_node 3 1 (make_pose 0.0 1.65 0.0 0.72 0.78 0.72) meshes.sphere materials.crystal,
    // 3: Emissive amber beacon orb (drives DDGI & RT2 color bleed)
    scene_graph.root_node 4 (make_pose (-2.7) 1.35 (-1.3) 0.45 0.45 0.45) meshes.sphere materials.beacon,
    // 4: Translucent crimson stained glass pane (WBOIT front)
    scene_graph.root_node 5 (make_pose 2.15 1.35 0.45 0.9 1.35 0.07) meshes.box materials.glass_red,
    // 5: Translucent cobalt stained glass pane (WBOIT back)
    scene_graph.root_node 6 (make_pose 2.45 1.35 (-0.55) 0.9 1.35 0.07) meshes.box materials.glass_blue,
    // 6..9: Procedural foliage pillars swayed via `spark` SIMD gusts
    scene_graph.root_node 7 (make_pose (-4.2) h0 (-3.6) 0.45 h0 0.45) meshes.box materials.foliage,
    scene_graph.root_node 8 (make_pose 4.2 h1 (-3.6) 0.45 h1 0.45) meshes.box materials.foliage,
    scene_graph.root_node 9 (make_pose (-4.2) h2 3.1 0.45 h2 0.45) meshes.box materials.foliage,
    scene_graph.root_node 10 (make_pose 4.2 h3 3.1 0.45 h3 0.45) meshes.box materials.foliage,
  ]

func create () : World =>
  let ed = editor.new_state ()
  ed.selected_id := $Some 2
  return $World {
    yaw: 0.45,
    pitch: (-0.34),
    distance: 9.6,
    target: math.vec3 0.0 1.25 0.0,
    held_arrows: 0,
    time: 0.0,
    play_time: 0.0,
    pointer_x: 0.0,
    pointer_y: 0.0,
    width: 1280.0,
    height: 720.0,
    physical_sky: true,
    ray_tracing: 2,
    ddgi: true,
    oit: true,
    upscale: false,
    chime_pending: false,
    terrain_baked: false,
    terrain_height_sum: 0.0,
    nodes: build_initial_nodes (),
    editor_state: ed,
    history: editor.new_history 64,
    pie_snapshot: $editor.PlaySnapshot { active: false, nodes: #[] },
  }

func build_camera (world: World) -> (aspect: F32) : camera.Camera =>
  let rot = math.yaw_pitch world.yaw world.pitch
  let back_dir = math.Quat.rotate rot math.back
  let eye = world.target + back_dir * world.distance
  return $camera.Camera {
    position: eye,
    rotation: rot,
    projection: $camera.Perspective {
      fov_y: fov_y_rad,
      aspect: max 0.1 aspect,
      near: cam_near,
      far: cam_far,
      reversed: false,
    },
  }

func screen_ray (world: World) -> (px: F32) -> (py: F32) : Maybe math.Ray =>
  let w = max 1.0 world.width
  let h = max 1.0 world.height
  let cam = build_camera world (w / h)
  let ndc_x = (px / w) * 2.0 - 1.0
  let ndc_y = 1.0 - (py / h) * 2.0
  return camera.pick_ray cam ndc_x ndc_y

func arrow_bit (code: U32) : U32 =>
  if code == keys.left:
    return arrow_left_bit
  if code == keys.right:
    return arrow_right_bit
  if code == keys.up:
    return arrow_up_bit
  if code == keys.down:
    return arrow_down_bit
  return 0

func apply_event (world: own World) -> (event: events.Event) : World =>
  case event of
    $events.KeyDown code => do:
      let bit = arrow_bit code
      if bit != 0:
        world.held_arrows := world.held_arrows | bit
      if code == keys.w:
        world.editor_state.mode := editor.mode_translate
      if code == keys.e:
        world.editor_state.mode := editor.mode_rotate
      if code == keys.r:
        world.editor_state.mode := editor.mode_scale
      if code == keys.z and not world.editor_state.playing:
        let (undone, next_hist, next_nodes) = editor.undo world.history world.nodes
        world.history := next_hist
        world.nodes := next_nodes
        if undone:
          world.chime_pending := true
      if code == keys.y and not world.editor_state.playing:
        let (redone, next_hist, next_nodes) = editor.redo world.history world.nodes
        world.history := next_hist
        world.nodes := next_nodes
        if redone:
          world.chime_pending := true
      if code == keys.p:
        if world.editor_state.playing:
          let (next_ed, restored_nodes) = editor.exit_play world.editor_state world.pie_snapshot world.nodes
          world.editor_state := next_ed
          world.nodes := restored_nodes
          world.pie_snapshot := $editor.PlaySnapshot { active: false, nodes: #[] }
          world.play_time := 0.0
          world.chime_pending := true
        else:
          let (next_ed, snap) = editor.enter_play world.editor_state (&world.nodes[0..world.nodes.length])
          world.editor_state := next_ed
          world.pie_snapshot := snap
          world.play_time := 0.0
          world.chime_pending := true
      if code == key_1:
        world.physical_sky := not world.physical_sky
      if code == key_2:
        world.ray_tracing := (world.ray_tracing + 1) % 3
      if code == key_3:
        world.ddgi := not world.ddgi
      if code == key_4:
        world.oit := not world.oit
      if code == key_5:
        world.upscale := not world.upscale
    $events.KeyUp code => do:
      let bit = arrow_bit code
      if bit != 0:
        world.held_arrows := world.held_arrows & (arrow_all_bits ^ bit)
    $events.FocusLost => do:
      world.held_arrows := 0
      world.editor_state := editor.end_drag world.editor_state
    $events.Wheel { delta } => do:
      world.distance := clamp 3.5 22.0 (world.distance - delta * 0.4)
    $events.PointerDown { button, x, y } => do:
      world.pointer_x := x
      world.pointer_y := y
      if button == 0 and not world.editor_state.playing:
        if let $Some ray = screen_ray world x y:
          let resolved = scene_graph.resolve (&world.nodes[0..world.nodes.length])
          let started_drag = false
          if let $Some sel_id = world.editor_state.selected_id:
            if let $Some wi = editor.find_world_index (&resolved[0..resolved.length]) sel_id:
              let axes = editor.gizmo_axes_world world.editor_state.space resolved[wi].world
              let axis = editor.pick_gizmo_axis ray resolved[wi].world.position axes gizmo_handle_len gizmo_pick_radius
              if axis != editor.axis_none:
                if let $Some ni = editor.find_node_index (&world.nodes[0..world.nodes.length]) sel_id:
                  let parent_world = Maybe.unwrap_or transform.identity3 (scene_graph.parent_world_of (&world.nodes[0..world.nodes.length]) (&resolved[0..resolved.length]) ni)
                  world.editor_state := editor.begin_drag world.editor_state axis ray resolved[wi].world.position axes world.nodes[ni].local parent_world
                  started_drag := world.editor_state.active_axis != editor.axis_none
          if not started_drag:
            let picked = editor.pick_node ray (&resolved[0..resolved.length]) 1.0
            world.editor_state.selected_id := picked
            if let $Some _ = picked:
              world.chime_pending := true
    $events.PointerMove { x, y } => do:
      world.pointer_x := x
      world.pointer_y := y
      if not world.editor_state.playing and world.editor_state.active_axis != editor.axis_none:
        if let $Some ray = screen_ray world x y:
          if let $Some sel_id = world.editor_state.selected_id:
            if let $Some ni = editor.find_node_index (&world.nodes[0..world.nodes.length]) sel_id:
              let next_pose = editor.solve_drag world.editor_state ray
              let node = world.nodes[ni]
              node.local := next_pose
              world.nodes[ni] := node
    $events.PointerUp { button, x, y } => do:
      world.pointer_x := x
      world.pointer_y := y
      if button == 0 and world.editor_state.active_axis != editor.axis_none:
        if let $Some sel_id = world.editor_state.selected_id:
          if let $Some ni = editor.find_node_index (&world.nodes[0..world.nodes.length]) sel_id:
            let cmd = $editor.SetPose {
              node_id: sel_id,
              before: world.editor_state.drag_start_pose,
              after: world.nodes[ni].local,
            }
            let (next_hist, next_nodes) = editor.commit_command cmd world.history world.nodes
            world.history := next_hist
            world.nodes := next_nodes
            world.chime_pending := true
        world.editor_state := editor.end_drag world.editor_state
    _ => ()
  return world

const crystal_hover_track = #[
  $sequencer.ScalarKey { time: 0.0, value: 1.65, interp: sequencer.interp_hermite, out_tangent: 1.2, next_in_tangent: 1.2 },
  $sequencer.ScalarKey { time: 2.0, value: 2.35, interp: sequencer.interp_hermite, out_tangent: (-1.2), next_in_tangent: (-1.2) },
  $sequencer.ScalarKey { time: 4.0, value: 1.65, interp: sequencer.interp_linear, out_tangent: 0.0, next_in_tangent: 0.0 },
]

func step (world: own World) -> (dt: F32) -> (width: F32) -> (height: F32) -> (incoming: &[events.Event]) : World =>
  world.width := max 1.0 width
  world.height := max 1.0 height
  world.chime_pending := false
  for event in incoming:
    world := apply_event self event
  let clamped_dt = clamp 0.0 0.1 dt
  world.time := world.time + clamped_dt
  // Smooth orbit rotation from held arrow keys.
  let turn_speed = 1.35 * clamped_dt
  if (world.held_arrows & arrow_left_bit) != 0:
    world.yaw := world.yaw + turn_speed
  if (world.held_arrows & arrow_right_bit) != 0:
    world.yaw := world.yaw - turn_speed
  if (world.held_arrows & arrow_up_bit) != 0:
    world.pitch := clamp (-1.3) (-0.08) (world.pitch - turn_speed * 0.7)
  if (world.held_arrows & arrow_down_bit) != 0:
    world.pitch := clamp (-1.3) (-0.08) (world.pitch + turn_speed * 0.7)
  // During Play-in-Editor, animate the iridescent crystal & beacon orb via `ink/sequencer`.
  if world.editor_state.playing:
    let player = $sequencer.Player { time: world.play_time, duration: 4.0, speed: 1.0, playing: true, looping: true }
    let stepped = sequencer.advance player clamped_dt
    world.play_time := stepped.player.time
    let hover_y = sequencer.sample_scalar (&crystal_hover_track[0..3]) world.play_time
    if let $Some ci = editor.find_node_index (&world.nodes[0..world.nodes.length]) 3:
      let cnode = world.nodes[ci]
      cnode.local.position := math.vec3 cnode.local.position.x hover_y cnode.local.position.z
      cnode.local.rotation := math.Quat.yaw (world.play_time * 1.5707963)
      world.nodes[ci] := cnode
    if let $Some bi = editor.find_node_index (&world.nodes[0..world.nodes.length]) 4:
      let bnode = world.nodes[bi]
      let ang = world.play_time * 1.5707963
      bnode.local.position := math.vec3 ((-2.7) * cos ang) (1.35 + 0.35 * sin (ang * 2.0)) ((-1.3) + 1.6 * sin ang)
      world.nodes[bi] := bnode
  return world

func affine_to_mat4 (a: transform.Affine3) : math.Mat4 => $math.Mat4 {
  xx: a.x.x, xy: a.x.y, xz: a.x.z, xw: 0.0,
  yx: a.y.x, yy: a.y.y, yz: a.y.z, yw: 0.0,
  zx: a.z.x, zy: a.z.y, zz: a.z.z, zw: 0.0,
  wx: a.position.x, wy: a.position.y, wz: a.position.z, ww: 1.0,
}

func gizmo_style () : editor.GizmoStyle => $editor.GizmoStyle {
  x: $gizmos.Style { mesh: meshes.box, material: materials.gizmo_x, thickness: 0.075 },
  y: $gizmos.Style { mesh: meshes.box, material: materials.gizmo_y, thickness: 0.075 },
  z: $gizmos.Style { mesh: meshes.box, material: materials.gizmo_z, thickness: 0.075 },
  active: $gizmos.Style { mesh: meshes.box, material: materials.gizmo_sel, thickness: 0.11 },
  selection: $gizmos.Style { mesh: meshes.box, material: materials.gizmo_sel, thickness: 0.035 },
  handle_length: gizmo_handle_len,
}

func populate_frame (world: World) -> (frame: own render.FrameAccess) -> (audio: own sound.Access) : (render.FrameAccess, sound.Access) =>
  let aspect = max 0.1 (world.width / max 1.0 world.height)
  let cam = build_camera world aspect
  let (half_s, half_c) = sin_cos (fov_y_rad * 0.5)
  let focal = half_c / half_s
  let view_mat = math.Mat4.view cam.position cam.rotation
  let proj_mat = math.Mat4.perspective focal aspect cam_near cam_far

  frame.settings[0].view := view_mat
  frame.settings[0].projection := proj_mat
  frame.settings[0].taa := true
  frame.settings[0].ssgi := true
  frame.settings[0].render_scale := if world.upscale then 0.65 else 1.0
  frame.settings[0].lighting := $render.Lighting {
    clear: math.vec4 0.14 0.24 0.42 1.0,
    ambient: math.vec3 0.22 0.25 0.32,
    direction: (math.vec3 (-0.52) (-0.68) (-0.52)).normalized,
    color: math.vec3 2.4 2.15 1.85,
  }
  frame.settings[0].clouds := $render.Clouds {
    cover: if world.physical_sky then 0.45 else 0.0,
    drift: math.vec2 (world.time * 0.22) (world.time * 0.11),
  }
  frame.settings[0].post_look := $render.PostLook {
    tonemap: color.tonemap_agx_mode,
    sharpness: 0.25,
    grain: 0.0,
    flare: 0.15,
    outline_strength: 0.0,
  }
  frame.settings[0].features := $render.Features {
    oit: world.oit,
    physical_sky: world.physical_sky,
    upscale: world.upscale,
    ray_tracing: world.ray_tracing,
    ddgi: world.ddgi,
  }
  frame.settings[0].exposure := render.auto_exposure

  // Evaluate `spark` SIMD foliage wind gusts and water Fresnel shimmer for the 4 foliage pillars.
  let resolved = scene_graph.resolve (&world.nodes[0..world.nodes.length])
  let fxs = #[(-4.2), 4.2, (-4.2), 4.2]
  let fzs = #[(-3.6), (-3.6), 3.1, 3.1]
  let gusts = foliage.gust_factors_batch foliage_wind (&fxs[0..4]) (&fzs[0..4]) world.time
  let cos_angles = #[0.25, 0.45, 0.65, 0.85]
  let fres = water.fresnel_batch (&cos_angles[0..4]) 0.02

  for i in 0 .. resolved.length:
    let wn = resolved[i]
    if wn.visible and wn.mesh != scene_graph.no_mesh:
      let mat4 = affine_to_mat4 wn.world
      if wn.id >= 7 and wn.id <= 10:
        let fi = wn.id - 7
        let sway = (gusts[fi] - 0.5) * 0.18 + fres[fi] * 0.04
        mat4.yx := mat4.yx + sway
      @storage.push frame.draws ($render.Draw {
        mesh: wn.mesh,
        material: wn.material,
        matrix: mat4,
        parameters: $Nothing,
        extra: render.no_span,
      })

  // LTC rectangular ceiling softbox light + stained-glass cookie spotlight projector.
  @storage.push frame.area_lights ($render.AreaLight {
    kind: render.area_light_rect,
    position: math.vec3 0.0 5.4 0.5,
    right: math.right,
    up: math.forward,
    color: math.vec3 1.0 0.88 0.72,
    intensity: 6.5,
    width: 3.0,
    height: 1.8,
    range: 18.0,
    cookie_material: 0,
    two_sided: false,
  })
  @storage.push frame.area_lights ($render.AreaLight {
    kind: 3,
    position: math.vec3 3.2 4.6 1.8,
    right: (math.vec3 (-0.5) 0.0 0.866).normalized,
    up: (math.vec3 (-0.43) 0.86 (-0.25)).normalized,
    color: math.vec3 0.85 0.95 1.0,
    intensity: 10.0,
    width: 2.2,
    height: 2.2,
    range: 16.0,
    cookie_material: materials.cookie + 1,
    two_sided: false,
  })

  // Deferred PBR floor emblem decal (albedo + normal + ORM + cyan glow).
  @storage.push frame.pbr_decals ($render.PbrDecal {
    material: materials.decal,
    matrix: transform.matrix (make_pose 0.0 0.0 2.6 1.55 0.35 1.55),
    albedo: math.vec4 1.0 1.0 1.0 1.0,
    normal_strength: 0.9,
    roughness: 0.25,
    metallic: 0.6,
    emissive_strength: 1.6,
    fade: 1.0,
  })

  // 3D selection box & RGB axis gizmo handles while editing.
  if not world.editor_state.playing:
    frame := editor.draw_gizmo (gizmo_style ()) world.editor_state (&resolved[0..resolved.length]) self

  // 3D spatial audio: listener, courtyard reverb zone, subtle DSP synth pad, UI chime.
  let fwd = math.Quat.forward cam.rotation
  let up_v = math.Quat.up cam.rotation
  audio := sound.set_listener self (sound.listener cam.position fwd up_v)
  let zone = sound.reverb_zone 1 (math.vec3 0.0 2.0 0.0) (math.vec3 8.0 5.0 8.0)
  zone.decay := 2.4
  zone.damping := 0.35
  zone.wet := 0.28
  audio := sound.add_reverb_zone self zone
  let pad = sound.synth_voice 1 sound.synth_triangle sound.ambience (if world.editor_state.playing then 220.0 else 164.81)
  pad.gain := 0.04
  pad.cutoff := 900.0
  pad.reverb := 0.35
  audio := sound.play_synth self pad
  if world.chime_pending:
    audio := sound.ui self sounds.chime 0.55 (if world.editor_state.playing then 1.25 else 1.0)
  return (frame, audio)

// Serializes the full editor/world state for quicksaves, hot-reload, and `pen packets`.
func save (world: World) : #[F32] =>
  let sel = case world.editor_state.selected_id of
    $Some id => U32.to_f32 id
    $Nothing => 0.0
  let out: #[F32] = #[
    world.yaw,
    world.pitch,
    world.distance,
    world.target.x,
    world.target.y,
    world.target.z,
    world.time,
    world.play_time,
    if world.physical_sky then 1.0 else 0.0,
    U32.to_f32 world.ray_tracing,
    if world.ddgi then 1.0 else 0.0,
    if world.oit then 1.0 else 0.0,
    if world.upscale then 1.0 else 0.0,
    sel,
    U32.to_f32 world.editor_state.mode,
    if world.editor_state.playing then 1.0 else 0.0,
    world.terrain_height_sum,
    U32.to_f32 world.nodes.length,
  ]
  for i in 0 .. world.nodes.length:
    let n = world.nodes[i]
    @storage.push out (U32.to_f32 n.id)
    @storage.push out (if n.parent == scene_graph.no_parent then (-1.0) else U32.to_f32 n.parent)
    @storage.push out n.local.position.x
    @storage.push out n.local.position.y
    @storage.push out n.local.position.z
    @storage.push out n.local.rotation.x
    @storage.push out n.local.rotation.y
    @storage.push out n.local.rotation.z
    @storage.push out n.local.rotation.w
    @storage.push out n.local.scale.x
    @storage.push out n.local.scale.y
    @storage.push out n.local.scale.z
    @storage.push out (if n.visible then 1.0 else 0.0)
    @storage.push out (U32.to_f32 n.mesh)
    @storage.push out (U32.to_f32 n.material)
    @storage.push out (U32.to_f32 n.tag)
  return out

func restore (lanes_in: &[F32]) : World =>
  let base = create ()
  if lanes_in.length < 18:
    return base
  base.yaw := lanes_in[0]
  base.pitch := lanes_in[1]
  base.distance := lanes_in[2]
  base.target := math.vec3 lanes_in[3] lanes_in[4] lanes_in[5]
  base.time := lanes_in[6]
  base.play_time := lanes_in[7]
  base.physical_sky := lanes_in[8] >= 0.5
  base.ray_tracing := F32.to_u32 (max 0.0 lanes_in[9]) % 3
  base.ddgi := lanes_in[10] >= 0.5
  base.oit := lanes_in[11] >= 0.5
  base.upscale := lanes_in[12] >= 0.5
  let sel_raw = F32.to_u32 (max 0.0 lanes_in[13])
  base.editor_state.selected_id := if sel_raw == 0 then $Nothing else $Some sel_raw
  base.editor_state.mode := F32.to_u32 (max 0.0 lanes_in[14]) % 3
  base.editor_state.playing := lanes_in[15] >= 0.5
  base.terrain_height_sum := lanes_in[16]
  let count = F32.to_u32 (max 0.0 lanes_in[17])
  if count > 0 and lanes_in.length >= 18 + count * 16:
    let nodes: #[scene_graph.Node] = #[]
    for i in 0 .. count:
      let o = 18 + i * 16
      let p_raw = lanes_in[o + 1]
      let parent = if p_raw < 0.0 then scene_graph.no_parent else F32.to_u32 p_raw
      let local = $transform.Pose3 {
        position: math.vec3 lanes_in[o + 2] lanes_in[o + 3] lanes_in[o + 4],
        rotation: math.Quat.normalized ($math.Quat { x: lanes_in[o + 5], y: lanes_in[o + 6], z: lanes_in[o + 7], w: lanes_in[o + 8] }),
        scale: math.vec3 lanes_in[o + 9] lanes_in[o + 10] lanes_in[o + 11],
      }
      @storage.push nodes ($scene_graph.Node {
        id: F32.to_u32 (max 0.0 lanes_in[o]),
        parent,
        local,
        visible: lanes_in[o + 12] >= 0.5,
        mesh: F32.to_u32 (max 0.0 lanes_in[o + 13]),
        material: F32.to_u32 (max 0.0 lanes_in[o + 14]),
        tag: F32.to_u32 (max 0.0 lanes_in[o + 15]),
      })
    base.nodes := nodes
  return base

type Access = {
  world: World,
  frame: render.FrameAccess,
  audio: sound.Access,
  packet_events: #[protocol.Event],
  events: #[events.Event],
  ui_nodes: #[tree.StoredNode],
  ui_labels: #[U32],
  services: services.Services,
  service_output: #[services.Request],
  kernel_out: #[services.Request],
  kernels: kernel_transport.Access,
  preferences: #[preferences.Preferences],
  requests: #[U32],
  terrain_hash: kernel.Hash64,
}

func make_terrain_cells () : #[F32] =>
  let out: #[F32] = #[]
  for z in 0 .. 4:
    for x in 0 .. 4:
      @storage.push out (U32.to_f32 x)
      @storage.push out (U32.to_f32 z)
  return out

func init_access () : Access =>
  let owners = host.frame_owners ()
  let svc_next = #[1]
  let svc_outbox: #[services.Request] = #[]
  let svc_waiting: #[services.Request] = #[]
  let svc_filling: #[services.Filling] = #[]
  let svc_answers: #[services.Answer] = #[]
  let svc_statuses: #[U32] = #[]
  let svc_payload: #[F32] = #[]
  let svc = services.access svc_next svc_outbox svc_waiting svc_filling svc_answers svc_statuses svc_payload
  let packet_events: #[protocol.Event] = #[]
  let kernel_out: #[services.Request] = #[]
  let terrain_wire = kernel_kits.terrain_ctx_pack terrain_spec
  let terrain_hash = kernel.fnv1a64_f32s (&terrain_wire[0..terrain_wire.length])
  return {
    world: create (),
    frame: owners.frame,
    audio: owners.audio,
    packet_events,
    events: owners.events,
    ui_nodes: owners.ui_nodes,
    ui_labels: owners.ui_labels,
    services: svc,
    service_output: owners.service_output,
    kernel_out,
    kernels: kernel_transport.owners (),
    preferences: #[default_preferences],
    requests: persist.requests (),
    terrain_hash,
  }

func measure_current_frame (access: Access) : U32 =>
  let drawn = render.finish access.frame
  let audio_view = sound.read access.audio
  let ui_view = &access.ui_nodes[0..access.ui_nodes.length]
  let svc_view = &access.service_output[0..access.service_output.length]
  return host.measure_frame_floats audio_view access.preferences[0] ui_view drawn svc_view access.services

const acknowledge = func access -> published => ()

func execute (terrain_kernel: Kernel [#[F32], #[2; F32], #[4; F32]]) -> (access: own Access) -> (operation: U32) -> (payload: &[F32]) -> (outgoing: own #[F32]) =>
  case operation of
    1 => do:
      access.world := create ()
      outgoing := program.append (save access.world) self
    2 => do:
      access.frame := render.begin_frame self
      access.audio := sound.begin_frame self
      let packet: #[F32] = array.generate payload.length (func i => payload.at i)
      let (input, next_pe, next_ev) = host.decode_frame packet access.packet_events access.events
      access.packet_events := next_pe
      access.events := next_ev
      // Deliver `request == 0` multi-core kernel events and apply preferences before stepping.
      let ev_copy: #[events.Event] = copy access.events
      access.kernels := kernel_transport.receive_events self (&ev_copy[0..ev_copy.length])
      for ev in ev_copy:
        access.preferences := preferences.receive self ev
      if let $Some ans = kernel_kits.find_answer_for access.kernels terrain_kernel access.terrain_hash:
        let vals = kernel_transport.batch_values access.kernels ans
        let sum = 0.0
        for i in 0 .. ans.item_count:
          if i * 4 < vals.length:
            sum := sum + vals[i * 4]
        access.world.terrain_height_sum := sum
        access.world.terrain_baked := true
      access.world := step self input.elapsed input.width input.height (&ev_copy[0..ev_copy.length])
      // Dispatch the 16-cell terrain bake batch to Pen's multi-core worker pool once CAP arrives.
      if not access.world.terrain_baked:
        let wire = kernel_kits.terrain_ctx_pack terrain_spec
        let cells = make_terrain_cells ()
        let (_, next_kt) = kernel_kits.dispatch_batch access.kernels terrain_kernel access.terrain_hash (&wire[0..wire.length]) 16 (&cells[0..cells.length])
        access.kernels := next_kt
      let (next_frame, next_audio) = populate_frame access.world access.frame access.audio
      access.frame := next_frame
      access.audio := next_audio
      let base_floats = measure_current_frame access
      let svc_count = access.service_output.length
      let kout_fresh: #[services.Request] = #[]
      let (next_kt, next_kout) = host.admit_kernel_requests base_floats svc_count access.kernels kout_fresh
      access.kernels := next_kt
      access.kernel_out := next_kout
      let drawn = render.finish access.frame
      let audio_view = sound.read access.audio
      let ui_view = &access.ui_nodes[0..access.ui_nodes.length]
      let ui_label_view = &access.ui_labels[0..access.ui_labels.length]
      let svc_view = &access.service_output[0..access.service_output.length]
      outgoing := host.append_frame_with_kernels schema access.requests audio_view access.preferences[0] ui_view ui_label_view drawn
        svc_view access.services (&access.kernel_out[0..access.kernel_out.length]) (&access.kernels.payload[0..access.kernels.payload.length]) self
      access.preferences[0].changed := false
    3 => do:
      outgoing := program.append (save access.world) self
    4 => do:
      access.world := restore payload
      outgoing := program.append (save access.world) self
    _ => panic "scenes are not supported"
  return (access, outgoing)

func run (terrain_kernel: Kernel [#[F32], #[2; F32], #[4; F32]]) -> host =>
  let incoming: #[F32] = #[]
  let outgoing: #[F32] = #[]
  let access = init_access ()
  use _ <- program.run (execute terrain_kernel) acknowledge access schema false incoming outgoing host
  return ()
