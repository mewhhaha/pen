  encoded[134] := U32.to_f32 source_services_count
  encoded[135] := U32.to_f32 services_lanes
  encoded[136] := U32.to_f32 source_buses_count
  encoded[137] := U32.to_f32 source_voices_count
  encoded[138] := U32.to_f32 source_poses_count
  encoded[139] := U32.to_f32 source_emitters_count
  encoded[140] := lanes.bit packet.quality.taa
  encoded[141] := U32.to_f32 source_lights_count
  encoded[142] := U32.to_f32 source_listener_count
  encoded[143] := U32.to_f32 source_panners_count
  encoded[144] := lanes.bit packet.loading
  encoded[145] := lanes.bit packet.show_captions
  encoded[146] := lanes.bit packet.retained_enabled
  encoded[147] := lanes.bit packet.retained_reset
  encoded[148] := U32.to_f32 (packet.retained_after)
  encoded[149] := U32.to_f32 source_instances_count
  encoded[150] := U32.to_f32 source_instance_removals_count
  at := protocol.packet_header_floats
  for value in collections.state:
    encoded[at] := value
    at := self + 1
  for draw in draws:
    let extra = extra_of draw
    let extra_count: U32 = extra.length
    let (mesh, material) = metadata_of draw
    let (m0, m1, m2, m3, m4, m5, m6, m7, m8, m9, m10, m11, m12, m13, m14, m15) = matrix_of draw
    let (present, p0, p1, p2, p3) = parameters_of draw
    encoded[at + 0] := U32.to_f32 mesh
    encoded[at + 1] := U32.to_f32 material
    encoded[at + 2] := m0
    encoded[at + 3] := m1
    encoded[at + 4] := m2
    encoded[at + 5] := m3
    encoded[at + 6] := m4
    encoded[at + 7] := m5
    encoded[at + 8] := m6
    encoded[at + 9] := m7
    encoded[at + 10] := m8
    encoded[at + 11] := m9
    encoded[at + 12] := m10
    encoded[at + 13] := m11
    encoded[at + 14] := m12
    encoded[at + 15] := m13
    encoded[at + 16] := m14
    encoded[at + 17] := m15
    encoded[at + 18] := present
    encoded[at + 19] := p0
    encoded[at + 20] := p1
    encoded[at + 21] := p2
    encoded[at + 22] := p3
    encoded[at + 23] := U32.to_f32 (extra_count / 4)
    at := self + 24
  for source_solid in collections.solids:
    let solid = project.solid context source_solid
    let view_solid_faces_count: U32 = solid.faces.length
    encoded[at + 0] := U32.to_f32 view_solid_faces_count
    at := self + 1
    for face in solid.faces:
      encoded[at + 0] := face.normal.x
      encoded[at + 1] := face.normal.y
      encoded[at + 2] := face.normal.z
      encoded[at + 3] := face.distance
      encoded[at + 4] := U32.to_f32 (face.material)
      at := self + 5
  for source_decal in collections.decals:
    let decal: types.Decal = project.decal context source_decal
    encoded[at + 0] := U32.to_f32 (decal.material)
    let $types.Mat4 { x: transform_x, y: transform_y, z: transform_z, w: transform_w } = decal.transform
    encoded[at + 1] := transform_x.x
    encoded[at + 2] := transform_x.y
    encoded[at + 3] := transform_x.z
    encoded[at + 4] := transform_x.w
    encoded[at + 5] := transform_y.x
    encoded[at + 6] := transform_y.y
    encoded[at + 7] := transform_y.z
    encoded[at + 8] := transform_y.w
    encoded[at + 9] := transform_z.x
    encoded[at + 10] := transform_z.y
    encoded[at + 11] := transform_z.z
    encoded[at + 12] := transform_z.w
    encoded[at + 13] := transform_w.x
    encoded[at + 14] := transform_w.y
    encoded[at + 15] := transform_w.z
    encoded[at + 16] := transform_w.w
    encoded[at + 17] := decal.opacity
    at := self + 18
  for source_sound in collections.sounds:
    let sound: types.Sound = project.sound context source_sound
    encoded[at + 0] := U32.to_f32 (sound.clip)
    encoded[at + 1] := U32.to_f32 (sound.bus)
    encoded[at + 2] := sound.gain
    encoded[at + 3] := sound.pan
    encoded[at + 4] := sound.pitch
    encoded[at + 5] := sound.lowpass
    encoded[at + 6] := sound.reverb
    at := self + 7
  for source_sprite in collections.sprites:
    let sprite: types.Sprite = project.sprite context source_sprite
    encoded[at + 0] := sprite.x
    encoded[at + 1] := sprite.y
    encoded[at + 2] := sprite.width
    encoded[at + 3] := sprite.height
    encoded[at + 4] := sprite.u0
    encoded[at + 5] := sprite.v0
    encoded[at + 6] := sprite.u1
    encoded[at + 7] := sprite.v1
    encoded[at + 8] := sprite.color.x
    encoded[at + 9] := sprite.color.y
    encoded[at + 10] := sprite.color.z
    encoded[at + 11] := sprite.color.w
    encoded[at + 12] := U32.to_f32 (sprite.material)
    encoded[at + 13] := sprite.parameters.x
    encoded[at + 14] := sprite.parameters.y
    encoded[at + 15] := sprite.parameters.z
    encoded[at + 16] := sprite.parameters.w
    at := self + 17
  for source_inset in collections.insets:
    let inset = project.inset context source_inset
    let view_inset_draws_count: U32 = inset.draws.length
    encoded[at + 0] := inset.x
    encoded[at + 1] := inset.y
    encoded[at + 2] := inset.width
    encoded[at + 3] := inset.height
    let $types.Mat4 { x: view_x, y: view_y, z: view_z, w: view_w } = inset.view
    encoded[at + 4] := view_x.x
    encoded[at + 5] := view_x.y
    encoded[at + 6] := view_x.z
    encoded[at + 7] := view_x.w
    encoded[at + 8] := view_y.x
    encoded[at + 9] := view_y.y
    encoded[at + 10] := view_y.z
    encoded[at + 11] := view_y.w
    encoded[at + 12] := view_z.x
    encoded[at + 13] := view_z.y
    encoded[at + 14] := view_z.z
    encoded[at + 15] := view_z.w
    encoded[at + 16] := view_w.x
    encoded[at + 17] := view_w.y
    encoded[at + 18] := view_w.z
    encoded[at + 19] := view_w.w
    let $types.Mat4 { x: projection_x, y: projection_y, z: projection_z, w: projection_w } = inset.projection
    encoded[at + 20] := projection_x.x
    encoded[at + 21] := projection_x.y
    encoded[at + 22] := projection_x.z
    encoded[at + 23] := projection_x.w
    encoded[at + 24] := projection_y.x
    encoded[at + 25] := projection_y.y
    encoded[at + 26] := projection_y.z
    encoded[at + 27] := projection_y.w
    encoded[at + 28] := projection_z.x
    encoded[at + 29] := projection_z.y
    encoded[at + 30] := projection_z.z
    encoded[at + 31] := projection_z.w
    encoded[at + 32] := projection_w.x
    encoded[at + 33] := projection_w.y
    encoded[at + 34] := projection_w.z
    encoded[at + 35] := projection_w.w
    encoded[at + 36] := inset.ambient.x
    encoded[at + 37] := inset.ambient.y
    encoded[at + 38] := inset.ambient.z
    encoded[at + 39] := inset.light_direction.x
    encoded[at + 40] := inset.light_direction.y
    encoded[at + 41] := inset.light_direction.z
    encoded[at + 42] := inset.light_color.x
    encoded[at + 43] := inset.light_color.y
    encoded[at + 44] := inset.light_color.z
    encoded[at + 45] := U32.to_f32 (view_inset_draws_count)
    encoded[at + 46] := inset.pixel_size
    encoded[at + 47] := U32.to_f32 (inset.after_sprites)
    at := self + 48
  for source_inset in collections.insets:
    let inset = project.inset context source_inset
    let view_inset_draws_count: U32 = inset.draws.length
    for source_inset_draw in inset.draws:
      let inset_draw = project.inset_draw context source_inset_draw
      let view_inset_draw_extra_count: U32 = inset_draw.extra.length
      encoded[at + 0] := U32.to_f32 (inset_draw.mesh)
      encoded[at + 1] := U32.to_f32 (inset_draw.material)
      let $types.Mat4 { x: transform_x, y: transform_y, z: transform_z, w: transform_w } = inset_draw.transform
      encoded[at + 2] := transform_x.x
      encoded[at + 3] := transform_x.y
      encoded[at + 4] := transform_x.z
      encoded[at + 5] := transform_x.w
      encoded[at + 6] := transform_y.x
      encoded[at + 7] := transform_y.y
      encoded[at + 8] := transform_y.z
      encoded[at + 9] := transform_y.w
      encoded[at + 10] := transform_z.x
      encoded[at + 11] := transform_z.y
      encoded[at + 12] := transform_z.z
      encoded[at + 13] := transform_z.w
      encoded[at + 14] := transform_w.x
      encoded[at + 15] := transform_w.y
      encoded[at + 16] := transform_w.z
      encoded[at + 17] := transform_w.w
      let (parameters_count, parameters) = case inset_draw.parameters of
        $Some value => (4.0, value)
        $Nothing => (0.0, types.zero4)
      encoded[at + 18] := parameters_count
      encoded[at + 19] := parameters.x
      encoded[at + 20] := parameters.y
      encoded[at + 21] := parameters.z
      encoded[at + 22] := parameters.w
      encoded[at + 23] := U32.to_f32 (min view_inset_draw_extra_count protocol.max_draw_extra)
      at := self + 24
  for value in collections.preferences:
    encoded[at] := value
    at := self + 1
  for source_field in collections.fields:
    let field = project.field context source_field
    let view_field_values_count: U32 = field.values.length
    encoded[at + 0] := U32.to_f32 (field.material)
    encoded[at + 1] := U32.to_f32 (field.width)
    encoded[at + 2] := U32.to_f32 (field.height)
    encoded[at + 3] := U32.to_f32 (field.x)
    encoded[at + 4] := U32.to_f32 (field.z)
    encoded[at + 5] := U32.to_f32 (field.columns)
    encoded[at + 6] := U32.to_f32 (field.rows)
    at := self + 7
    for value in field.values:
      encoded[at] := value
      at := self + 1
  for source_ui in collections.ui:
    let ui = project.ui context source_ui
    let view_ui_text_count: U32 = ui.text.length
    encoded[at + 0] := U32.to_f32 (ui.id)
    encoded[at + 1] := U32.to_f32 (ui.parent)
    encoded[at + 2] := U32.to_f32 (ui.role)
    encoded[at + 3] := ui.x
    encoded[at + 4] := ui.y
    encoded[at + 5] := ui.width
    encoded[at + 6] := ui.height
    encoded[at + 7] := lanes.bit ui.focusable
    encoded[at + 8] := lanes.bit ui.focused
    encoded[at + 9] := lanes.bit ui.disabled
    encoded[at + 10] := lanes.bit ui.hidden
    encoded[at + 11] := lanes.bit ui.modal
    encoded[at + 12] := U32.to_f32 (ui.checked)
    encoded[at + 13] := U32.to_f32 (ui.expanded)
    encoded[at + 14] := U32.to_f32 (ui.selected)
    encoded[at + 15] := U32.to_f32 (ui.live)
    encoded[at + 16] := ui.value
    encoded[at + 17] := ui.minimum
    encoded[at + 18] := ui.maximum
    encoded[at + 19] := ui.step
    encoded[at + 20] := U32.to_f32 (ui.actions)
    encoded[at + 21] := U32.to_f32 (ui.text_length)
    encoded[at + 22] := U32.to_f32 (ui.name_length)
    encoded[at + 23] := U32.to_f32 (ui.description_length)
    at := self + 24
    for value in ui.text:
      encoded[at] := value
      at := self + 1
  for source_service in collections.services:
    let service = project.service context source_service
    let view_service_values_count: U32 = service.values.length
    encoded[at + 0] := U32.to_f32 (service.request)
    encoded[at + 1] := U32.to_f32 (service.service)
    encoded[at + 2] := U32.to_f32 (service.operation)
    encoded[at + 3] := service.a
    encoded[at + 4] := service.b
    encoded[at + 5] := service.c
    encoded[at + 6] := service.d
    encoded[at + 7] := U32.to_f32 (service.value_count)
    at := self + 8
    for value in service.values:
      encoded[at] := value
      at := self + 1
  for source_buse in collections.buses:
    let buse: types.Bus = project.buse context source_buse
    encoded[at + 0] := buse.gain
    encoded[at + 1] := buse.lowpass
    encoded[at + 2] := buse.reverb
    at := self + 3
  for source_voice in collections.voices:
    let voice: types.Voice = project.voice context source_voice
    encoded[at + 0] := U32.to_f32 (voice.id)
    encoded[at + 1] := U32.to_f32 (voice.clip)
    encoded[at + 2] := U32.to_f32 (voice.bus)
    encoded[at + 3] := voice.gain
    encoded[at + 4] := voice.pan
    encoded[at + 5] := voice.pitch
    encoded[at + 6] := voice.lowpass
    encoded[at + 7] := voice.reverb
    encoded[at + 8] := lanes.bit voice.looping
    encoded[at + 9] := voice.start
    encoded[at + 10] := voice.fade_in
    encoded[at + 11] := voice.fade_out
    at := self + 12
  for source_pose in collections.poses:
    let pose: types.Pose = project.pose context source_pose
    encoded[at + 0] := U32.to_f32 (pose.draw)
    encoded[at + 1] := U32.to_f32 (pose.clip)
    encoded[at + 2] := pose.time
    encoded[at + 3] := pose.weight
    at := self + 4
  for source_emitter in collections.emitters:
    let emitter: types.Emitter = project.emitter context source_emitter
    encoded[at + 0] := U32.to_f32 (emitter.material)
    let $types.Mat4 { x: transform_x, y: transform_y, z: transform_z, w: transform_w } = emitter.transform
    encoded[at + 1] := transform_x.x
    encoded[at + 2] := transform_x.y
    encoded[at + 3] := transform_x.z
    encoded[at + 4] := transform_x.w
    encoded[at + 5] := transform_y.x
    encoded[at + 6] := transform_y.y
    encoded[at + 7] := transform_y.z
    encoded[at + 8] := transform_y.w
    encoded[at + 9] := transform_z.x
    encoded[at + 10] := transform_z.y
    encoded[at + 11] := transform_z.z
    encoded[at + 12] := transform_z.w
    encoded[at + 13] := transform_w.x
    encoded[at + 14] := transform_w.y
    encoded[at + 15] := transform_w.z
    encoded[at + 16] := transform_w.w
    encoded[at + 17] := U32.to_f32 (emitter.seed)
    encoded[at + 18] := emitter.time
    encoded[at + 19] := emitter.duration
    encoded[at + 20] := emitter.rate
    encoded[at + 21] := emitter.lifetime
    encoded[at + 22] := emitter.radius
    encoded[at + 23] := emitter.velocity.x
    encoded[at + 24] := emitter.velocity.y
    encoded[at + 25] := emitter.velocity.z
    encoded[at + 26] := emitter.spread
    encoded[at + 27] := emitter.gravity.x
    encoded[at + 28] := emitter.gravity.y
    encoded[at + 29] := emitter.gravity.z
    encoded[at + 30] := emitter.drag
    encoded[at + 31] := emitter.size_start
    encoded[at + 32] := emitter.size_end
    encoded[at + 33] := emitter.color_start.r
    encoded[at + 34] := emitter.color_start.g
    encoded[at + 35] := emitter.color_start.b
    encoded[at + 36] := emitter.color_start.a
    encoded[at + 37] := emitter.color_end.r
    encoded[at + 38] := emitter.color_end.g
    encoded[at + 39] := emitter.color_end.b
    encoded[at + 40] := emitter.color_end.a
    encoded[at + 41] := lanes.bit emitter.additive
    at := self + 42
  for source_light in collections.lights:
    let light: types.Light = project.light context source_light
    encoded[at + 0] := light.position.x
    encoded[at + 1] := light.position.y
    encoded[at + 2] := light.position.z
    encoded[at + 3] := light.radius
    encoded[at + 4] := light.color.x
    encoded[at + 5] := light.color.y
    encoded[at + 6] := light.color.z
    encoded[at + 7] := light.direction.x
    encoded[at + 8] := light.direction.y
    encoded[at + 9] := light.direction.z
    encoded[at + 10] := light.inner
    encoded[at + 11] := light.outer
    at := self + 12
  for source_listener in collections.listener:
    let listener: types.Listener = project.listener context source_listener
    encoded[at + 0] := listener.position.x
    encoded[at + 1] := listener.position.y
    encoded[at + 2] := listener.position.z
    encoded[at + 3] := listener.forward.x
    encoded[at + 4] := listener.forward.y
    encoded[at + 5] := listener.forward.z
    encoded[at + 6] := listener.up.x
    encoded[at + 7] := listener.up.y
    encoded[at + 8] := listener.up.z
    at := self + 9
  for source_panner in collections.panners:
    let panner: types.Panner = project.panner context source_panner
    encoded[at + 0] := U32.to_f32 (panner.voice)
    encoded[at + 1] := U32.to_f32 (panner.sound)
    encoded[at + 2] := panner.position.x
    encoded[at + 3] := panner.position.y
    encoded[at + 4] := panner.position.z
    encoded[at + 5] := panner.orientation.x
    encoded[at + 6] := panner.orientation.y
    encoded[at + 7] := panner.orientation.z
    encoded[at + 8] := U32.to_f32 (panner.distance_model)
    encoded[at + 9] := panner.ref_distance
    encoded[at + 10] := panner.max_distance
    encoded[at + 11] := panner.rolloff
    encoded[at + 12] := panner.cone_inner
    encoded[at + 13] := panner.cone_outer
    encoded[at + 14] := panner.cone_outer_gain
    at := self + 15
  for source_instance in collections.instances:
    let instance: types.Instance = project.instance context source_instance
    encoded[at + 0] := U32.to_f32 (instance.id_low)
    encoded[at + 1] := U32.to_f32 (instance.id_high)
    encoded[at + 2] := U32.to_f32 (instance.order)
    encoded[at + 3] := U32.to_f32 (instance.mesh)
    encoded[at + 4] := U32.to_f32 (instance.material)
    let $types.Mat4 { x: transform_x, y: transform_y, z: transform_z, w: transform_w } = instance.transform
    encoded[at + 5] := transform_x.x
    encoded[at + 6] := transform_x.y
    encoded[at + 7] := transform_x.z
    encoded[at + 8] := transform_x.w
    encoded[at + 9] := transform_y.x
    encoded[at + 10] := transform_y.y
    encoded[at + 11] := transform_y.z
    encoded[at + 12] := transform_y.w
    encoded[at + 13] := transform_z.x
    encoded[at + 14] := transform_z.y
    encoded[at + 15] := transform_z.z
    encoded[at + 16] := transform_z.w
    encoded[at + 17] := transform_w.x
    encoded[at + 18] := transform_w.y
    encoded[at + 19] := transform_w.z
    encoded[at + 20] := transform_w.w
    let (parameters_count, parameters) = case instance.parameters of
      $Some value => (4.0, value)
      $Nothing => (0.0, types.zero4)
    encoded[at + 21] := parameters_count
    encoded[at + 22] := parameters.x
    encoded[at + 23] := parameters.y
    encoded[at + 24] := parameters.z
    encoded[at + 25] := parameters.w
    at := self + 26
  for source_instance_removal in collections.instance_removals:
    let instance_removal: types.InstanceRemoval = project.instance_removal context source_instance_removal
    encoded[at + 0] := U32.to_f32 (instance_removal.id_low)
    encoded[at + 1] := U32.to_f32 (instance_removal.id_high)
    at := self + 2
  for draw in draws:
    let extra = extra_of draw
    let extra_count: U32 = extra.length
    for value in extra:
      encoded[at] := value
      at := self + 1
  for source_inset in collections.insets:
    let inset = project.inset context source_inset
    let view_inset_draws_count: U32 = inset.draws.length
    for source_inset_draw in inset.draws:
      let inset_draw = project.inset_draw context source_inset_draw
      let view_inset_draw_extra_count: U32 = inset_draw.extra.length
      for index in 0 .. min view_inset_draw_extra_count protocol.max_draw_extra:
        encoded[at + 0] := (inset_draw.extra.at index).x
        encoded[at + 1] := (inset_draw.extra.at index).y
        encoded[at + 2] := (inset_draw.extra.at index).z
        encoded[at + 3] := (inset_draw.extra.at index).w
        at := self + 4
  return ()

// Flat mesh draws (no parameters/extras) and sounds, into a caller-owned packet.
type MeshDraw = { mesh: U32, material: U32, transform: types.Mat4 }
const encode_mesh_frame = func (packet: types.RenderHeader) -> (draws: &[MeshDraw]) -> (sounds: &[types.Sound]) -> (encoded: ResizeArray F32) => return do:
  @storage.truncate encoded 0
  for 0 .. (protocol.packet_header_floats + draws.length * 24 + sounds.length * 7):
    @storage.push encoded 0.0
  encoded[0] := protocol.packet_magic
  encoded[1] := U32.to_f32 packet.schema
  encoded[2] := 0.0
  encoded[3] := U32.to_f32 draws.length
  encoded[4] := 0.0
  encoded[5] := 0.0
  encoded[6] := 0.0
  encoded[7] := U32.to_f32 sounds.length
  encoded[8] := 0.0
  encoded[9] := 0.0
  encoded[10] := 0.0
  encoded[11] := 0.0
  encoded[12] := lanes.bit packet.save_requested
  encoded[13] := lanes.bit packet.load_requested
  encoded[14] := lanes.bit packet.scene_save_requested
  encoded[15] := lanes.bit packet.scene_load_requested
  encoded[16] := lanes.bit packet.checkpoint_requested
  encoded[17] := lanes.bit packet.undo_requested
  encoded[18] := lanes.bit packet.redo_requested
  encoded[19] := lanes.bit packet.exit_requested
  let $types.Mat4 { x: view_x, y: view_y, z: view_z, w: view_w } = packet.view
  encoded[20] := view_x.x
  encoded[21] := view_x.y
  encoded[22] := view_x.z
  encoded[23] := view_x.w
  encoded[24] := view_y.x
  encoded[25] := view_y.y
  encoded[26] := view_y.z
  encoded[27] := view_y.w
  encoded[28] := view_z.x
  encoded[29] := view_z.y
  encoded[30] := view_z.z
  encoded[31] := view_z.w
  encoded[32] := view_w.x
  encoded[33] := view_w.y
  encoded[34] := view_w.z
  encoded[35] := view_w.w
  let $types.Mat4 { x: projection_x, y: projection_y, z: projection_z, w: projection_w } = packet.projection
  encoded[36] := projection_x.x
  encoded[37] := projection_x.y
  encoded[38] := projection_x.z
  encoded[39] := projection_x.w
  encoded[40] := projection_y.x
  encoded[41] := projection_y.y
  encoded[42] := projection_y.z
  encoded[43] := projection_y.w
  encoded[44] := projection_z.x
  encoded[45] := projection_z.y
  encoded[46] := projection_z.z
  encoded[47] := projection_z.w
  encoded[48] := projection_w.x
  encoded[49] := projection_w.y
  encoded[50] := projection_w.z
  encoded[51] := projection_w.w
  encoded[52] := packet.clear.r
  encoded[53] := packet.clear.g
  encoded[54] := packet.clear.b
  encoded[55] := packet.clear.a
  encoded[56] := packet.ambient.x
  encoded[57] := packet.ambient.y
  encoded[58] := packet.ambient.z
  encoded[59] := packet.light_direction.x
  encoded[60] := packet.light_direction.y
  encoded[61] := packet.light_direction.z
  encoded[62] := packet.light_color.x
  encoded[63] := packet.light_color.y
  encoded[64] := packet.light_color.z
  encoded[65] := packet.aberration.x
  encoded[66] := packet.aberration.y
  encoded[67] := U32.to_f32 (packet.quality.msaa)
  encoded[68] := lanes.bit packet.quality.fxaa
  encoded[69] := packet.quality.scale
  encoded[70] := U32.to_f32 (packet.quality.filtering)
  encoded[71] := lanes.bit packet.quality.occlusion
  encoded[72] := lanes.bit packet.quality.sky
  encoded[73] := lanes.bit packet.quality.effects
  encoded[74] := packet.sky.zenith.x
  encoded[75] := packet.sky.zenith.y
  encoded[76] := packet.sky.zenith.z
  encoded[77] := packet.sky.horizon.x
  encoded[78] := packet.sky.horizon.y
  encoded[79] := packet.sky.horizon.z
  encoded[80] := packet.sky.ground.x
  encoded[81] := packet.sky.ground.y
  encoded[82] := packet.sky.ground.z
  encoded[83] := packet.sky.sun.x
  encoded[84] := packet.sky.sun.y
  encoded[85] := packet.sky.sun.z
  encoded[86] := packet.sky.night
  encoded[87] := packet.fog.radius
  encoded[88] := packet.fog.density
  encoded[89] := packet.fog.height
  let $types.Mat4 { x: shadow_view_x, y: shadow_view_y, z: shadow_view_z, w: shadow_view_w } = packet.shadow.view
  encoded[90] := shadow_view_x.x
  encoded[91] := shadow_view_x.y
  encoded[92] := shadow_view_x.z
  encoded[93] := shadow_view_x.w
  encoded[94] := shadow_view_y.x
  encoded[95] := shadow_view_y.y
  encoded[96] := shadow_view_y.z
  encoded[97] := shadow_view_y.w
  encoded[98] := shadow_view_z.x
  encoded[99] := shadow_view_z.y
  encoded[100] := shadow_view_z.z
  encoded[101] := shadow_view_z.w
  encoded[102] := shadow_view_w.x
  encoded[103] := shadow_view_w.y
  encoded[104] := shadow_view_w.z
  encoded[105] := shadow_view_w.w
  let $types.Mat4 { x: shadow_projection_x, y: shadow_projection_y, z: shadow_projection_z, w: shadow_projection_w } = packet.shadow.projection
  encoded[106] := shadow_projection_x.x
  encoded[107] := shadow_projection_x.y
  encoded[108] := shadow_projection_x.z
  encoded[109] := shadow_projection_x.w
  encoded[110] := shadow_projection_y.x
  encoded[111] := shadow_projection_y.y
  encoded[112] := shadow_projection_y.z
  encoded[113] := shadow_projection_y.w
  encoded[114] := shadow_projection_z.x
  encoded[115] := shadow_projection_z.y
  encoded[116] := shadow_projection_z.z
  encoded[117] := shadow_projection_z.w
  encoded[118] := shadow_projection_w.x
  encoded[119] := shadow_projection_w.y
  encoded[120] := shadow_projection_w.z
  encoded[121] := shadow_projection_w.w
  encoded[122] := packet.shadow.texel
  encoded[123] := U32.to_f32 (packet.shadow.texels)
  encoded[124] := packet.blur
  encoded[125] := lanes.bit packet.quality.bloom
  encoded[126] := packet.clouds.cover
  encoded[127] := packet.clouds.drift.x
  encoded[128] := packet.clouds.drift.z
  encoded[129] := lanes.bit packet.hide_cursor
  encoded[130] := 0.0
  encoded[131] := 0.0
  encoded[132] := 0.0
  encoded[133] := 0.0
  encoded[134] := 0.0
  encoded[135] := 0.0
  encoded[136] := 0.0
  encoded[137] := 0.0
  encoded[138] := 0.0
  encoded[139] := 0.0
  encoded[140] := lanes.bit packet.quality.taa
  encoded[141] := 0.0
  encoded[142] := 0.0
  encoded[143] := 0.0
  encoded[144] := lanes.bit packet.loading
  encoded[145] := lanes.bit packet.show_captions
  encoded[146] := lanes.bit packet.retained_enabled
  encoded[147] := lanes.bit packet.retained_reset
  encoded[148] := U32.to_f32 (packet.retained_after)
  encoded[149] := 0.0
  encoded[150] := 0.0
  let at: U32 = protocol.packet_header_floats
  for draw in draws:
    encoded[at + 0] := U32.to_f32 (draw.mesh)
    encoded[at + 1] := U32.to_f32 (draw.material)
    let $types.Mat4 { x: transform_x, y: transform_y, z: transform_z, w: transform_w } = draw.transform
    encoded[at + 2] := transform_x.x
    encoded[at + 3] := transform_x.y
    encoded[at + 4] := transform_x.z
    encoded[at + 5] := transform_x.w
    encoded[at + 6] := transform_y.x
    encoded[at + 7] := transform_y.y
    encoded[at + 8] := transform_y.z
    encoded[at + 9] := transform_y.w
    encoded[at + 10] := transform_z.x
    encoded[at + 11] := transform_z.y
    encoded[at + 12] := transform_z.z
    encoded[at + 13] := transform_z.w
    encoded[at + 14] := transform_w.x
    encoded[at + 15] := transform_w.y
    encoded[at + 16] := transform_w.z
    encoded[at + 17] := transform_w.w
    at := self + 24
  for sound in sounds:
    encoded[at + 0] := U32.to_f32 (sound.clip)
    encoded[at + 1] := U32.to_f32 (sound.bus)
    encoded[at + 2] := sound.gain
    encoded[at + 3] := sound.pan
    encoded[at + 4] := sound.pitch
    encoded[at + 5] := sound.lowpass
    encoded[at + 6] := sound.reverb
    at := self + 7
  return ()
