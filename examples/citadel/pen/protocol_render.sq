    let area_light: types.AreaLightSpec = project.area_light context source
    @storage.push encoded (U32.to_f32 (area_light.kind))
    @storage.push encoded (area_light.position.x)
    @storage.push encoded (area_light.position.y)
    @storage.push encoded (area_light.position.z)
    @storage.push encoded (area_light.right.x)
    @storage.push encoded (area_light.right.y)
    @storage.push encoded (area_light.right.z)
    @storage.push encoded (area_light.up.x)
    @storage.push encoded (area_light.up.y)
    @storage.push encoded (area_light.up.z)
    @storage.push encoded (area_light.color.x)
    @storage.push encoded (area_light.color.y)
    @storage.push encoded (area_light.color.z)
    @storage.push encoded (area_light.intensity)
    @storage.push encoded (area_light.width)
    @storage.push encoded (area_light.height)
    @storage.push encoded (area_light.range)
    @storage.push encoded (U32.to_f32 (area_light.cookie_material))
    @storage.push encoded (lanes.bit area_light.two_sided)
  for i in 0 .. pbr_decals_count:
    let source = collections.pbr_decals[i]
    let pbr_decal: types.PbrDecalSpec = project.pbr_decal context source
    @storage.push encoded (U32.to_f32 (pbr_decal.material))
    let $types.Mat4 { x: transform_x, y: transform_y, z: transform_z, w: transform_w } = pbr_decal.transform
    @storage.push encoded (transform_x.x)
    @storage.push encoded (transform_x.y)
    @storage.push encoded (transform_x.z)
    @storage.push encoded (transform_x.w)
    @storage.push encoded (transform_y.x)
    @storage.push encoded (transform_y.y)
    @storage.push encoded (transform_y.z)
    @storage.push encoded (transform_y.w)
    @storage.push encoded (transform_z.x)
    @storage.push encoded (transform_z.y)
    @storage.push encoded (transform_z.z)
    @storage.push encoded (transform_z.w)
    @storage.push encoded (transform_w.x)
    @storage.push encoded (transform_w.y)
    @storage.push encoded (transform_w.z)
    @storage.push encoded (transform_w.w)
    @storage.push encoded (pbr_decal.albedo.r)
    @storage.push encoded (pbr_decal.albedo.g)
    @storage.push encoded (pbr_decal.albedo.b)
    @storage.push encoded (pbr_decal.albedo.a)
    @storage.push encoded (pbr_decal.normal_strength)
    @storage.push encoded (pbr_decal.roughness)
    @storage.push encoded (pbr_decal.metallic)
    @storage.push encoded (pbr_decal.emissive_strength)
    @storage.push encoded (pbr_decal.fade)
  for i in 0 .. camera_targets_count:
    let source = collections.camera_targets[i]
    let camera_target: types.CameraTargetSpec = project.camera_target context source
    @storage.push encoded (U32.to_f32 (camera_target.material))
    @storage.push encoded (U32.to_f32 (camera_target.width))
    @storage.push encoded (U32.to_f32 (camera_target.height))
    @storage.push encoded (camera_target.viewport_x)
    @storage.push encoded (camera_target.viewport_y)
    @storage.push encoded (camera_target.viewport_w)
    @storage.push encoded (camera_target.viewport_h)
    @storage.push encoded (lanes.bit camera_target.split_screen)
    let $types.Mat4 { x: view_x, y: view_y, z: view_z, w: view_w } = camera_target.view
    @storage.push encoded (view_x.x)
    @storage.push encoded (view_x.y)
    @storage.push encoded (view_x.z)
    @storage.push encoded (view_x.w)
    @storage.push encoded (view_y.x)
    @storage.push encoded (view_y.y)
    @storage.push encoded (view_y.z)
    @storage.push encoded (view_y.w)
    @storage.push encoded (view_z.x)
    @storage.push encoded (view_z.y)
    @storage.push encoded (view_z.z)
    @storage.push encoded (view_z.w)
    @storage.push encoded (view_w.x)
    @storage.push encoded (view_w.y)
    @storage.push encoded (view_w.z)
    @storage.push encoded (view_w.w)
    let $types.Mat4 { x: projection_x, y: projection_y, z: projection_z, w: projection_w } = camera_target.projection
    @storage.push encoded (projection_x.x)
    @storage.push encoded (projection_x.y)
    @storage.push encoded (projection_x.z)
    @storage.push encoded (projection_x.w)
    @storage.push encoded (projection_y.x)
    @storage.push encoded (projection_y.y)
    @storage.push encoded (projection_y.z)
    @storage.push encoded (projection_y.w)
    @storage.push encoded (projection_z.x)
    @storage.push encoded (projection_z.y)
    @storage.push encoded (projection_z.z)
    @storage.push encoded (projection_z.w)
    @storage.push encoded (projection_w.x)
    @storage.push encoded (projection_w.y)
    @storage.push encoded (projection_w.z)
    @storage.push encoded (projection_w.w)
  for i in 0 .. video_streams_count:
    let source = collections.video_streams[i]
    let video_stream: types.VideoStreamSpec = project.video_stream context source
    @storage.push encoded (U32.to_f32 (video_stream.material))
    @storage.push encoded (video_stream.time)
    @storage.push encoded (lanes.bit video_stream.playing)
    @storage.push encoded (lanes.bit video_stream.looping)
    @storage.push encoded (video_stream.speed)
  for i in 0 .. draws_count:
    let source = collections.draws[i]
    encoded := project.append_extra context source (own self)
  for parent in 0 .. insets_count:
    let children = project.inset_draws context collections.insets[parent]
    let count: U32 = children.length
    for i in 0 .. count:
      let source = children.at i
      encoded := project.append_extra context source (own self)
  return encoded

func measure_render_floats collections -> project -> context =>
  let total: U32 = protocol.packet_header_floats
  let state_count: U32 = collections.state.length
  let draws_count: U32 = collections.draws.length
  let solids_count: U32 = collections.solids.length
  let decals_count: U32 = collections.decals.length
  let sounds_count: U32 = collections.sounds.length
  let sprites_count: U32 = collections.sprites.length
  let insets_count: U32 = collections.insets.length
  let preferences_count: U32 = collections.preferences.length
  let fields_count: U32 = collections.fields.length
  let ui_count: U32 = collections.ui.length
  let services_count: U32 = collections.services.length
  let buses_count: U32 = collections.buses.length
  let voices_count: U32 = collections.voices.length
  let poses_count: U32 = collections.poses.length
  let emitters_count: U32 = collections.emitters.length
  let lights_count: U32 = collections.lights.length
  let cascades_count: U32 = collections.cascades.length
  let probes_count: U32 = collections.probes.length
  let reflection_probes_count: U32 = collections.reflection_probes.length
  let fog_volumes_count: U32 = collections.fog_volumes.length
  let listener_count: U32 = collections.listener.length
  let panners_count: U32 = collections.panners.length
  let instances_count: U32 = collections.instances.length
  let instance_removals_count: U32 = collections.instance_removals.length
  let bone_matrices_count: U32 = collections.bone_matrices.length
  let morph_weights_count: U32 = collections.morph_weights.length
  let motions_count: U32 = collections.motions.length
  let ribbons_count: U32 = collections.ribbons.length
  let haptics_count: U32 = collections.haptics.length
  let reverb_zones_count: U32 = collections.reverb_zones.length
  let synths_count: U32 = collections.synths.length
  let area_lights_count: U32 = collections.area_lights.length
  let pbr_decals_count: U32 = collections.pbr_decals.length
  let camera_targets_count: U32 = collections.camera_targets.length
  let video_streams_count: U32 = collections.video_streams.length
  total := self + state_count
  total := self + draws_count * 24
  for i in 0 .. solids_count:
    let source = collections.solids[i]
    let solid = project.solid context source
    let count: U32 = solid.faces.length
    total := self + 1 + count * 5
  total := self + decals_count * 18
  total := self + sounds_count * 7
  total := self + sprites_count * 17
  total := self + insets_count * 48
  for parent in 0 .. insets_count:
    let children = project.inset_draws context collections.insets[parent]
    total := self + children.length * 24
  total := self + preferences_count
  for i in 0 .. fields_count:
    let source = collections.fields[i]
    let field = project.field context source
    let count: U32 = field.values.length
    total := self + 7 + count
  for i in 0 .. ui_count:
    let source = collections.ui[i]
    let ui = project.ui context source
    let count: U32 = ui.text.length
    total := self + 24 + count
  for i in 0 .. services_count:
    let source = collections.services[i]
    let service = project.service context source
    let count: U32 = service.values.length
    total := self + 8 + count
  total := self + buses_count * 10
  total := self + voices_count * 12
  total := self + poses_count * 5
  total := self + emitters_count * 47
  total := self + lights_count * 14
  total := self + cascades_count * 18
  total := self + probes_count * 28
  total := self + reflection_probes_count * 21
  total := self + fog_volumes_count * 15
  total := self + listener_count * 12
  total := self + panners_count * 22
  total := self + instances_count * 26
  total := self + instance_removals_count * 2
  total := self + bone_matrices_count * 19
  total := self + morph_weights_count * 4
  total := self + motions_count * 17
  total := self + ribbons_count * 12
  total := self + haptics_count * 4
  total := self + reverb_zones_count * 12
  total := self + synths_count * 16
  total := self + area_lights_count * 19
  total := self + pbr_decals_count * 26
  total := self + camera_targets_count * 40
  total := self + video_streams_count * 5
  for i in 0 .. draws_count:
    let source = collections.draws[i]
    total := self + (project.extra_count context source) * 4
  for parent in 0 .. insets_count:
    let children = project.inset_draws context collections.insets[parent]
    let count: U32 = children.length
    for i in 0 .. count:
      let source = children.at i
      total := self + (project.extra_count context source) * 4
  return total

// Flat mesh draws (no parameters/extras) and sounds, into the packet it is given and returns.
type MeshDraw = { mesh: U32, material: U32, transform: types.Mat4 }
func encode_mesh_frame (packet: types.RenderHeader) -> (draws: &[MeshDraw]) -> (sounds: &[types.Sound]) -> (encoded: own #[F32]) =>
  @storage.truncate encoded 0
  for 0 .. (protocol.packet_header_floats + draws.length * 24 + sounds.length * 7):
    @storage.push encoded 0.0
  encoded[0] := protocol.packet_magic
  encoded[1] := U32.to_f32 packet.schema
  encoded[2] := 0.0
  encoded[3] := U32.to_f32 draws.length
  encoded[4] := 0.0
  encoded[5] := 0.0
  encoded[6] := 0.0
  encoded[7] := U32.to_f32 sounds.length
  encoded[8] := 0.0
  encoded[9] := 0.0
  encoded[10] := 0.0
  encoded[11] := 0.0
  encoded[12] := lanes.bit packet.save_requested
  encoded[13] := lanes.bit packet.load_requested
  encoded[14] := lanes.bit packet.scene_save_requested
  encoded[15] := lanes.bit packet.scene_load_requested
  encoded[16] := lanes.bit packet.checkpoint_requested
  encoded[17] := lanes.bit packet.undo_requested
  encoded[18] := lanes.bit packet.redo_requested
  encoded[19] := lanes.bit packet.exit_requested
  let $types.Mat4 { x: view_x, y: view_y, z: view_z, w: view_w } = packet.view
  encoded[20] := view_x.x
  encoded[21] := view_x.y
  encoded[22] := view_x.z
  encoded[23] := view_x.w
  encoded[24] := view_y.x
  encoded[25] := view_y.y
  encoded[26] := view_y.z
  encoded[27] := view_y.w
  encoded[28] := view_z.x
  encoded[29] := view_z.y
  encoded[30] := view_z.z
  encoded[31] := view_z.w
  encoded[32] := view_w.x
  encoded[33] := view_w.y
  encoded[34] := view_w.z
  encoded[35] := view_w.w
  let $types.Mat4 { x: projection_x, y: projection_y, z: projection_z, w: projection_w } = packet.projection
  encoded[36] := projection_x.x
  encoded[37] := projection_x.y
  encoded[38] := projection_x.z
  encoded[39] := projection_x.w
  encoded[40] := projection_y.x
  encoded[41] := projection_y.y
  encoded[42] := projection_y.z
  encoded[43] := projection_y.w
  encoded[44] := projection_z.x
  encoded[45] := projection_z.y
  encoded[46] := projection_z.z
  encoded[47] := projection_z.w
  encoded[48] := projection_w.x
  encoded[49] := projection_w.y
  encoded[50] := projection_w.z
  encoded[51] := projection_w.w
  encoded[52] := packet.clear.r
  encoded[53] := packet.clear.g
  encoded[54] := packet.clear.b
  encoded[55] := packet.clear.a
  encoded[56] := packet.ambient.x
  encoded[57] := packet.ambient.y
  encoded[58] := packet.ambient.z
  encoded[59] := packet.light_direction.x
  encoded[60] := packet.light_direction.y
  encoded[61] := packet.light_direction.z
  encoded[62] := packet.light_color.x
  encoded[63] := packet.light_color.y
  encoded[64] := packet.light_color.z
  encoded[65] := packet.aberration.x
  encoded[66] := packet.aberration.y
  encoded[67] := U32.to_f32 (packet.quality.msaa)
  encoded[68] := lanes.bit packet.quality.fxaa
  encoded[69] := packet.quality.scale
  encoded[70] := U32.to_f32 (packet.quality.filtering)
  encoded[71] := lanes.bit packet.quality.occlusion
  encoded[72] := lanes.bit packet.quality.sky
  encoded[73] := lanes.bit packet.quality.effects
  encoded[74] := packet.sky.zenith.x
  encoded[75] := packet.sky.zenith.y
  encoded[76] := packet.sky.zenith.z
  encoded[77] := packet.sky.horizon.x
  encoded[78] := packet.sky.horizon.y
  encoded[79] := packet.sky.horizon.z
  encoded[80] := packet.sky.ground.x
  encoded[81] := packet.sky.ground.y
  encoded[82] := packet.sky.ground.z
  encoded[83] := packet.sky.sun.x
  encoded[84] := packet.sky.sun.y
  encoded[85] := packet.sky.sun.z
  encoded[86] := packet.sky.night
  encoded[87] := packet.sky.tint.x
  encoded[88] := packet.sky.tint.y
  encoded[89] := packet.sky.tint.z
  encoded[90] := packet.sky.sh0.x
  encoded[91] := packet.sky.sh0.y
  encoded[92] := packet.sky.sh0.z
  encoded[93] := packet.sky.sh1.x
  encoded[94] := packet.sky.sh1.y
  encoded[95] := packet.sky.sh1.z
  encoded[96] := packet.sky.sh2.x
  encoded[97] := packet.sky.sh2.y
  encoded[98] := packet.sky.sh2.z
  encoded[99] := packet.sky.sh3.x
  encoded[100] := packet.sky.sh3.y
  encoded[101] := packet.sky.sh3.z
  encoded[102] := packet.sky.sh4.x
  encoded[103] := packet.sky.sh4.y
  encoded[104] := packet.sky.sh4.z
  encoded[105] := packet.sky.sh5.x
  encoded[106] := packet.sky.sh5.y
  encoded[107] := packet.sky.sh5.z
  encoded[108] := packet.sky.sh6.x
  encoded[109] := packet.sky.sh6.y
  encoded[110] := packet.sky.sh6.z
  encoded[111] := packet.sky.sh7.x
  encoded[112] := packet.sky.sh7.y
  encoded[113] := packet.sky.sh7.z
  encoded[114] := packet.sky.sh8.x
  encoded[115] := packet.sky.sh8.y
  encoded[116] := packet.sky.sh8.z
  encoded[117] := U32.to_f32 (packet.probe_volume.revision)
  encoded[118] := U32.to_f32 (packet.probe_volume.nx)
  encoded[119] := U32.to_f32 (packet.probe_volume.ny)
  encoded[120] := U32.to_f32 (packet.probe_volume.nz)
  encoded[121] := packet.probe_volume.spacing
  encoded[122] := packet.probe_volume.origin.x
  encoded[123] := packet.probe_volume.origin.y
  encoded[124] := packet.probe_volume.origin.z
  encoded[125] := packet.fog.radius
  encoded[126] := packet.fog.density
  encoded[127] := packet.fog.height
  let $types.Mat4 { x: shadow_view_x, y: shadow_view_y, z: shadow_view_z, w: shadow_view_w } = packet.shadow.view
  encoded[128] := shadow_view_x.x
  encoded[129] := shadow_view_x.y
  encoded[130] := shadow_view_x.z
  encoded[131] := shadow_view_x.w
  encoded[132] := shadow_view_y.x
  encoded[133] := shadow_view_y.y
  encoded[134] := shadow_view_y.z
  encoded[135] := shadow_view_y.w
  encoded[136] := shadow_view_z.x
  encoded[137] := shadow_view_z.y
  encoded[138] := shadow_view_z.z
  encoded[139] := shadow_view_z.w
  encoded[140] := shadow_view_w.x
  encoded[141] := shadow_view_w.y
  encoded[142] := shadow_view_w.z
  encoded[143] := shadow_view_w.w
  encoded[144] := U32.to_f32 (packet.shadow.texels)
  encoded[145] := U32.to_f32 (packet.shadow.filter)
  encoded[146] := packet.shadow.softness
  encoded[147] := U32.to_f32 (packet.shadow.contact)
  encoded[148] := packet.shadow.contact_length
  encoded[149] := U32.to_f32 (packet.shadow.local)
  encoded[150] := U32.to_f32 (packet.shadow.local_texels)
  encoded[151] := packet.blur
  encoded[152] := lanes.bit packet.quality.bloom
  encoded[153] := packet.clouds.cover
  encoded[154] := packet.clouds.drift.x
  encoded[155] := packet.clouds.drift.z
  encoded[156] := lanes.bit packet.hide_cursor
  encoded[157] := 0.0
  encoded[158] := 0.0
  encoded[159] := 0.0
  encoded[160] := 0.0
  encoded[161] := 0.0
  encoded[162] := 0.0
  encoded[163] := 0.0
  encoded[164] := 0.0
  encoded[165] := 0.0
  encoded[166] := 0.0
  encoded[167] := lanes.bit packet.quality.taa
  encoded[168] := 0.0
  encoded[169] := 0.0
  encoded[170] := 0.0
  encoded[171] := 0.0
  encoded[172] := 0.0
  encoded[173] := 0.0
  encoded[174] := lanes.bit packet.loading
  encoded[175] := lanes.bit packet.show_captions
  encoded[176] := lanes.bit packet.retained_enabled
  encoded[177] := lanes.bit packet.retained_reset
  encoded[178] := U32.to_f32 (packet.retained_after)
  encoded[179] := 0.0
  encoded[180] := 0.0
  encoded[181] := lanes.bit packet.exposure.auto
  encoded[182] := packet.exposure.compensation
  encoded[183] := packet.exposure.min
  encoded[184] := packet.exposure.max
  encoded[185] := packet.exposure.brighten
  encoded[186] := packet.exposure.darken
  encoded[187] := packet.exposure.low
  encoded[188] := packet.exposure.high
  encoded[189] := packet.exposure.centre
  encoded[190] := packet.exposure.range_low
  encoded[191] := packet.exposure.range_high
  encoded[192] := packet.exposure.target
  encoded[193] := packet.exposure.dt
  encoded[194] := lanes.bit packet.exposure.cut
  encoded[195] := packet.grade.temperature
  encoded[196] := packet.grade.tint
  encoded[197] := packet.grade.exposure
  encoded[198] := packet.grade.contrast
  encoded[199] := packet.grade.pivot
  encoded[200] := packet.grade.saturation
  encoded[201] := packet.grade.vibrance
  encoded[202] := packet.grade.lift.x
  encoded[203] := packet.grade.lift.y
  encoded[204] := packet.grade.lift.z
  encoded[205] := packet.grade.gamma.x
  encoded[206] := packet.grade.gamma.y
  encoded[207] := packet.grade.gamma.z
  encoded[208] := packet.grade.gain.x
  encoded[209] := packet.grade.gain.y
  encoded[210] := packet.grade.gain.z
  encoded[211] := U32.to_f32 (packet.grade.lut_a)
  encoded[212] := U32.to_f32 (packet.grade.lut_b)
  encoded[213] := packet.grade.lut_blend
  encoded[214] := packet.grade.lut_weight
  encoded[215] := packet.grade.vignette
  encoded[216] := packet.grade.vignette_radius
  encoded[217] := U32.to_f32 (packet.quality.ssr)
  encoded[218] := U32.to_f32 (packet.reflection.budget)
  encoded[219] := packet.fog.edge
  encoded[220] := packet.fog.distance
  encoded[221] := packet.fog.albedo.x
  encoded[222] := packet.fog.albedo.y
  encoded[223] := packet.fog.albedo.z
  encoded[224] := packet.fog.anisotropy
  encoded[225] := packet.fog.sun
  encoded[226] := packet.fog.ambient
  encoded[227] := packet.fog.sky
  encoded[228] := packet.fog.noise
  encoded[229] := packet.fog.noise_scale
  encoded[230] := packet.fog.drift.x
  encoded[231] := packet.fog.drift.y
  encoded[232] := packet.fog.drift.z
  encoded[233] := U32.to_f32 (packet.quality.volumetrics)
  encoded[234] := 0.0
  encoded[235] := 0.0
  encoded[236] := 0.0
  encoded[237] := packet.motion_blur.strength
  encoded[238] := packet.motion_blur.max_radius
  encoded[239] := U32.to_f32 (packet.motion_blur.samples)
  encoded[240] := packet.dof.focus_distance
  encoded[241] := packet.dof.focus_range
  encoded[242] := packet.dof.aperture
  encoded[243] := packet.dof.max_blur
  encoded[244] := 0.0
  encoded[245] := lanes.bit packet.quality.ssgi
  encoded[246] := 0.0
  encoded[247] := packet.reverb.decay
  encoded[248] := packet.reverb.damping
  encoded[249] := 0.0
  encoded[250] := 0.0
  encoded[251] := 0.0
  encoded[252] := U32.to_f32 (packet.grade.tonemap)
  encoded[253] := packet.grade.sharpness
  encoded[254] := packet.grade.grain
  encoded[255] := packet.grade.flare
  encoded[256] := packet.grade.outline_strength
  encoded[257] := lanes.bit packet.quality.oit
  encoded[258] := lanes.bit packet.quality.physical_sky
  encoded[259] := lanes.bit packet.quality.upscale
  encoded[260] := U32.to_f32 (packet.quality.ray_tracing)
  encoded[261] := lanes.bit packet.quality.ddgi
  encoded[262] := 0.0
  encoded[263] := 0.0
  encoded[264] := 0.0
  encoded[265] := 0.0
  let at: U32 = protocol.packet_header_floats
  for draw in draws:
    encoded[at + 0] := U32.to_f32 (draw.mesh)
    encoded[at + 1] := U32.to_f32 (draw.material)
    let $types.Mat4 { x: transform_x, y: transform_y, z: transform_z, w: transform_w } = draw.transform
    encoded[at + 2] := transform_x.x
    encoded[at + 3] := transform_x.y
    encoded[at + 4] := transform_x.z
    encoded[at + 5] := transform_x.w
    encoded[at + 6] := transform_y.x
    encoded[at + 7] := transform_y.y
    encoded[at + 8] := transform_y.z
    encoded[at + 9] := transform_y.w
    encoded[at + 10] := transform_z.x
    encoded[at + 11] := transform_z.y
    encoded[at + 12] := transform_z.z
    encoded[at + 13] := transform_z.w
    encoded[at + 14] := transform_w.x
    encoded[at + 15] := transform_w.y
    encoded[at + 16] := transform_w.z
    encoded[at + 17] := transform_w.w
    at := self + 24
  for sound in sounds:
    encoded[at + 0] := U32.to_f32 (sound.clip)
    encoded[at + 1] := U32.to_f32 (sound.bus)
    encoded[at + 2] := sound.gain
    encoded[at + 3] := sound.pan
    encoded[at + 4] := sound.pitch
    encoded[at + 5] := sound.lowpass
    encoded[at + 6] := sound.reverb
    at := self + 7
  return encoded
