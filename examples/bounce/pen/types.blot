// Generated by pen codegen from pen/protocol/schema.json:
// edit the schema and run `pen codegen`, not this file.
// Wire records. Mat4 stores four columns; vectors follow schema lane order.
type Vec4 is data = #Vec4 { x: F32, y: F32, z: F32, w: F32 }
type Mat4 is data = #Mat4 { x: Vec4, y: Vec4, z: Vec4, w: Vec4 }
const zero4 = #Vec4 { x: 0.0, y: 0.0, z: 0.0, w: 0.0 }

type Vector is data = #Vector {
  x: F32,
  y: F32,
  z: F32,
}

type Color is data = #Color {
  r: F32,
  g: F32,
  b: F32,
  a: F32,
}

type Aberration is data = #Aberration {
  x: F32,
  y: F32,
}

type Drift is data = #Drift {
  x: F32,
  z: F32,
}

type Draw is data = #Draw {
  mesh: U32,
  material: U32,
  transform: Mat4,
  parameters: Maybe Vec4,
  extra: Array Vec4,
}

type SolidFace is data = #SolidFace {
  normal: Vector,
  distance: F32,
  material: U32,
}

type Decal is data = #Decal {
  material: U32,
  transform: Mat4,
  opacity: F32,
}

type Sound is data = #Sound {
  clip: U32,
  bus: U32,
  gain: F32,
  pan: F32,
  pitch: F32,
  lowpass: F32,
  reverb: F32,
}

type Sprite is data = #Sprite {
  x: F32,
  y: F32,
  width: F32,
  height: F32,
  u0: F32,
  v0: F32,
  u1: F32,
  v1: F32,
  color: Vec4,
  material: U32,
  parameters: Vec4,
}

type Inset is data = #Inset {
  x: F32,
  y: F32,
  width: F32,
  height: F32,
  view: Mat4,
  projection: Mat4,
  ambient: Vector,
  light_direction: Vector,
  light_color: Vector,
  draws: Array Draw,
  pixel_size: F32,
  after_sprites: U32,
}

type Bus is data = #Bus {
  gain: F32,
  lowpass: F32,
  reverb: F32,
}

type Voice is data = #Voice {
  id: U32,
  clip: U32,
  bus: U32,
  gain: F32,
  pan: F32,
  pitch: F32,
  lowpass: F32,
  reverb: F32,
  looping: Bool,
  start: F32,
  fade_in: F32,
  fade_out: F32,
}

type Pose is data = #Pose {
  draw: U32,
  clip: U32,
  time: F32,
  weight: F32,
}

type Emitter is data = #Emitter {
  material: U32,
  transform: Mat4,
  seed: U32,
  time: F32,
  duration: F32,
  rate: F32,
  lifetime: F32,
  radius: F32,
  velocity: Vector,
  spread: F32,
  gravity: Vector,
  drag: F32,
  size_start: F32,
  size_end: F32,
  color_start: Color,
  color_end: Color,
  additive: Bool,
}

type Light is data = #Light {
  position: Vector,
  radius: F32,
  color: Vector,
  direction: Vector,
  inner: F32,
  outer: F32,
}

type Listener is data = #Listener {
  position: Vector,
  forward: Vector,
  up: Vector,
}

type Panner is data = #Panner {
  voice: U32,
  sound: U32,
  position: Vector,
  orientation: Vector,
  distance_model: U32,
  ref_distance: F32,
  max_distance: F32,
  rolloff: F32,
  cone_inner: F32,
  cone_outer: F32,
  cone_outer_gain: F32,
}

type Solid is data = #Solid {
  faces: Array SolidFace,
}

type FieldPatch is data = #FieldPatch {
  material: U32,
  width: U32,
  height: U32,
  x: U32,
  z: U32,
  columns: U32,
  rows: U32,
  values: Array F32,
}

type UiNode is data = #UiNode {
  id: U32,
  parent: U32,
  role: U32,
  x: F32,
  y: F32,
  width: F32,
  height: F32,
  focusable: Bool,
  focused: Bool,
  disabled: Bool,
  hidden: Bool,
  modal: Bool,
  checked: U32,
  expanded: U32,
  selected: U32,
  live: U32,
  value: F32,
  minimum: F32,
  maximum: F32,
  step: F32,
  actions: U32,
  text_length: U32,
  name_length: U32,
  description_length: U32,
  text: Array F32,
}

type ServiceRequest is data = #ServiceRequest {
  request: U32,
  service: U32,
  operation: U32,
  a: F32,
  b: F32,
  c: F32,
  d: F32,
  value_count: U32,
  values: Array F32,
}

type Quality is data = #Quality {
  msaa: U32,
  fxaa: Bool,
  scale: F32,
  filtering: U32,
  occlusion: Bool,
  sky: Bool,
  effects: Bool,
  bloom: Bool,
  taa: Bool,
}

type Sky is data = #Sky {
  zenith: Vector,
  horizon: Vector,
  ground: Vector,
  sun: Vector,
  night: F32,
}

type Fog is data = #Fog {
  radius: F32,
  density: F32,
  height: F32,
}

type Shadow is data = #Shadow {
  view: Mat4,
  projection: Mat4,
  texel: F32,
  texels: U32,
}

type Clouds is data = #Clouds {
  cover: F32,
  drift: Drift,
}

type RenderFrame is data = #RenderFrame {
  schema: U32,
  save_requested: Bool,
  load_requested: Bool,
  scene_save_requested: Bool,
  scene_load_requested: Bool,
  checkpoint_requested: Bool,
  undo_requested: Bool,
  redo_requested: Bool,
  exit_requested: Bool,
  view: Mat4,
  projection: Mat4,
  clear: Color,
  ambient: Vector,
  light_direction: Vector,
  light_color: Vector,
  aberration: Aberration,
  quality: Quality,
  sky: Sky,
  fog: Fog,
  shadow: Shadow,
  blur: F32,
  clouds: Clouds,
  hide_cursor: Bool,
  loading: Bool,
  show_captions: Bool,
  state: Array F32,
  draws: Array Draw,
  solids: Array Solid,
  decals: Array Decal,
  sounds: Array Sound,
  sprites: Array Sprite,
  insets: Array Inset,
  preferences: Array F32,
  fields: Array FieldPatch,
  ui: Array UiNode,
  services: Array ServiceRequest,
  buses: Array Bus,
  voices: Array Voice,
  poses: Array Pose,
  emitters: Array Emitter,
  lights: Array Light,
  listener: Array Listener,
  panners: Array Panner,
}

// One of the game's own sections (its pen.json `protocol`): its tag and lanes.
// They travel after the render packet, which RenderFrame leaves them out of:
// protocol_render's encode_extensions lays them out.
type Extension is data = #Extension { tag: U32, values: Array F32 }
