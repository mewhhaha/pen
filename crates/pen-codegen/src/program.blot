import * as lanes from "./lanes"
import * as protocol from "./protocol"

// Version 2: request[0] acknowledges renderer publication only. Simulation
// mutations already happened and are never rolled back or silently repeated.
const magic: F32 = ${MAGIC}.0
const version: F32 = ${VERSION}.0
const stop: U32 = 0
const create: U32 = 1
const frame: U32 = 2
const snapshot: U32 = 3
const restore: U32 = 4
const scene: U32 = 5
const load_scene: U32 = 6
const append = func values -> (destination: ResizeArray F32) => return do:
  let count = values.length
  for i in 0 .. count:
    @storage.push destination values[i]
const valid_state = func values => return do:
  if values.length > protocol.max_state_floats:
    return false
  for value in values:
    if Bool.not (is_finite value):
      return false
  return true
// Caller owns both named packet buffers for the entire invocation. Foreign
// returns a copied temporary which is consumed within the iteration; only the
// buffers and scalar initialized flag survive the backedge, never a new owner.
// execute access operation payload outgoing writes response lanes AFTER the
// echoed operation. acknowledge access published repairs presentation caches.
const run = func execute -> acknowledge -> access -> (schema: U32) -> (scenes: Bool) -> (incoming: ResizeArray F32) -> (outgoing: ResizeArray F32) -> (host: Array F32 -> Array F32 ! { Foreign }) : Unit ! { Foreign } => return do:
  @storage.truncate incoming 0
  @storage.truncate outgoing 0
  append #[magic, version, U32.to_f32 schema, lanes.bit scenes] outgoing
  let initialized = false
  for ever:
    use following <- host (@storage.freeze (@storage.copy outgoing))
    lanes.require (following.length >= 2)
    let published = lanes.integer following[0] 1 == 1
    acknowledge access published
    @storage.truncate incoming 0
    append following incoming
    let operation = lanes.integer incoming[1] 6
    if operation == stop:
      return ()
    lanes.require (initialized or operation == create or operation == restore)
    lanes.require (scenes or (operation != scene and operation != load_scene))
    @storage.truncate outgoing 0
    @storage.push outgoing (U32.to_f32 operation)
    execute access operation (&incoming[2..incoming.length]) outgoing
    if operation == create or operation == restore:
      initialized := true
    // Invalid non-render output poisons this invocation; no partial mutation is
    // presented as a rolled-back world. Recover in a fresh guest from a snapshot.
    if operation != frame:
      lanes.require (valid_state outgoing)

// game is a compile-known policy, not a stored runtime callback object. Each
// operation mutates independently named pools through access and appends only
// its response lanes to outgoing. Snapshots and restores remain explicit.
const execute = func game -> access -> operation -> payload -> outgoing => return do:
  case operation of
    1 => game.create access outgoing
    2 => game.frame access payload outgoing
    3 => game.save access outgoing
    4 => game.restore access payload outgoing
    5 => game.scene access outgoing
    6 => game.load_scene access payload outgoing
    _ => @panic "invalid game operation"
const serve = func game -> access -> incoming -> outgoing -> host => return
  run (execute game) game.acknowledge access game.schema game.scenes incoming outgoing host
