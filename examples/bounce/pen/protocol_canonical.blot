// edit the schema and run `pen codegen`, not this file.
//
// The packets' canonical walks (pen-codegen's canonical.rs), which pen's tests
// compare with Rust's. Only tests import this; the game must not.
import * as array from "std/array"
import * as lanes from "./lanes"
