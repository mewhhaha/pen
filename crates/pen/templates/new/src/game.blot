// A cube that turns: the right arrow turns it faster, the left one slower.
// pen/ holds the bindings `pen codegen` generates: the packets (protocol,
// types), the program loop (program) and a frame to start from (frame).
import * as frame from "pen/frame"
import * as protocol from "pen/protocol"
import * as types from "pen/types"
import * as program from "pen/program"
import * as codec from "pen/protocol_render"
import { meshes, materials } from "./assets/catalog.json"

// The version of the state `save` makes. Change it when the state's lanes
// change: pen then starts afresh rather than restore a state it would misread.
const schema = 1

// Everything a frame depends on besides its input.
type World is data = $World { angle: F32, speed: F32 }

const create = func () => return $World { angle: 0.0, speed: 1.0 }

// The world as lanes, for quicksaves, time travel and reloads, and back.
const save = func (world: World) => return #[world.angle, world.speed]
const restore = func state => return $World { angle: (state.at 0), speed: (state.at 1) }

// Radians a second each arrow press adds or takes away.
const nudge = 0.5

const vec4 = func x => return func y => return func z => return func w => return $types.Vec4 { x, y, z, w }

// Column-major, as the packet carries matrices.
const turned = func (angle: F32) => return do:
  let c = F32.cos angle
  let s = F32.sin angle
  return $types.Mat4 { x: vec4 c 0.0 (0.0 - s) 0.0, y: vec4 0.0 1.0 0.0 0.0, z: vec4 s 0.0 c 0.0, w: vec4 0.0 0.0 0.0 1.0 }

const moved = func (x: F32) => return func (y: F32) => return func (z: F32) => return
  $types.Mat4 { x: vec4 1.0 0.0 0.0 0.0, y: vec4 0.0 1.0 0.0 0.0, z: vec4 0.0 0.0 1.0 0.0, w: vec4 x y z 1.0 }

// A perspective seeing `focal` (1 over the tangent of half the vertical field
// of view) at `aspect`, into WebGPU's depth of 0 to 1.
const perspective = func (focal: F32) => return func (aspect: F32) => return do:
  let near = 0.1
  let far = 100.0
  return $types.Mat4 {
    x: vec4 (focal / aspect) 0.0 0.0 0.0,
    y: vec4 0.0 focal 0.0 0.0,
    z: vec4 0.0 0.0 (0.0 - far / (far - near)) (-1.0),
    w: vec4 0.0 0.0 (0.0 - near * far / (far - near)) 0.0,
  }

// What the world looks like: the cube, five units in front of the eye.
const view = func (world: World) -> (input: protocol.Input) -> (draws: ResizeArray codec.MeshDraw) => return do:
  @storage.truncate draws 0
  let drawn = frame.header schema
  drawn.view := moved 0.0 0.0 (-5.0)
  drawn.projection := perspective 2.0 (input.width / input.height)
  drawn.clear := $types.Color { r: 0.08, g: 0.1, b: 0.14, a: 1.0 }
  drawn.light_direction := $types.Vector { x: -0.4, y: -1.0, z: -0.6 }
  @storage.push draws { mesh: meshes.cube, material: materials.cube, transform: turned world.angle }
  return drawn

// One frame: the arrows pressed change the speed, and the cube turns on.
const step = func (world: World) => return func (input: protocol.Input) => return do:
  let speed = world.speed
  for event in input.events:
    if let $protocol.KeyDown code = event:
      if code == protocol.key_arrow_right:
        speed := self + nudge
      if code == protocol.key_arrow_left:
        speed := self - nudge
  let next = $World { angle: world.angle + speed * input.elapsed, speed }
  return next

// Compile-known callbacks operate on one named world pool. Presentation rejection
// needs no cache repair here; it never rolls simulation back.
const acknowledge = func access -> published => return ()
const execute = func access -> operation -> payload -> outgoing => return do:
  let world = access.world
  let events = access.events
  let draws = access.draws
  let sounds: ResizeArray types.Sound = access.sounds
  let rendered: ResizeArray F32 = access.rendered
  case operation of
    1 => do:
      world[0] := create ()
      program.append (save world[0]) outgoing
    2 => do:
      let input = protocol.decode_input_into payload events
      let next = step world[0] input
      world[0] := next
      let header = view next input draws
      codec.encode_mesh_frame header (&draws[0..draws.length]) (&sounds[0..sounds.length]) rendered
      program.append rendered outgoing
    3 => program.append (save world[0]) outgoing
    4 => do:
      world[0] := restore payload
      program.append (save world[0]) outgoing
    _ => @panic "scenes are not supported"

const run = func host => return do:
  let world: Array World = #[create ()]
  let events: ResizeArray protocol.Event = #[]
  let draws: ResizeArray codec.MeshDraw = #[]
  let sounds: ResizeArray types.Sound = #[]
  let rendered: ResizeArray F32 = #[]
  let incoming: ResizeArray F32 = #[]
  let outgoing: ResizeArray F32 = #[]
  let access = {world, events, draws, sounds, rendered}
  use program.run execute acknowledge access schema false incoming outgoing host
  return ()

const game = { schema, create, step, save, restore }
