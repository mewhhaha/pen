const gamepad_button_right_stick = 11
const gamepad_button_dpad_up = 12
const gamepad_button_dpad_down = 13
const gamepad_button_dpad_left = 14
const gamepad_button_dpad_right = 15
const gamepad_button_home = 16

// A gamepad's stick axes, in the order of the browser's standard gamepad: from
// -1 to 1, right and down positive.
const gamepad_axis_left_x = 0
const gamepad_axis_left_y = 1
const gamepad_axis_right_x = 2
const gamepad_axis_right_y = 3

// What moved an action (the Action event's device): the keyboard or mouse, a
// gamepad, Steam Input, or a touch screen. A game shows the prompts of the
// device the player used last.
const input_device_keyboard = 0
const input_device_gamepad = 1
const input_device_steam = 2
const input_device_touch = 3

// What a binding reads: a key (its code, as KeyDown events carry it), a mouse
// button (numbered as PointerDown events number them), a gamepad button
// (GAMEPAD_BUTTON_*) or a gamepad axis (GAMEPAD_AXIS_*). A binding is three
// numbers: its source, its code and its scale, which multiplies what it reads (a
// key or button reads 1 held, an axis -1 to 1), so -1 makes a key push an axis
// action the other way and an axis bound with -1 reads its other half.
const input_source_key = 0
const input_source_mouse = 1
const input_source_pad_button = 2
const input_source_pad_axis = 3

// The input service's operations, on action `a` (0 to MAX_ACTIONS - 1). declare
// declares it: `b` is 0 for a button (its value 1 while a binding holds it at
// half or more, else 0) or 1 for an axis (its value the bindings' sum, from -1
// to 1), its values its name's `c` code points and then its default bindings,
// three numbers each (INPUT_SOURCE_*); it answers how many bindings it has, the
// player's if they rebound it. capture binds slot `b` to the next key, mouse
// button, gamepad button or stick the player presses (Escape gives up, answered
// failed), answering the binding as its values when it comes; cancel gives a
// capture up. bind sets slot `b` to the binding in the values, unbind removes
// slot `b`, reset gives the action its defaults back (every action's when `a` is
// MAX_ACTIONS), and bindings answers its bindings. The host keeps the player's
// bindings with their preferences.
const input_op_declare = 0
const input_op_capture = 1
const input_op_cancel = 2
const input_op_bind = 3
const input_op_unbind = 4
const input_op_reset = 5
const input_op_bindings = 6

// Where a touch is (the Touch event's phase): put down, moved, lifted, or taken
// away by the system (a gesture it claimed, the window losing the focus).
const touch_phase_start = 0
const touch_phase_move = 1
const touch_phase_end = 2
const touch_phase_cancel = 3

// Where each number sits in a devtools packets answer's frame: its position; its
// input's events and lanes; its render packet's lanes; its settings (camera,
// light, sky, quality and the rest, one element whose fields a diff counts); its
// draws, solids, decals, sounds, sprites, insets, field patches, interface
// nodes, service requests, buses and voices; and its requests to save, load,
// save and load the scene, checkpoint, undo, redo and exit, a bit each from 1
// up.
const devtools_packet_position = 0
const devtools_packet_events = 1
const devtools_packet_input = 2
const devtools_packet_packet = 3
const devtools_packet_settings = 4
const devtools_packet_draws = 5
const devtools_packet_solids = 6
const devtools_packet_decals = 7
const devtools_packet_sounds = 8
const devtools_packet_sprites = 9
const devtools_packet_insets = 10
const devtools_packet_fields = 11
const devtools_packet_ui = 12
const devtools_packet_services = 13
const devtools_packet_buses = 14
const devtools_packet_voices = 15
const devtools_packet_requests = 16

// How a devtools watch compares a lane of the game's state with its value: equal
// to it, not equal, below it, above it, or (the value ignored) changed from what
// the lane held when the watch started.
const devtools_compare_equal = 0
const devtools_compare_unequal = 1
const devtools_compare_below = 2
const devtools_compare_above = 3
const devtools_compare_changes = 4

// The kinds of the game's catalog a devtools assets, preview or swap request
// names.
const devtools_asset_mesh = 0
const devtools_asset_material = 1
const devtools_asset_sound = 2

// Where a catalog asset stands in the host: not asked for yet, loading, ready to
// use, or failed to load (its last good revision, if any, still used).
const devtools_asset_state_unused = 0
const devtools_asset_state_loading = 1
const devtools_asset_state_ready = 2
const devtools_asset_state_failed = 3

// The engine's own preferences, the same for every game: the player sets them
// through the host (its options, the platform's settings) or a game's settings
// (the preferences service), and the host keeps them. color_filter is a
// COLOR_FILTER_* the renderer applies to the whole picture, filter_strength how
// much of it (0 to 1), text_scale how much larger the game draws its text (1 to
// 2) and reduced_motion 1 when the player wants as little motion as can be
// (camera flights, shakes, slides and flashes left out). They reach the game as
// Preference events at index ENGINE_PREFERENCES plus the preference, played back
// as the game's own are.
const engine_preference_color_filter = 0
const engine_preference_filter_strength = 1
const engine_preference_text_scale = 2
const engine_preference_reduced_motion = 3

// A colour filter for colour vision deficiency: none, or the colours shifted so
// that those a player without red (protanopia), green (deuteranopia) or blue
// (tritanopia) cones confuses tell apart again; achromatopsia shows the picture
// in greys of its luminance.
const color_filter_none = 0
const color_filter_protanopia = 1
const color_filter_deuteranopia = 2
const color_filter_tritanopia = 3
const color_filter_achromatopsia = 4

// The engine's preferences (ENGINE_PREFERENCE_*): set stores preference `a` as
// `b`, which the host applies at once and plays back to the game from then on,
// and answers the value it kept (clamped to the preference's range), or failed
// for a preference or value it does not take.
const preferences_op_set = 0

// The player's language, from the game's string tables (its text.json, and
// locales/TAG.json for each language). text answers the string whose key is the
// request's text in the player's language, laid out to draw left to right
// (right-to-left scripts reordered and Arabic joined), with `a` as its count
// when `b` is 1 (choosing the plural form and filling {count}); value 1 when it
// reads right to left, unavailable when no table has the key; where the text
// drawn differs from the text read (right to left), its values are the text
// drawn, a 0, then the text in reading order, unshaped, for assistive
// technology. language answers the language in use as a BCP 47 tag, value 1 for
// a right-to-left one. plural answers the plural category (PLURAL_CATEGORY_*) of
// count `a` in it as its value.
const locale_op_text = 0
const locale_op_language = 1
const locale_op_plural = 2

// The plural categories of Unicode's CLDR, which choose a string's form for a
// count.
const plural_category_zero = 0
const plural_category_one = 1
const plural_category_two = 2
const plural_category_few = 3
const plural_category_many = 4
const plural_category_other = 5

// What an accessibility audit found: a node assistive technology cannot name (a
// control or an image without a name), a focus problem (a trap: a modal dialog
// with nothing to focus, or the keyboard unable to leave; a focus on a node the
// tree leaves out; two focused nodes), text whose contrast with what lies behind
// it is below WCAG's 4.5:1 (3:1 for large text), or a control smaller than 24 by
// 24 pixels.
const audit_finding_unnamed = 0
const audit_finding_focus = 1
const audit_finding_contrast = 2
const audit_finding_size = 3

// The captions the game's sounds carry (the assets' captions.json, by sound):
// text answers the caption of clip `a` as text, its value the seconds it shows
// for, or unavailable when the clip has none; active answers the captions
// showing now, newest first, one a line, its value how many.
const captions_op_text = 0
const captions_op_active = 1

// Where each number sits at the start of a devtools audio answer: the output's
// latency in milliseconds, from a frame's sound reaching the mixer to it leaving
// the speakers (-1 when the host cannot tell); the sample rate; the device's
// buffer, in samples a callback, as asked for or as the system chose (-1 while
// unknown); the voices and sounds playing, and those of them streamed; how often
// a stream ran dry so far; and how many buses follow.
const devtools_audio_latency = 0
const devtools_audio_rate = 1
const devtools_audio_buffer = 2
const devtools_audio_voices = 3
const devtools_audio_streams = 4
const devtools_audio_underruns = 5
const devtools_audio_buses = 6

// Each bus's numbers in a devtools audio answer: its output's peak and RMS on
// the left and right since the last answer, and its state: 1 when a frame uses
// it, plus 2 when muted, plus 4 when soloed.
const devtools_bus_peak_left = 0
const devtools_bus_peak_right = 1
const devtools_bus_rms_left = 2
const devtools_bus_rms_right = 3
const devtools_bus_state = 4

// How a panner's gain falls with distance, as WebAudio's PannerNode
// distanceModel: linear from 1 at ref_distance to 1 - rolloff at max_distance;
// inverse, ref_distance / (ref_distance + rolloff * (distance - ref_distance));
// exponential, (distance / ref_distance) ^ -rolloff; nearer than ref_distance is
// 1.
const distance_model_linear = 0
const distance_model_inverse = 1
const distance_model_exponential = 2

// Crash and performance reports for the game's developer, which the player opts
// into: consent answers what the player agreed to as its value, 1 for crash
// reports plus 2 for performance reports (0 for neither, as before they are
// asked); set_consent sets it to `a`, the same sum; queued answers how many
// reports wait to be sent. Each answers unavailable where nothing could be sent
// (a package whose developer gave no address for reports, a checkout, the
// browser), so that the game offers no choice with nothing behind it.
const reports_op_consent = 0
const reports_op_set_consent = 1
const reports_op_queued = 2

