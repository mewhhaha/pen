  at := stream.at
  stream.output[8] := U32.to_f32 sprites_count
  let insets_start: U32 = stream.output.length
  let insets_count = lanes.integer canonical[at] lanes.max_integer
  at := at + 1
  stream.at := at
  for 0 .. insets_count:
    stream := inset_into canonical stream
  at := stream.at
  stream.output[9] := U32.to_f32 insets_count
  let inset_draws_start: U32 = stream.output.length
  let inset_draws_count: U32 = stream.children.length / 24
  for value in stream.children:
    @storage.push stream.output value
  stream.output[10] := U32.to_f32 inset_draws_count
  let preferences_start: U32 = stream.output.length
  let preferences_count: U32 = 0
  let present = lanes.integer canonical[at] 1
  at := at + 1
  if present == 1:
    preferences_count := lanes.integer canonical[at] lanes.max_integer
    at := at + 1
    for index in 0 .. preferences_count:
      @storage.push stream.output canonical[at + index]
    at := at + preferences_count
  stream.output[11] := U32.to_f32 (stream.output.length - preferences_start)
  let fields_start: U32 = stream.output.length
  let fields_count = lanes.integer canonical[at] lanes.max_integer
  at := at + 1
  stream.at := at
  for 0 .. fields_count:
    stream := field_into canonical stream
  at := stream.at
  stream.output[160] := U32.to_f32 fields_count
  stream.output[161] := U32.to_f32 (stream.output.length - fields_start)
  let ui_start: U32 = stream.output.length
  let ui_count = lanes.integer canonical[at] lanes.max_integer
  at := at + 1
  stream.at := at
  for 0 .. ui_count:
    stream := ui_into canonical stream
  at := stream.at
  stream.output[162] := U32.to_f32 ui_count
  stream.output[163] := U32.to_f32 (stream.output.length - ui_start)
  let services_start: U32 = stream.output.length
  let services_count = lanes.integer canonical[at] lanes.max_integer
  at := at + 1
  stream.at := at
  for 0 .. services_count:
    stream := service_into canonical stream
  at := stream.at
  stream.output[164] := U32.to_f32 services_count
  stream.output[165] := U32.to_f32 (stream.output.length - services_start)
  let buses_start: U32 = stream.output.length
  let buses_count = lanes.integer canonical[at] lanes.max_integer
  at := at + 1
  stream.at := at
  for 0 .. buses_count:
    stream := buse_into canonical stream
  at := stream.at
  stream.output[166] := U32.to_f32 buses_count
  let voices_start: U32 = stream.output.length
  let voices_count = lanes.integer canonical[at] lanes.max_integer
  at := at + 1
  stream.at := at
  for 0 .. voices_count:
    stream := voice_into canonical stream
  at := stream.at
  stream.output[167] := U32.to_f32 voices_count
  let poses_start: U32 = stream.output.length
