  at := at + 4
  stream.output[base + 37] := canonical[at + 0]
  stream.output[base + 38] := canonical[at + 1]
  stream.output[base + 39] := canonical[at + 2]
  stream.output[base + 40] := canonical[at + 3]
  at := at + 4
  stream.output[base + 41] := canonical[at + 0]
  at := at + 1
  stream.at := at
  return stream

func light_into (canonical: #[F32]) -> (stream: own Stream): Stream =>
  let at = stream.at
  let base = stream.output.length
  for 0 .. 12:
    @storage.push stream.output 0.0
  stream.output[base + 0] := canonical[at + 0]
  stream.output[base + 1] := canonical[at + 1]
  stream.output[base + 2] := canonical[at + 2]
  at := at + 3
  stream.output[base + 3] := canonical[at + 0]
  at := at + 1
  stream.output[base + 4] := canonical[at + 0]
  stream.output[base + 5] := canonical[at + 1]
  stream.output[base + 6] := canonical[at + 2]
  at := at + 3
  stream.output[base + 7] := canonical[at + 0]
  stream.output[base + 8] := canonical[at + 1]
  stream.output[base + 9] := canonical[at + 2]
  at := at + 3
  stream.output[base + 10] := canonical[at + 0]
  at := at + 1
  stream.output[base + 11] := canonical[at + 0]
  at := at + 1
  stream.at := at
  return stream

func listener_into (canonical: #[F32]) -> (stream: own Stream): Stream =>
  let at = stream.at
