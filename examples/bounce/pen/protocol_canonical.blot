  output[148] := canonical[at + 0]
  at := at + 1
  let state_start: U32 = output.length
  let state_count: U32 = 0
  state_count := lanes.integer canonical[at] lanes.max_integer
  at := at + 1
  for index in 0 .. state_count:
    @storage.push output canonical[at + index]
  at := at + state_count
  output[2] := U32.to_f32 (output.length - state_start)
  let draws_start: U32 = output.length
  let draws_count = lanes.integer canonical[at] lanes.max_integer
  at := at + 1
  for 0 .. draws_count:
    at := draw_into canonical at output children extras
  output[3] := U32.to_f32 draws_count
  let solids_start: U32 = output.length
  let solids_count = lanes.integer canonical[at] lanes.max_integer
  at := at + 1
  for 0 .. solids_count:
    at := solid_into canonical at output children extras
  output[4] := U32.to_f32 solids_count
  output[5] := U32.to_f32 (output.length - solids_start)
  let decals_start: U32 = output.length
  let decals_count = lanes.integer canonical[at] lanes.max_integer
  at := at + 1
  for 0 .. decals_count:
    at := decal_into canonical at output children extras
  output[6] := U32.to_f32 decals_count
  let sounds_start: U32 = output.length
  let sounds_count = lanes.integer canonical[at] lanes.max_integer
  at := at + 1
  for 0 .. sounds_count:
    at := sound_into canonical at output children extras
  output[7] := U32.to_f32 sounds_count
  let sprites_start: U32 = output.length
  let sprites_count = lanes.integer canonical[at] lanes.max_integer
  at := at + 1
  for 0 .. sprites_count:
    at := sprite_into canonical at output children extras
  output[8] := U32.to_f32 sprites_count
  let insets_start: U32 = output.length
  let insets_count = lanes.integer canonical[at] lanes.max_integer
  at := at + 1
  for 0 .. insets_count:
    at := inset_into canonical at output children extras
  output[9] := U32.to_f32 insets_count
  let inset_draws_start: U32 = output.length
  let inset_draws_count: U32 = children.length / 24
  for value in children:
    @storage.push output value
  output[10] := U32.to_f32 inset_draws_count
  let preferences_start: U32 = output.length
  let preferences_count: U32 = 0
  let present = lanes.integer canonical[at] 1
  at := at + 1
  if present == 1:
    preferences_count := lanes.integer canonical[at] lanes.max_integer
    at := at + 1
    for index in 0 .. preferences_count:
      @storage.push output canonical[at + index]
    at := at + preferences_count
  output[11] := U32.to_f32 (output.length - preferences_start)
  let fields_start: U32 = output.length
  let fields_count = lanes.integer canonical[at] lanes.max_integer
  at := at + 1
  for 0 .. fields_count:
    at := field_into canonical at output children extras
  output[130] := U32.to_f32 fields_count
  output[131] := U32.to_f32 (output.length - fields_start)
  let ui_start: U32 = output.length
  let ui_count = lanes.integer canonical[at] lanes.max_integer
  at := at + 1
  for 0 .. ui_count:
    at := ui_into canonical at output children extras
  output[132] := U32.to_f32 ui_count
  output[133] := U32.to_f32 (output.length - ui_start)
  let services_start: U32 = output.length
  let services_count = lanes.integer canonical[at] lanes.max_integer
  at := at + 1
  for 0 .. services_count:
    at := service_into canonical at output children extras
  output[134] := U32.to_f32 services_count
  output[135] := U32.to_f32 (output.length - services_start)
  let buses_start: U32 = output.length
  let buses_count = lanes.integer canonical[at] lanes.max_integer
  at := at + 1
  for 0 .. buses_count:
    at := buse_into canonical at output children extras
  output[136] := U32.to_f32 buses_count
  let voices_start: U32 = output.length
  let voices_count = lanes.integer canonical[at] lanes.max_integer
  at := at + 1
  for 0 .. voices_count:
    at := voice_into canonical at output children extras
  output[137] := U32.to_f32 voices_count
  let poses_start: U32 = output.length
  let poses_count = lanes.integer canonical[at] lanes.max_integer
  at := at + 1
  for 0 .. poses_count:
    at := pose_into canonical at output children extras
  output[138] := U32.to_f32 poses_count
  let emitters_start: U32 = output.length
  let emitters_count = lanes.integer canonical[at] lanes.max_integer
  at := at + 1
  for 0 .. emitters_count:
    at := emitter_into canonical at output children extras
  output[139] := U32.to_f32 emitters_count
  let lights_start: U32 = output.length
  let lights_count = lanes.integer canonical[at] lanes.max_integer
  at := at + 1
  for 0 .. lights_count:
    at := light_into canonical at output children extras
  output[141] := U32.to_f32 lights_count
  let listener_start: U32 = output.length
  let listener_count = lanes.integer canonical[at] lanes.max_integer
  at := at + 1
  for 0 .. listener_count:
    at := listener_into canonical at output children extras
  output[142] := U32.to_f32 listener_count
  let panners_start: U32 = output.length
  let panners_count = lanes.integer canonical[at] lanes.max_integer
  at := at + 1
  for 0 .. panners_count:
    at := panner_into canonical at output children extras
  output[143] := U32.to_f32 panners_count
  let instances_start: U32 = output.length
  let instances_count = lanes.integer canonical[at] lanes.max_integer
  at := at + 1
  for 0 .. instances_count:
    at := instance_into canonical at output children extras
  output[149] := U32.to_f32 instances_count
  let instance_removals_start: U32 = output.length
  let instance_removals_count = lanes.integer canonical[at] lanes.max_integer
  at := at + 1
  for 0 .. instance_removals_count:
    at := instance_removal_into canonical at output children extras
  output[150] := U32.to_f32 instance_removals_count
  let extras_start: U32 = output.length
  for value in extras:
    @storage.push output value
  lanes.require (at == canonical.length)
  return ()
