  let panners_start: U32 = stream.output.length
  let panners_count = lanes.integer canonical[at] lanes.max_integer
  at := at + 1
  stream.at := at
  for 0 .. panners_count:
    stream := panner_into canonical stream
  at := stream.at
  stream.output[173] := U32.to_f32 panners_count
  let instances_start: U32 = stream.output.length
  let instances_count = lanes.integer canonical[at] lanes.max_integer
  at := at + 1
  stream.at := at
  for 0 .. instances_count:
    stream := instance_into canonical stream
  at := stream.at
  stream.output[179] := U32.to_f32 instances_count
  let instance_removals_start: U32 = stream.output.length
  let instance_removals_count = lanes.integer canonical[at] lanes.max_integer
  at := at + 1
  stream.at := at
  for 0 .. instance_removals_count:
    stream := instance_removal_into canonical stream
  at := stream.at
  stream.output[180] := U32.to_f32 instance_removals_count
  let extras_start: U32 = stream.output.length
  for value in stream.extras:
    @storage.push stream.output value
  lanes.require (at == canonical.length)
  return stream.output
