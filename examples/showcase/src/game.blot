// Ink + Pen High-Fidelity Vertical-Slice Showcase & Interactive Scene Editor.
//
// Demonstrates the full Ink + Pen stack in one runnable project:
// - `ink/scene_graph` hierarchical transforms (monolith + floating crystal child)
// - `ink/editor/scene` ray picking, 3D RGB gizmo translate/rotate/scale drags,
//   bounded undo/redo history, and Play-in-Editor snapshot/restore (`P`)
// - `ink/sequencer` Hermite/linear animation during Play-in-Editor
// - `ink/pcg/noise`, `ink/render/foliage`, `ink/render/water` `spark` SIMD kernels
// - `ink/kernel_kits` + `ink/kernel_transport` multi-core `#kernel` offload
// - Pen high-fidelity GPU pipeline: visual `.matgraph.json` crystal shader,
//   physical sky + volumetric clouds (`1`), 2-tier ray tracing (`2`), DDGI probe
//   volume (`3`), WBOIT stained glass (`4`), TAAU temporal upscale (`5`), AgX
//   tonemapping, LTC rectangular area light + stained-glass cookie projector,
//   deferred PBR floor decal, courtyard reverb zone, and ambient DSP synth pad.
import * as array from "std/array"
import * as kernel from "std/kernel"
import { Vec2, Vec3 } from "std/vector"
import * as camera from "ink/camera"
import * as color from "ink/color"
import * as editor from "ink/editor/scene"
import * as events from "ink/events"
import * as foliage from "ink/render/foliage"
import * as gizmos from "ink/gizmos"
import * as host from "ink/pen/host"
import * as kernel_kits from "ink/kernel_kits"
import * as kernel_transport from "ink/kernel_transport"
import * as keys from "ink/input/keys"
import * as math from "ink/math"
import * as pcg_noise from "ink/pcg/noise"
import * as persist from "ink/persist"
import * as preferences from "ink/preferences"
import * as render from "ink/render"
import * as scene_graph from "ink/scene_graph"
import * as sequencer from "ink/sequencer"
import * as services from "ink/services"
import * as sound from "ink/sound"
import * as transform from "ink/transform"
import * as tree from "ink/ui/tree"
import * as vocab from "ink/ui/vocabulary"
import * as water from "ink/render/water"
import * as program from "pen/program"
import * as protocol from "pen/protocol"
import { meshes, materials, sounds } from "./assets/catalog.json"

const schema: U32 = 2

const arrow_left_bit: U32 = 1
const arrow_right_bit: U32 = 2
const arrow_up_bit: U32 = 4
const arrow_down_bit: U32 = 8
const arrow_all_bits: U32 = 15

const key_1: U32 = 49
const key_2: U32 = 50
const key_3: U32 = 51
const key_4: U32 = 52
const key_5: U32 = 53
const key_6: U32 = 54
const key_7: U32 = 55

const env_water_ext_tag: U32 = 65002
const env_foliage_ext_tag: U32 = 65003

const fov_y_rad: F32 = 0.9
const cam_near: F32 = 0.1
const cam_far: F32 = 120.0
const gizmo_handle_len: F32 = 1.75
const gizmo_pick_radius: F32 = 0.25

const default_preferences = preferences.make
  ($preferences.Quality {
    msaa: 1,
    fxaa: false,
    scale: 1.0,
    filtering: 8,
    shadows: 2048,
    occlusion: true,
    sky: true,
    fog: 0.4,
    effects: true,
    bloom: true,
    reflections: 2,
    volumetrics: 1,
  })
  ($preferences.Volumes { master: 0.8, effects: 0.85, music: 0.65 })
  ($preferences.Controls { left_handed: false })

const foliage_wind = $foliage.Wind {
  dir_x: 0.92,
  dir_z: 0.39,
  strength: 0.45,
  gust_freq: 0.55,
  gust_speed: 1.6,
  turbulence: 0.3,
}

const terrain_spec = $kernel_kits.TerrainSpec {
  seed: 1337,
  origin_x: (-6.0),
  origin_z: (-6.0),
  cell_size: 4.0,
  frequency: 0.08,
  octaves: 3,
  ridge_weight: 0.35,
  warp_strength: 0.25,
  amplitude: 1.6,
}

type World is data = $World {
  yaw: F32,
  pitch: F32,
  distance: F32,
  target: Vec3,
  held_arrows: U32,
  time: F32,
  play_time: F32,
  pointer_x: F32,
  pointer_y: F32,
  width: F32,
  height: F32,
  physical_sky: Bool,
  ray_tracing: U32,
  ddgi: Bool,
  oit: Bool,
  upscale: Bool,
  outdoor_env: Bool,
  night_lights: Bool,
  spawn_seq: U32,
  chime_pending: Bool,
  scene_save_pending: Bool,
  scene_load_pending: Bool,
  terrain_baked: Bool,
  terrain_height_sum: F32,
  nodes: #[scene_graph.Node],
  editor_state: editor.State,
  history: editor.History,
  pie_snapshot: editor.PlaySnapshot,
}

func make_pose (px: F32) -> (py: F32) -> (pz: F32) -> (sx: F32) -> (sy: F32) -> (sz: F32) : transform.Pose3 =>
  return $transform.Pose3 {
    position: math.vec3 px py pz,
    rotation: math.identity_quat,
    scale: math.vec3 sx sy sz,
  }

func build_initial_nodes () : #[scene_graph.Node] =>
  // Procedural foliage pillar heights via 4-wide `spark` SIMD noise grid.
  let hgrid = pcg_noise.simplex2_grid 1337 (-4.0) (-4.0) 2.5 4 4
  let h0 = 0.85 + abs hgrid[0] * 0.55
  let h1 = 0.85 + abs hgrid[3] * 0.55
  let h2 = 0.85 + abs hgrid[12] * 0.55
  let h3 = 0.85 + abs hgrid[15] * 0.55
  return #[
    // 0: Courtyard floor
    scene_graph.root_node 1 (make_pose 0.0 (-0.2) 0.0 6.5 0.2 6.5) meshes.box materials.floor,
    // 1: Central monolith (parent of crystal)
    scene_graph.root_node 2 (make_pose 0.0 1.2 0.0 0.75 1.2 0.75) meshes.box materials.monolith,
    // 2: Floating iridescent `.matgraph.json` crystal (child of monolith at index 1)
    scene_graph.child_node 3 1 (make_pose 0.0 1.65 0.0 0.72 0.78 0.72) meshes.sphere materials.crystal,
    // 3: Emissive amber beacon orb (drives DDGI & RT2 color bleed)
    scene_graph.root_node 4 (make_pose (-2.7) 1.35 (-1.3) 0.45 0.45 0.45) meshes.sphere materials.beacon,
    // 4: Translucent crimson stained glass pane (WBOIT front)
    scene_graph.root_node 5 (make_pose 2.15 1.35 0.45 0.9 1.35 0.07) meshes.box materials.glass_red,
    // 5: Translucent cobalt stained glass pane (WBOIT back)
    scene_graph.root_node 6 (make_pose 2.45 1.35 (-0.55) 0.9 1.35 0.07) meshes.box materials.glass_blue,
    // 6..9: Procedural foliage pillars swayed via `spark` SIMD gusts
    scene_graph.root_node 7 (make_pose (-4.2) h0 (-3.6) 0.45 h0 0.45) meshes.box materials.foliage,
    scene_graph.root_node 8 (make_pose 4.2 h1 (-3.6) 0.45 h1 0.45) meshes.box materials.foliage,
    scene_graph.root_node 9 (make_pose (-4.2) h2 3.1 0.45 h2 0.45) meshes.box materials.foliage,
    scene_graph.root_node 10 (make_pose 4.2 h3 3.1 0.45 h3 0.45) meshes.box materials.foliage,
  ]

func create () : World =>
  let ed = editor.new_state ()
  ed.selected_id := $Some 2
  return $World {
    yaw: 0.45,
    pitch: (-0.34),
    distance: 9.6,
    target: math.vec3 0.0 1.25 0.0,
    held_arrows: 0,
    time: 0.0,
    play_time: 0.0,
    pointer_x: 0.0,
    pointer_y: 0.0,
    width: 1280.0,
    height: 720.0,
    physical_sky: true,
    ray_tracing: 2,
    ddgi: true,
    oit: true,
    upscale: false,
    outdoor_env: true,
    night_lights: false,
    spawn_seq: 0,
    chime_pending: false,
    scene_save_pending: false,
    scene_load_pending: false,
    terrain_baked: false,
    terrain_height_sum: 0.0,
    nodes: build_initial_nodes (),
    editor_state: ed,
    history: editor.new_history 64,
    pie_snapshot: $editor.PlaySnapshot { active: false, nodes: #[] },
  }

func build_camera (world: World) -> (aspect: F32) : camera.Camera =>
  let rot = math.yaw_pitch world.yaw world.pitch
  let back_dir = math.Quat.rotate rot math.back
  let eye = world.target + back_dir * world.distance
  return $camera.Camera {
    position: eye,
    rotation: rot,
    projection: $camera.Perspective {
      fov_y: fov_y_rad,
      aspect: max 0.1 aspect,
      near: cam_near,
      far: cam_far,
      reversed: false,
    },
  }

func screen_ray (world: World) -> (px: F32) -> (py: F32) : Maybe math.Ray =>
  let w = max 1.0 world.width
  let h = max 1.0 world.height
  let cam = build_camera world (w / h)
  let ndc_x = (px / w) * 2.0 - 1.0
  let ndc_y = 1.0 - (py / h) * 2.0
  return camera.pick_ray cam ndc_x ndc_y

func arrow_bit (code: U32) : U32 =>
  if code == keys.left:
    return arrow_left_bit
  if code == keys.right:
    return arrow_right_bit
  if code == keys.up:
    return arrow_up_bit
  if code == keys.down:
    return arrow_down_bit
  return 0

func apply_event (world: own World) -> (event: events.Event) : World =>
  case event of
    $events.KeyDown code => do:
      let bit = arrow_bit code
      if bit != 0:
        world.held_arrows := world.held_arrows | bit
      if code == keys.w:
        world.editor_state.mode := editor.mode_translate
      if code == keys.e:
        world.editor_state.mode := editor.mode_rotate
      if code == keys.r:
        world.editor_state.mode := editor.mode_scale
      if code == keys.z and not world.editor_state.playing:
        let (undone, next_hist, next_nodes) = editor.undo world.history world.nodes
        world.history := next_hist
        world.nodes := next_nodes
        if undone:
          world.chime_pending := true
      if code == keys.y and not world.editor_state.playing:
        let (redone, next_hist, next_nodes) = editor.redo world.history world.nodes
        world.history := next_hist
        world.nodes := next_nodes
        if redone:
          world.chime_pending := true
      if code == keys.p:
        if world.editor_state.playing:
          let (next_ed, restored_nodes) = editor.exit_play world.editor_state world.pie_snapshot world.nodes
          world.editor_state := next_ed
          world.nodes := restored_nodes
          @storage.truncate world.pie_snapshot.nodes 0
          world.pie_snapshot.active := false
          world.play_time := 0.0
          world.chime_pending := true
        else:
          let (next_ed, snap) = editor.enter_play world.editor_state (&world.nodes[0..world.nodes.length])
          world.editor_state := next_ed
          @storage.truncate world.pie_snapshot.nodes 0
          for i in 0 .. snap.nodes.length:
            @storage.push world.pie_snapshot.nodes snap.nodes[i]
          world.pie_snapshot.active := snap.active
          world.play_time := 0.0
          world.chime_pending := true
      if code == key_1:
        world.physical_sky := not world.physical_sky
      if code == key_2:
        world.ray_tracing := (world.ray_tracing + 1) % 4
      if code == key_3:
        world.ddgi := not world.ddgi
      if code == key_4:
        world.oit := not world.oit
      if code == key_5:
        world.upscale := not world.upscale
      if code == key_6:
        world.outdoor_env := not world.outdoor_env
      if code == key_7:
        world.night_lights := not world.night_lights
      // Node authoring: N = spawn, D = duplicate, F = spawn prefab, Delete/Backspace = delete.
      if code == keys.n and not world.editor_state.playing:
        let new_id = editor.next_free_id (&world.nodes[0..world.nodes.length])
        let ang = U32.to_f32 world.spawn_seq * 0.85
        let px = cos ang * 2.6
        let pz = sin ang * 2.6
        let is_sphere = world.spawn_seq % 2 == 0
        let mesh_id = if is_sphere then meshes.sphere else meshes.box
        let mat_id = if is_sphere then materials.crystal else materials.monolith
        let n_node = scene_graph.root_node new_id (make_pose px 0.85 pz 0.55 0.55 0.55) mesh_id mat_id
        let (ok, next_hist, next_nodes) = editor.spawn_node n_node world.history world.nodes
        world.history := next_hist
        world.nodes := next_nodes
        if ok:
          world.spawn_seq := world.spawn_seq + 1
          world.editor_state.selected_id := $Some new_id
          world.chime_pending := true
      if code == keys.d and not world.editor_state.playing:
        if let $Some sel_id = world.editor_state.selected_id:
          if sel_id != 1:
            let (dup_id, next_hist, next_nodes) = editor.duplicate_node sel_id (math.vec3 1.25 0.0 0.0) world.history world.nodes
            world.history := next_hist
            world.nodes := next_nodes
            if let $Some nid = dup_id:
              world.editor_state.selected_id := $Some nid
              world.chime_pending := true
      if code == keys.f and not world.editor_state.playing:
        let tpl: #[scene_graph.Node] = #[
          scene_graph.root_node 1 (make_pose 0.0 0.6 0.0 0.45 0.6 0.45) meshes.box materials.monolith,
          scene_graph.child_node 2 0 (make_pose 0.0 1.05 0.0 0.38 0.38 0.38) meshes.sphere materials.beacon,
        ]
        let ovs: #[scene_graph.PrefabOverride] = #[
          $scene_graph.PrefabOverride {
            target_id: 2,
            flags: scene_graph.ov_material,
            position: math.zero3,
            rotation: math.identity_quat,
            scale: math.one3,
            visible: true,
            material: materials.crystal,
            tag: 0,
          },
        ]
        let ox = (-2.6) + U32.to_f32 (world.spawn_seq % 4) * 1.4
        let pf_pose = make_pose ox 0.0 2.4 1.0 1.0 1.0
        let (pf_id, next_hist, next_nodes) = editor.spawn_prefab (&tpl[0..2]) pf_pose (&ovs[0..1]) world.history world.nodes
        world.history := next_hist
        world.nodes := next_nodes
        if let $Some root_id = pf_id:
          world.spawn_seq := world.spawn_seq + 1
          world.editor_state.selected_id := $Some root_id
          world.chime_pending := true
      if (code == keys.delete or code == keys.backspace) and not world.editor_state.playing:
        if let $Some sel_id = world.editor_state.selected_id:
          if sel_id != 1:
            let (deleted, next_hist, next_nodes) = editor.delete_node sel_id world.history world.nodes
            world.history := next_hist
            world.nodes := next_nodes
            if deleted:
              world.editor_state.selected_id := if world.nodes.length > 1 then $Some world.nodes[1].id else $Nothing
              world.chime_pending := true
      if code == keys.s and not world.editor_state.playing:
        world.scene_save_pending := true
      if code == keys.l and not world.editor_state.playing:
        world.scene_load_pending := true
    $events.KeyUp code => do:
      let bit = arrow_bit code
      if bit != 0:
        world.held_arrows := world.held_arrows & (arrow_all_bits ^ bit)
    $events.FocusLost => do:
      world.held_arrows := 0
      world.editor_state := editor.end_drag world.editor_state
    $events.Wheel { delta } => do:
      world.distance := clamp 3.5 22.0 (world.distance - delta * 0.4)
    $events.PointerDown { button, x, y } => do:
      world.pointer_x := x
      world.pointer_y := y
      if button == 0 and not world.editor_state.playing:
        // Left Hierarchy sidebar click selects a node row directly.
        let picked_sidebar = false
        if x >= 10.0 and x <= 148.0 and y >= 68.0:
          let row = F32.to_u32 ((y - 68.0) / 22.0)
          if row < world.nodes.length and row < 10:
            world.editor_state.selected_id := $Some world.nodes[row].id
            world.chime_pending := true
            picked_sidebar := true
        if not picked_sidebar:
          if let $Some ray = screen_ray world x y:
            let resolved = scene_graph.resolve (&world.nodes[0..world.nodes.length])
            let started_drag = false
            if let $Some sel_id = world.editor_state.selected_id:
              if let $Some wi = editor.find_world_index (&resolved[0..resolved.length]) sel_id:
                let axes = editor.gizmo_axes_world world.editor_state.space resolved[wi].world
                let axis = editor.pick_gizmo_axis ray resolved[wi].world.position axes gizmo_handle_len gizmo_pick_radius
                if axis != editor.axis_none:
                  if let $Some ni = editor.find_node_index (&world.nodes[0..world.nodes.length]) sel_id:
                    let parent_world = Maybe.unwrap_or transform.identity3 (scene_graph.parent_world_of (&world.nodes[0..world.nodes.length]) (&resolved[0..resolved.length]) ni)
                    world.editor_state := editor.begin_drag world.editor_state axis ray resolved[wi].world.position axes world.nodes[ni].local parent_world
                    started_drag := world.editor_state.active_axis != editor.axis_none
            if not started_drag:
              let picked = editor.pick_node ray (&resolved[0..resolved.length]) 1.0
              world.editor_state.selected_id := picked
              if let $Some _ = picked:
                world.chime_pending := true
    $events.PointerMove { x, y } => do:
      world.pointer_x := x
      world.pointer_y := y
      if not world.editor_state.playing and world.editor_state.active_axis != editor.axis_none:
        if let $Some ray = screen_ray world x y:
          if let $Some sel_id = world.editor_state.selected_id:
            if let $Some ni = editor.find_node_index (&world.nodes[0..world.nodes.length]) sel_id:
              let next_pose = editor.solve_drag world.editor_state ray
              let node = world.nodes[ni]
              node.local := next_pose
              world.nodes[ni] := node
    $events.PointerUp { button, x, y } => do:
      world.pointer_x := x
      world.pointer_y := y
      if button == 0 and world.editor_state.active_axis != editor.axis_none:
        if let $Some sel_id = world.editor_state.selected_id:
          if let $Some ni = editor.find_node_index (&world.nodes[0..world.nodes.length]) sel_id:
            let cmd = $editor.SetPose {
              node_id: sel_id,
              before: world.editor_state.drag_start_pose,
              after: world.nodes[ni].local,
            }
            let (next_hist, next_nodes) = editor.commit_command cmd world.history world.nodes
            world.history := next_hist
            world.nodes := next_nodes
            world.chime_pending := true
        world.editor_state := editor.end_drag world.editor_state
    _ => ()
  return world

const crystal_hover_track = #[
  $sequencer.ScalarKey { time: 0.0, value: 1.65, interp: sequencer.interp_hermite, out_tangent: 1.2, next_in_tangent: 1.2 },
  $sequencer.ScalarKey { time: 2.0, value: 2.35, interp: sequencer.interp_hermite, out_tangent: (-1.2), next_in_tangent: (-1.2) },
  $sequencer.ScalarKey { time: 4.0, value: 1.65, interp: sequencer.interp_linear, out_tangent: 0.0, next_in_tangent: 0.0 },
]

func step (world: own World) -> (dt: F32) -> (width: F32) -> (height: F32) -> (incoming: &[events.Event]) : World =>
  world.width := max 1.0 width
  world.height := max 1.0 height
  world.chime_pending := false
  world.scene_save_pending := false
  world.scene_load_pending := false
  for event in incoming:
    world := apply_event self event
  let clamped_dt = clamp 0.0 0.1 dt
  world.time := world.time + clamped_dt
  // Smooth orbit rotation from held arrow keys.
  let turn_speed = 1.35 * clamped_dt
  if (world.held_arrows & arrow_left_bit) != 0:
    world.yaw := world.yaw + turn_speed
  if (world.held_arrows & arrow_right_bit) != 0:
    world.yaw := world.yaw - turn_speed
  if (world.held_arrows & arrow_up_bit) != 0:
    world.pitch := clamp (-1.3) (-0.08) (world.pitch - turn_speed * 0.7)
  if (world.held_arrows & arrow_down_bit) != 0:
    world.pitch := clamp (-1.3) (-0.08) (world.pitch + turn_speed * 0.7)
  // During Play-in-Editor, animate the iridescent crystal & beacon orb via `ink/sequencer`.
  if world.editor_state.playing:
    let player = $sequencer.Player { time: world.play_time, duration: 4.0, speed: 1.0, playing: true, looping: true }
    let stepped = sequencer.advance player clamped_dt
    world.play_time := stepped.player.time
    let hover_y = sequencer.sample_scalar (&crystal_hover_track[0..3]) world.play_time
    if let $Some ci = editor.find_node_index (&world.nodes[0..world.nodes.length]) 3:
      let cnode = world.nodes[ci]
      cnode.local.position := math.vec3 cnode.local.position.x hover_y cnode.local.position.z
      cnode.local.rotation := math.Quat.yaw (world.play_time * 1.5707963)
      world.nodes[ci] := cnode
    if let $Some bi = editor.find_node_index (&world.nodes[0..world.nodes.length]) 4:
      let bnode = world.nodes[bi]
      let ang = world.play_time * 1.5707963
      bnode.local.position := math.vec3 ((-2.7) * cos ang) (1.35 + 0.35 * sin (ang * 2.0)) ((-1.3) + 1.6 * sin ang)
      world.nodes[bi] := bnode
  return world

func affine_to_mat4 (a: transform.Affine3) : math.Mat4 => $math.Mat4 {
  xx: a.x.x, xy: a.x.y, xz: a.x.z, xw: 0.0,
  yx: a.y.x, yy: a.y.y, yz: a.y.z, yw: 0.0,
  zx: a.z.x, zy: a.z.y, zz: a.z.z, zw: 0.0,
  wx: a.position.x, wy: a.position.y, wz: a.position.z, ww: 1.0,
}

func gizmo_style () : editor.GizmoStyle => $editor.GizmoStyle {
  x: $gizmos.Style { mesh: meshes.box, material: materials.gizmo_x, thickness: 0.075 },
  y: $gizmos.Style { mesh: meshes.box, material: materials.gizmo_y, thickness: 0.075 },
  z: $gizmos.Style { mesh: meshes.box, material: materials.gizmo_z, thickness: 0.075 },
  active: $gizmos.Style { mesh: meshes.box, material: materials.gizmo_sel, thickness: 0.11 },
  selection: $gizmos.Style { mesh: meshes.box, material: materials.gizmo_sel, thickness: 0.035 },
  handle_length: gizmo_handle_len,
}

func push_panel (x: F32) -> (y: F32) -> (w: F32) -> (h: F32) -> (col: math.Vec4) -> (radius: F32) -> (border: F32) -> (frame: own render.FrameAccess) : render.FrameAccess =>
  @storage.push frame.sprites ($render.Sprite {
    x, y, width: w, height: h,
    u0: 0.0, v0: 0.0, u1: 1.0, v1: 1.0,
    color: col,
    material: materials.ui_panel,
    parameters: math.vec4 0.0 radius border 0.0,
  })
  return frame

func push_glyph (code: U32) -> (x: F32) -> (y: F32) -> (scale: F32) -> (col: math.Vec4) -> (frame: own render.FrameAccess) : render.FrameAccess =>
  if code < 32 or code >= 96:
    return frame
  let idx = code - 32
  let gx = idx % 8
  let gy = idx / 8
  let cell = 1.0 / 8.0
  let u0 = U32.to_f32 gx * cell
  let v0 = U32.to_f32 gy * cell
  @storage.push frame.sprites ($render.Sprite {
    x, y, width: 7.0 * scale, height: 8.0 * scale,
    u0, v0, u1: u0 + cell, v1: v0 + cell,
    color: col,
    material: materials.ui_font,
    parameters: math.vec4 1.0 0.0 0.0 0.0,
  })
  return frame

func push_text (codes: &[U32]) -> (x: F32) -> (y: F32) -> (scale: F32) -> (col: math.Vec4) -> (frame: own render.FrameAccess) : render.FrameAccess =>
  let cx = x
  for i in 0 .. codes.length:
    let c = codes[i]
    if c != 32:
      frame := push_glyph c cx y scale col self
    cx := self + 6.5 * scale
  return frame

func push_u32_label (val: U32) -> (x: F32) -> (y: F32) -> (scale: F32) -> (col: math.Vec4) -> (frame: own render.FrameAccess) : render.FrameAccess =>
  let d1 = (val / 10) % 10
  let d0 = val % 10
  frame := push_glyph (48 + d1) x y scale col self
  frame := push_glyph (48 + d0) (x + 6.5 * scale) y scale col self
  return frame

const lbl_move: #[U32] = #[77, 79, 86, 69] // MOVE
const lbl_rot: #[U32] = #[82, 79, 84, 32] // ROT
const lbl_scal: #[U32] = #[83, 67, 65, 76] // SCAL
const lbl_play: #[U32] = #[80, 76, 65, 89] // PLAY
const lbl_edit: #[U32] = #[69, 68, 73, 84] // EDIT
const lbl_sky: #[U32] = #[49, 58, 83, 75, 89] // 1:SKY
const lbl_rt: #[U32] = #[50, 58, 82, 84] // 2:RT
const lbl_gi: #[U32] = #[51, 58, 71, 73] // 3:GI
const lbl_oit: #[U32] = #[52, 58, 79, 73, 84] // 4:OIT
const lbl_up: #[U32] = #[53, 58, 85, 80] // 5:UP
const lbl_env: #[U32] = #[54, 58, 69, 78, 86] // 6:ENV
const lbl_night: #[U32] = #[55, 58, 54, 52, 76] // 7:64L
const lbl_scene: #[U32] = #[83, 67, 69, 78, 69] // SCENE
const lbl_node: #[U32] = #[78, 79, 68, 69, 32] // NODE
const lbl_sel: #[U32] = #[83, 69, 76, 58] // SEL:
const lbl_undo: #[U32] = #[85, 78, 68, 79, 58] // UNDO:
const lbl_hint: #[U32] = #[78, 58, 65, 68, 68, 32, 68, 58, 68, 85, 80, 32, 70, 58, 80, 82, 69, 70, 32, 90, 47, 89, 32, 80, 58, 80, 73, 69]
const lbl_toolbar: #[U32] = #[84, 79, 79, 76, 66, 65, 82] // TOOLBAR
const no_txt_codes: #[U32] = #[]
const foliage_xs: #[F32] = #[(-4.2), 4.2, (-4.2), 4.2]
const foliage_zs: #[F32] = #[(-3.6), (-3.6), 3.1, 3.1]
const water_cos_angles: #[F32] = #[0.25, 0.45, 0.65, 0.85]

func emit_hud_sprites (world: World) -> (resolved: &[scene_graph.WorldNode]) -> (frame: own render.FrameAccess) : render.FrameAccess =>
  let panel_bg = math.vec4 0.06 0.08 0.13 0.82
  let text_hi = math.vec4 0.94 0.96 1.0 1.0
  let text_dim = math.vec4 0.65 0.72 0.82 1.0
  let pill_on = math.vec4 0.14 0.56 0.42 0.92
  let pill_off = math.vec4 0.18 0.21 0.28 0.85
  let pill_mode = math.vec4 0.2 0.42 0.78 0.92
  let pill_play = if world.editor_state.playing then math.vec4 0.16 0.68 0.34 0.95 else math.vec4 0.76 0.48 0.12 0.95

  // Top toolbar strip
  let top_w = max 492.0 (world.width - 20.0)
  frame := push_panel 10.0 8.0 top_w 32.0 panel_bg 6.0 0.6 self

  // Mode badge (MOVE / ROT / SCALE)
  frame := push_panel 16.0 13.0 54.0 22.0 pill_mode 4.0 0.5 self
  if world.editor_state.mode == editor.mode_translate:
    frame := push_text (&lbl_move[0..4]) 22.0 18.0 1.2 text_hi self
  else:
    if world.editor_state.mode == editor.mode_rotate:
      frame := push_text (&lbl_rot[0..4]) 26.0 18.0 1.2 text_hi self
    else:
      frame := push_text (&lbl_scal[0..4]) 22.0 18.0 1.2 text_hi self

  // PIE Play/Edit pill
  frame := push_panel 74.0 13.0 52.0 22.0 pill_play 4.0 0.6 self
  if world.editor_state.playing:
    frame := push_text (&lbl_play[0..4]) 80.0 18.0 1.2 text_hi self
  else:
    frame := push_text (&lbl_edit[0..4]) 80.0 18.0 1.2 text_hi self

  // Feature pills 1:SKY, 2:RT, 3:GI, 4:OIT, 5:UP, 6:ENV (fits inside 480px)
  frame := push_panel 132.0 13.0 50.0 22.0 (if world.physical_sky then pill_on else pill_off) 4.0 0.4 self
  frame := push_text (&lbl_sky[0..5]) 137.0 18.0 1.1 text_hi self

  frame := push_panel 186.0 13.0 50.0 22.0 (if world.ray_tracing > 0 then pill_on else pill_off) 4.0 0.4 self
  frame := push_text (&lbl_rt[0..4]) 191.0 18.0 1.1 text_hi self
  frame := push_glyph (48 + world.ray_tracing) (191.0 + 4.0 * 6.5 * 1.1) 18.0 1.1 text_hi self

  frame := push_panel 240.0 13.0 42.0 22.0 (if world.ddgi then pill_on else pill_off) 4.0 0.4 self
  frame := push_text (&lbl_gi[0..4]) 245.0 18.0 1.1 text_hi self

  frame := push_panel 286.0 13.0 50.0 22.0 (if world.oit then pill_on else pill_off) 4.0 0.4 self
  frame := push_text (&lbl_oit[0..5]) 291.0 18.0 1.1 text_hi self

  frame := push_panel 340.0 13.0 42.0 22.0 (if world.upscale then pill_on else pill_off) 4.0 0.4 self
  frame := push_text (&lbl_up[0..4]) 345.0 18.0 1.1 text_hi self

  frame := push_panel 386.0 13.0 50.0 22.0 (if world.outdoor_env then pill_on else pill_off) 4.0 0.4 self
  frame := push_text (&lbl_env[0..5]) 391.0 18.0 1.1 text_hi self

  frame := push_panel 440.0 13.0 50.0 22.0 (if world.night_lights then pill_on else pill_off) 4.0 0.4 self
  frame := push_text (&lbl_night[0..5]) 445.0 18.0 1.1 text_hi self

  // Left Scene Hierarchy panel (hidden during PLAY)
  if not world.editor_state.playing:
    let shown = min 10 world.nodes.length
    let side_h = 26.0 + U32.to_f32 shown * 22.0
    frame := push_panel 10.0 46.0 138.0 side_h panel_bg 6.0 0.5 self
    frame := push_text (&lbl_scene[0..5]) 18.0 52.0 1.2 text_dim self
    frame := push_u32_label world.nodes.length 118.0 52.0 1.2 text_hi self
    for row in 0 .. shown:
      let n = world.nodes[row]
      let is_sel = case world.editor_state.selected_id of
        $Some sid => sid == n.id
        $Nothing => false
      let ry = 68.0 + U32.to_f32 row * 22.0
      let rcol = if is_sel then math.vec4 0.85 0.62 0.14 0.88 else math.vec4 0.12 0.16 0.24 0.68
      frame := push_panel 15.0 ry 128.0 19.0 rcol 3.0 (if is_sel then 0.8 else 0.2) self
      let indent = if n.parent == scene_graph.no_parent then 22.0 else 32.0
      frame := push_text (&lbl_node[0..5]) indent (ry + 5.0) 1.05 text_hi self
      frame := push_u32_label n.id (indent + 36.0) (ry + 5.0) 1.05 text_hi self

  // Bottom Inspector & hotkey strip
  let bot_y = max 260.0 (world.height - 34.0)
  frame := push_panel 10.0 bot_y top_w 26.0 panel_bg 5.0 0.5 self
  frame := push_text (&lbl_sel[0..4]) 18.0 (bot_y + 8.0) 1.15 text_dim self
  let sel_id = Maybe.unwrap_or 0 world.editor_state.selected_id
  frame := push_u32_label sel_id 48.0 (bot_y + 8.0) 1.15 text_hi self
  frame := push_text (&lbl_undo[0..5]) 74.0 (bot_y + 8.0) 1.15 text_dim self
  frame := push_u32_label world.history.cursor 112.0 (bot_y + 8.0) 1.15 text_hi self
  frame := push_text (&lbl_hint[0..28]) 142.0 (bot_y + 8.0) 1.1 text_dim self
  return frame

func emit_ui_tree (world: World) -> (ui_labels: own #[U32]) -> (ui_nodes: own #[tree.StoredNode]) : (#[U32], #[tree.StoredNode]) =>
  @storage.truncate ui_labels 0
  @storage.truncate ui_nodes 0
  let bar = $tree.Node {
    id: 100, parent: 0, role: vocab.role_toolbar,
    name: &lbl_toolbar[0..7], description: &no_txt_codes[0..0], value_text: &no_txt_codes[0..0],
    x: 10.0, y: 8.0, width: max 440.0 (world.width - 20.0), height: 32.0,
    focusable: false, focused: false, disabled: false, hidden: false, modal: false,
    checked: vocab.state_none, expanded: vocab.state_none, selected: vocab.state_none, live: vocab.live_off,
    value: 0.0, minimum: 0.0, maximum: 0.0, step: 0.0, actions: 0,
  }
  let (l1, n1) = tree.declare_owned bar ui_labels ui_nodes
  ui_labels := l1
  ui_nodes := n1
  let list = $tree.Node {
    id: 200, parent: 0, role: vocab.role_list,
    name: &lbl_scene[0..5], description: &no_txt_codes[0..0], value_text: &no_txt_codes[0..0],
    x: 10.0, y: 46.0, width: 138.0, height: 246.0,
    focusable: false, focused: false, disabled: false, hidden: world.editor_state.playing, modal: false,
    checked: vocab.state_none, expanded: vocab.state_true, selected: vocab.state_none, live: vocab.live_off,
    value: 0.0, minimum: 0.0, maximum: 0.0, step: 0.0, actions: 0,
  }
  let (l2, n2) = tree.declare_owned list ui_labels ui_nodes
  ui_labels := l2
  ui_nodes := n2
  let shown = min 10 world.nodes.length
  for row in 0 .. shown:
    let n = world.nodes[row]
    let is_sel = case world.editor_state.selected_id of
      $Some sid => sid == n.id
      $Nothing => false
    let item = $tree.Node {
      id: 201 + row, parent: 200, role: vocab.role_listitem,
      name: &lbl_node[0..4], description: &no_txt_codes[0..0], value_text: &no_txt_codes[0..0],
      x: 15.0, y: 68.0 + U32.to_f32 row * 22.0, width: 128.0, height: 19.0,
      focusable: true, focused: is_sel, disabled: false, hidden: world.editor_state.playing, modal: false,
      checked: vocab.state_none, expanded: vocab.state_none,
      selected: if is_sel then vocab.state_true else vocab.state_false,
      live: vocab.live_off,
      value: U32.to_f32 n.id, minimum: 0.0, maximum: 999.0, step: 1.0,
      actions: 1 << vocab.action_activate,
    }
    let (next_l, next_n) = tree.declare_owned item ui_labels ui_nodes
    ui_labels := next_l
    ui_nodes := next_n
  return (ui_labels, ui_nodes)

func populate_frame (world: World) -> (frame: own render.FrameAccess) -> (audio: own sound.Access) : (render.FrameAccess, sound.Access) =>
  let aspect = max 0.1 (world.width / max 1.0 world.height)
  let cam = build_camera world aspect
  let (half_s, half_c) = sin_cos (fov_y_rad * 0.5)
  let focal = half_c / half_s
  let view_mat = math.Mat4.view cam.position cam.rotation
  let proj_mat = math.Mat4.perspective focal aspect cam_near cam_far

  frame.settings[0].view := view_mat
  frame.settings[0].projection := proj_mat
  frame.settings[0].taa := true
  frame.settings[0].ssgi := true
  frame.settings[0].render_scale := if world.upscale then 0.65 else 1.0
  if world.night_lights:
    frame.settings[0].lighting := $render.Lighting {
      clear: math.vec4 0.015 0.025 0.055 1.0,
      ambient: math.vec3 0.018 0.024 0.042,
      direction: (math.vec3 (-0.52) (-0.68) (-0.52)).normalized,
      color: math.vec3 0.09 0.12 0.2,
    }
  else:
    frame.settings[0].lighting := $render.Lighting {
      clear: math.vec4 0.14 0.24 0.42 1.0,
      ambient: math.vec3 0.22 0.25 0.32,
      direction: (math.vec3 (-0.52) (-0.68) (-0.52)).normalized,
      color: math.vec3 2.4 2.15 1.85,
    }
  frame.settings[0].clouds := $render.Clouds {
    cover: if world.physical_sky then 0.45 else 0.0,
    drift: math.vec2 (world.time * 0.22) (world.time * 0.11),
  }
  frame.settings[0].post_look := $render.PostLook {
    tonemap: color.tonemap_agx_mode,
    sharpness: 0.25,
    grain: 0.0,
    flare: 0.15,
    outline_strength: 0.0,
  }
  frame.settings[0].features := $render.Features {
    oit: world.oit,
    physical_sky: world.physical_sky,
    upscale: world.upscale,
    ray_tracing: world.ray_tracing,
    ddgi: world.ddgi,
  }
  let exp = render.auto_exposure
  exp.compensation := (-0.75)
  frame.settings[0].exposure := exp

  // Evaluate `spark` SIMD foliage wind gusts and water Fresnel shimmer for the 4 foliage pillars.
  let resolved = scene_graph.resolve (&world.nodes[0..world.nodes.length])
  let gusts = foliage.gust_factors_batch foliage_wind (&foliage_xs[0..4]) (&foliage_zs[0..4]) world.time
  let fres = water.fresnel_batch (&water_cos_angles[0..4]) 0.02

  for i in 0 .. resolved.length:
    let wn = resolved[i]
    if wn.visible and wn.mesh != scene_graph.no_mesh:
      let mat4 = affine_to_mat4 wn.world
      if wn.id >= 7 and wn.id <= 10:
        let fi = wn.id - 7
        let sway = (gusts[fi] - 0.5) * 0.18 + fres[fi] * 0.04
        mat4.yx := mat4.yx + sway
      @storage.push frame.draws ($render.Draw {
        mesh: wn.mesh,
        material: wn.material,
        matrix: mat4,
        parameters: $Nothing,
        extra: render.no_span,
      })

  // LTC rectangular ceiling softbox light + stained-glass cookie spotlight projector.
  let area_softbox_gain = if world.night_lights then 0.02 else 6.5
  let area_cookie_gain = if world.night_lights then 0.35 else 10.0
  @storage.push frame.area_lights ($render.AreaLight {
    kind: render.area_light_rect,
    position: math.vec3 0.0 5.4 0.5,
    right: math.right,
    up: math.forward,
    color: math.vec3 1.0 0.88 0.72,
    intensity: area_softbox_gain,
    width: 3.0,
    height: 1.8,
    range: 18.0,
    cookie_material: 0,
    two_sided: false,
  })
  @storage.push frame.area_lights ($render.AreaLight {
    kind: 3,
    position: math.vec3 3.2 4.6 1.8,
    right: (math.vec3 (-0.5) 0.0 0.866).normalized,
    up: (math.vec3 (-0.43) 0.86 (-0.25)).normalized,
    color: math.vec3 0.85 0.95 1.0,
    intensity: area_cookie_gain,
    width: 2.2,
    height: 2.2,
    range: 16.0,
    cookie_material: materials.cookie + 1,
    two_sided: false,
  })

  // 64-light dynamic Night Showcase mode (Digit7): 3 dramatic directional clusters of colored
  // orbiting point lights showcasing Tier-3 ReSTIR DI per-pixel RT shadows + ReSTIR GI + SHaRC.
  if world.night_lights:
    for li in 0 .. 64:
      let fi = U32.to_f32 li
      let bob = sin (world.time * 1.4 + fi * 0.85) * 0.25
      let pos = math.vec3 0.0 1.0 0.0
      let tint = math.vec3 1.0 1.0 1.0
      let reach = 5.5
      if li < 24:
        // Cluster A (24 lights): warm amber/crimson sanctuary lanterns behind & left of monolith
        // casting long dramatic shadows across the central floor and front pillars.
        let t = fi / 24.0
        let ang = 2.15 + t * 1.95 + sin (world.time * 0.4 + fi) * 0.08
        let (sa, ca) = sin_cos ang
        let r = 1.65 + U32.to_f32 (li % 3) * 0.55
        let ly = 0.75 + U32.to_f32 (li % 4) * 0.38 + bob
        pos := math.vec3 (ca * r) ly (sa * r)
        tint := if li % 2 == 0 then math.vec3 0.28 0.11 0.02 else math.vec3 0.26 0.05 0.08
        reach := 6.8
      else:
        if li < 44:
          // Cluster B (20 lights): cool cyan/sapphire arcane orbs on the far right behind stained glass
          let lf = fi - 24.0
          let t = lf / 20.0
          let ang = (-0.95) + t * 1.55 - sin (world.time * 0.35 + lf) * 0.08
          let (sa, ca) = sin_cos ang
          let r = 2.6 + U32.to_f32 (li % 3) * 0.6
          let ly = 0.85 + U32.to_f32 (li % 4) * 0.4 + bob
          pos := math.vec3 (ca * r) ly (sa * r)
          tint := if li % 2 == 0 then math.vec3 0.03 0.22 0.32 else math.vec3 0.10 0.12 0.34
          reach := 6.2
        else:
          // Cluster C (20 lights): emerald/violet low perimeter torches around outer pillars & water
          let lf = fi - 44.0
          let ang = (lf / 20.0) * 6.2831853 + world.time * 0.12
          let (sa, ca) = sin_cos ang
          let r = 4.85 + U32.to_f32 (li % 2) * 0.5
          let ly = 0.55 + U32.to_f32 (li % 3) * 0.35 + bob
          pos := math.vec3 (ca * r) ly (sa * r)
          tint := if li % 2 == 0 then math.vec3 0.04 0.20 0.12 else math.vec3 0.18 0.06 0.24
          reach := 4.8
      @storage.push frame.lights ($render.PointLight {
        position: pos,
        radius: reach,
        intensity: tint,
        direction: math.up,
        inner: 1.0,
        outer: (-1.0),
        shadow: false,
        id: li + 1,
      })

  // Deferred PBR floor emblem decal (albedo + normal + ORM + cyan glow).
  @storage.push frame.pbr_decals ($render.PbrDecal {
    material: materials.decal,
    matrix: transform.matrix (make_pose 0.0 0.0 2.6 1.55 0.35 1.55),
    albedo: math.vec4 1.0 1.0 1.0 1.0,
    normal_strength: 0.9,
    roughness: 0.25,
    metallic: 0.6,
    emissive_strength: 1.6,
    fade: 1.0,
  })

  // 3D selection box & RGB axis gizmo handles while editing.
  if not world.editor_state.playing:
    frame := editor.draw_gizmo (gizmo_style ()) world.editor_state (&resolved[0..resolved.length]) self

  // Built-in outdoor GPU environment passes (`ENV_WATER_EXT_TAG` moat + `ENV_FOLIAGE_EXT_TAG` swaying perimeter grass).
  if world.outdoor_env:
    let water_vals: #[F32] = #[
      (-0.34), // water surface y (just below courtyard edge)
      (-2.2),  // seabed y
      0.015,   // gentle bed slope
      28.0,    // Gerstner mesh grid cells
      world.time,
      0.42, 0.14, 0.09, // Beer-Lambert RGB absorption
      0.03, 0.19, 0.34, // deep ocean tint
      0.68,             // crest foam threshold
      0.48, 0.44, 0.34, // sandy seabed color
      0.55,             // wave steepness scale
      22.0,             // half extent (22m surround moat)
    ]
    frame := render.push_extension env_water_ext_tag (&water_vals[0..water_vals.length]) self
    let grass_vals: #[F32] = #[
      world.time,
      0.92, 0.39,             // wind dir xz
      0.38, 1.8, 0.65,        // wind strength, speed, gust freq
      0.075, 0.85,            // blade half-width, height
      0.08, 0.34, 0.09,       // root RGB
      0.26, 0.72, 0.18,       // tip RGB
      0.45, 0.85, 0.22, 2.2,  // backlit SSS RGB + power
    ]
    // Scatter 24 swaying grass tufts around the outer courtyard ring.
    for g in 0 .. 24:
      let ga = U32.to_f32 g * 0.26179939
      let rad = 5.4 + U32.to_f32 (g % 3) * 0.35
      @storage.push grass_vals (cos ga * rad)
      @storage.push grass_vals 0.0
      @storage.push grass_vals (sin ga * rad)
      @storage.push grass_vals (0.85 + U32.to_f32 (g % 4) * 0.15)
      @storage.push grass_vals ga
      @storage.push grass_vals (U32.to_f32 g * 0.7)
      @storage.push grass_vals 0.08
      @storage.push grass_vals (0.85 + U32.to_f32 (g % 5) * 0.06)
    frame := render.push_extension env_foliage_ext_tag (&grass_vals[0..grass_vals.length]) self

  // Live 2D Editor HUD & Inspector overlay.
  frame := emit_hud_sprites world (&resolved[0..resolved.length]) self

  // 3D spatial audio: listener, courtyard reverb zone, subtle DSP synth pad, UI chime.
  let fwd = math.Quat.forward cam.rotation
  let up_v = math.Quat.up cam.rotation
  audio := sound.set_listener self (sound.listener cam.position fwd up_v)
  let zone = sound.reverb_zone 1 (math.vec3 0.0 2.0 0.0) (math.vec3 8.0 5.0 8.0)
  zone.decay := 2.4
  zone.damping := 0.35
  zone.wet := 0.28
  audio := sound.add_reverb_zone self zone
  let pad = sound.synth_voice 1 sound.synth_triangle sound.ambience (if world.editor_state.playing then 220.0 else 164.81)
  pad.gain := 0.04
  pad.cutoff := 900.0
  pad.reverb := 0.35
  audio := sound.play_synth self pad
  if world.chime_pending:
    audio := sound.ui self sounds.chime 0.55 (if world.editor_state.playing then 1.25 else 1.0)
  return (frame, audio)

// Serializes the full editor/world state for quicksaves, hot-reload, and `pen packets`.
func save (world: World) : #[F32] =>
  let sel = case world.editor_state.selected_id of
    $Some id => U32.to_f32 id
    $Nothing => 0.0
  let out: #[F32] = #[
    world.yaw,
    world.pitch,
    world.distance,
    world.target.x,
    world.target.y,
    world.target.z,
    world.time,
    world.play_time,
    if world.physical_sky then 1.0 else 0.0,
    U32.to_f32 world.ray_tracing,
    if world.ddgi then 1.0 else 0.0,
    if world.oit then 1.0 else 0.0,
    if world.upscale then 1.0 else 0.0,
    if world.outdoor_env then 1.0 else 0.0,
    if world.night_lights then 1.0 else 0.0,
    U32.to_f32 world.spawn_seq,
    sel,
    U32.to_f32 world.editor_state.mode,
    if world.editor_state.playing then 1.0 else 0.0,
    world.terrain_height_sum,
    U32.to_f32 world.nodes.length,
  ]
  for i in 0 .. world.nodes.length:
    let n = world.nodes[i]
    @storage.push out (U32.to_f32 n.id)
    @storage.push out (if n.parent == scene_graph.no_parent then (-1.0) else U32.to_f32 n.parent)
    @storage.push out n.local.position.x
    @storage.push out n.local.position.y
    @storage.push out n.local.position.z
    @storage.push out n.local.rotation.x
    @storage.push out n.local.rotation.y
    @storage.push out n.local.rotation.z
    @storage.push out n.local.rotation.w
    @storage.push out n.local.scale.x
    @storage.push out n.local.scale.y
    @storage.push out n.local.scale.z
    @storage.push out (if n.visible then 1.0 else 0.0)
    @storage.push out (U32.to_f32 n.mesh)
    @storage.push out (U32.to_f32 n.material)
    @storage.push out (U32.to_f32 n.tag)
  return out

func restore (lanes_in: &[F32]) : World =>
  let base = create ()
  if lanes_in.length < 21:
    return base
  base.yaw := lanes_in[0]
  base.pitch := lanes_in[1]
  base.distance := lanes_in[2]
  base.target := math.vec3 lanes_in[3] lanes_in[4] lanes_in[5]
  base.time := lanes_in[6]
  base.play_time := lanes_in[7]
  base.physical_sky := lanes_in[8] >= 0.5
  base.ray_tracing := F32.to_u32 (max 0.0 lanes_in[9]) % 4
  base.ddgi := lanes_in[10] >= 0.5
  base.oit := lanes_in[11] >= 0.5
  base.upscale := lanes_in[12] >= 0.5
  base.outdoor_env := lanes_in[13] >= 0.5
  base.night_lights := lanes_in[14] >= 0.5
  base.spawn_seq := F32.to_u32 (max 0.0 lanes_in[15])
  let sel_raw = F32.to_u32 (max 0.0 lanes_in[16])
  base.editor_state.selected_id := if sel_raw == 0 then $Nothing else $Some sel_raw
  base.editor_state.mode := F32.to_u32 (max 0.0 lanes_in[17]) % 3
  base.editor_state.playing := lanes_in[18] >= 0.5
  base.terrain_height_sum := lanes_in[19]
  let count = F32.to_u32 (max 0.0 lanes_in[20])
  if count > 0 and lanes_in.length >= 21 + count * 16:
    let nodes: #[scene_graph.Node] = #[]
    for i in 0 .. count:
      let o = 21 + i * 16
      let p_raw = lanes_in[o + 1]
      let parent = if p_raw < 0.0 then scene_graph.no_parent else F32.to_u32 p_raw
      let local = $transform.Pose3 {
        position: math.vec3 lanes_in[o + 2] lanes_in[o + 3] lanes_in[o + 4],
        rotation: math.Quat.normalized ($math.Quat { x: lanes_in[o + 5], y: lanes_in[o + 6], z: lanes_in[o + 7], w: lanes_in[o + 8] }),
        scale: math.vec3 lanes_in[o + 9] lanes_in[o + 10] lanes_in[o + 11],
      }
      @storage.push nodes ($scene_graph.Node {
        id: F32.to_u32 (max 0.0 lanes_in[o]),
        parent,
        local,
        visible: lanes_in[o + 12] >= 0.5,
        mesh: F32.to_u32 (max 0.0 lanes_in[o + 13]),
        material: F32.to_u32 (max 0.0 lanes_in[o + 14]),
        tag: F32.to_u32 (max 0.0 lanes_in[o + 15]),
      })
    base.nodes := nodes
  return base

type WorldScalars is data = $WorldScalars {
  yaw: F32,
  pitch: F32,
  distance: F32,
  target: Vec3,
  held_arrows: U32,
  time: F32,
  play_time: F32,
  pointer_x: F32,
  pointer_y: F32,
  width: F32,
  height: F32,
  physical_sky: Bool,
  ray_tracing: U32,
  ddgi: Bool,
  oit: Bool,
  upscale: Bool,
  outdoor_env: Bool,
  night_lights: Bool,
  spawn_seq: U32,
  chime_pending: Bool,
  scene_save_pending: Bool,
  scene_load_pending: Bool,
  terrain_baked: Bool,
  terrain_height_sum: F32,
  editor_state: editor.State,
  history_cursor: U32,
  history_limit: U32,
  history_next_group: U32,
  pie_active: Bool,
}

func pack_world_scalars (w: World) : WorldScalars => $WorldScalars {
  yaw: w.yaw,
  pitch: w.pitch,
  distance: w.distance,
  target: w.target,
  held_arrows: w.held_arrows,
  time: w.time,
  play_time: w.play_time,
  pointer_x: w.pointer_x,
  pointer_y: w.pointer_y,
  width: w.width,
  height: w.height,
  physical_sky: w.physical_sky,
  ray_tracing: w.ray_tracing,
  ddgi: w.ddgi,
  oit: w.oit,
  upscale: w.upscale,
  outdoor_env: w.outdoor_env,
  night_lights: w.night_lights,
  spawn_seq: w.spawn_seq,
  chime_pending: w.chime_pending,
  scene_save_pending: w.scene_save_pending,
  scene_load_pending: w.scene_load_pending,
  terrain_baked: w.terrain_baked,
  terrain_height_sum: w.terrain_height_sum,
  editor_state: w.editor_state,
  history_cursor: w.history.cursor,
  history_limit: w.history.limit,
  history_next_group: w.history.next_group,
  pie_active: w.pie_snapshot.active,
}

func unpack_world (s: WorldScalars) -> (nodes: own #[scene_graph.Node]) -> (hist_cmds: own #[editor.HistoryEntry]) -> (pie_nodes: own #[scene_graph.Node]) : World =>
  $World {
    yaw: s.yaw,
    pitch: s.pitch,
    distance: s.distance,
    target: s.target,
    held_arrows: s.held_arrows,
    time: s.time,
    play_time: s.play_time,
    pointer_x: s.pointer_x,
    pointer_y: s.pointer_y,
    width: s.width,
    height: s.height,
    physical_sky: s.physical_sky,
    ray_tracing: s.ray_tracing,
    ddgi: s.ddgi,
    oit: s.oit,
    upscale: s.upscale,
    outdoor_env: s.outdoor_env,
    night_lights: s.night_lights,
    spawn_seq: s.spawn_seq,
    chime_pending: s.chime_pending,
    scene_save_pending: s.scene_save_pending,
    scene_load_pending: s.scene_load_pending,
    terrain_baked: s.terrain_baked,
    terrain_height_sum: s.terrain_height_sum,
    nodes,
    editor_state: s.editor_state,
    history: $editor.History {
      commands: hist_cmds,
      cursor: s.history_cursor,
      limit: s.history_limit,
      next_group: s.history_next_group,
    },
    pie_snapshot: $editor.PlaySnapshot {
      active: s.pie_active,
      nodes: pie_nodes,
    },
  }

func pack_world (w: own World) : (WorldScalars, #[scene_graph.Node], #[editor.HistoryEntry], #[scene_graph.Node]) =>
  let scalars = pack_world_scalars w
  let $World { nodes, history, pie_snapshot } = w
  let $editor.History { commands } = history
  let $editor.PlaySnapshot { nodes: pie_nodes } = pie_snapshot
  return (scalars, nodes, commands, pie_nodes)

func copy_nodes_into (dst: own #[scene_graph.Node]) -> (src: &[scene_graph.Node]) : #[scene_graph.Node] =>
  @storage.truncate dst 0
  for i in 0 .. src.length:
    @storage.push dst (src.at i)
  return dst

// Keep every field on loop-carried `Access` a pre-allocated owner handle (or constant)
// so Blot's `for ever:` boxed-carry check stays unchanged and releases frame temporaries every tick.
type Access = {
  world_scalars: #[WorldScalars],
  world_nodes: #[scene_graph.Node],
  world_history: #[editor.HistoryEntry],
  world_pie: #[scene_graph.Node],
  frame: render.FrameAccess,
  audio: sound.Access,
  packet_events: #[protocol.Event],
  events: #[events.Event],
  ui_nodes: #[tree.StoredNode],
  ui_labels: #[U32],
  services: services.Services,
  service_output: #[services.Request],
  kernel_out: #[services.Request],
  kernels: kernel_transport.Access,
  preferences: #[preferences.Preferences],
  requests: #[U32],
  terrain_hash: kernel.Hash64,
}

func make_terrain_cells () : #[F32] =>
  let out: #[F32] = #[]
  for z in 0 .. 4:
    for x in 0 .. 4:
      @storage.push out (U32.to_f32 x)
      @storage.push out (U32.to_f32 z)
  return out

func init_access () : Access =>
  let owners = host.frame_owners ()
  let svc_next = #[1]
  let svc_outbox: #[services.Request] = #[]
  let svc_waiting: #[services.Request] = #[]
  let svc_filling: #[services.Filling] = #[]
  let svc_answers: #[services.Answer] = #[]
  let svc_statuses: #[U32] = #[]
  let svc_payload: #[F32] = #[]
  let svc = services.access svc_next svc_outbox svc_waiting svc_filling svc_answers svc_statuses svc_payload
  let packet_events: #[protocol.Event] = #[]
  let kernel_out: #[services.Request] = #[]
  let terrain_wire = kernel_kits.terrain_ctx_pack terrain_spec
  let terrain_hash = kernel.fnv1a64_f32s (&terrain_wire[0..terrain_wire.length])
  let (ws, wn, wh, wp) = pack_world (create ())
  return {
    world_scalars: #[ws],
    world_nodes: wn,
    world_history: wh,
    world_pie: wp,
    frame: owners.frame,
    audio: owners.audio,
    packet_events,
    events: owners.events,
    ui_nodes: owners.ui_nodes,
    ui_labels: owners.ui_labels,
    services: svc,
    service_output: owners.service_output,
    kernel_out,
    kernels: kernel_transport.owners (),
    preferences: #[default_preferences],
    requests: persist.requests (),
    terrain_hash,
  }

func measure_current_frame (access: Access) : U32 =>
  let drawn = render.finish access.frame
  let audio_view = sound.read access.audio
  let ui_view = &access.ui_nodes[0..access.ui_nodes.length]
  let svc_view = &access.service_output[0..access.service_output.length]
  return host.measure_frame_floats audio_view access.preferences[0] ui_view drawn svc_view access.services

const acknowledge = func access -> published => ()

func execute (terrain_kernel: Kernel [#[F32], #[2; F32], #[4; F32]]) -> (access: own Access) -> (operation: U32) -> (payload: &[F32]) -> (outgoing: own #[F32]) =>
  case operation of
    1 => do:
      let fresh = create ()
      access.world_scalars[0] := pack_world_scalars fresh
      access.world_nodes := copy_nodes_into self (&fresh.nodes[0..fresh.nodes.length])
      @storage.truncate access.world_history 0
      @storage.truncate access.world_pie 0
      outgoing := program.append (save fresh) self
    2 => do:
      access.frame := render.begin_frame self
      access.audio := sound.begin_frame self
      let packet: #[F32] = array.generate payload.length (func i => payload.at i)
      let (input, next_pe, next_ev) = host.decode_frame packet access.packet_events access.events
      access.packet_events := next_pe
      access.events := next_ev
      // Deliver `request == 0` multi-core kernel events and apply preferences before stepping.
      let ev_copy: #[events.Event] = copy access.events
      access.kernels := kernel_transport.receive_events self (&ev_copy[0..ev_copy.length])
      for ev in ev_copy:
        access.preferences := preferences.receive self ev
      let w = unpack_world access.world_scalars[0] access.world_nodes access.world_history access.world_pie
      if let $Some ans = kernel_kits.find_answer_for access.kernels terrain_kernel access.terrain_hash:
        let vals = kernel_transport.batch_values access.kernels ans
        let sum = 0.0
        for i in 0 .. ans.item_count:
          if i * 4 < vals.length:
            sum := sum + vals[i * 4]
        w.terrain_height_sum := sum
        w.terrain_baked := true
      w := step self input.elapsed input.width input.height (&ev_copy[0..ev_copy.length])
      access.requests := persist.clear_requests self
      if w.scene_save_pending:
        access.requests := persist.request self $persist.SaveScene
      if w.scene_load_pending:
        access.requests := persist.request self $persist.LoadScene
      // Dispatch the 16-cell terrain bake batch to Pen's multi-core worker pool once CAP arrives.
      if not w.terrain_baked:
        let wire = kernel_kits.terrain_ctx_pack terrain_spec
        let cells = make_terrain_cells ()
        let (_, next_kt) = kernel_kits.dispatch_batch access.kernels terrain_kernel access.terrain_hash (&wire[0..wire.length]) 16 (&cells[0..cells.length])
        access.kernels := next_kt
      let (next_frame, next_audio) = populate_frame w access.frame access.audio
      access.frame := next_frame
      access.audio := next_audio
      let (next_labels, next_ui) = emit_ui_tree w access.ui_labels access.ui_nodes
      access.ui_labels := next_labels
      access.ui_nodes := next_ui
      let (ws, wn, wh, wp) = pack_world w
      access.world_scalars[0] := ws
      access.world_nodes := wn
      access.world_history := wh
      access.world_pie := wp
      let base_floats = measure_current_frame access
      let svc_count = access.service_output.length
      @storage.truncate access.kernel_out 0
      let (next_kt, next_kout) = host.admit_kernel_requests base_floats svc_count access.kernels access.kernel_out
      access.kernels := next_kt
      access.kernel_out := next_kout
      let drawn = render.finish access.frame
      let audio_view = sound.read access.audio
      let ui_view = &access.ui_nodes[0..access.ui_nodes.length]
      let ui_label_view = &access.ui_labels[0..access.ui_labels.length]
      let svc_view = &access.service_output[0..access.service_output.length]
      outgoing := host.append_frame_with_kernels schema access.requests audio_view access.preferences[0] ui_view ui_label_view drawn
        svc_view access.services (&access.kernel_out[0..access.kernel_out.length]) (&access.kernels.payload[0..access.kernels.payload.length]) self
      access.preferences[0].changed := false
    3 => do:
      let w = unpack_world access.world_scalars[0] access.world_nodes access.world_history access.world_pie
      outgoing := program.append (save w) self
      let (ws, wn, wh, wp) = pack_world w
      access.world_scalars[0] := ws
      access.world_nodes := wn
      access.world_history := wh
      access.world_pie := wp
    4 => do:
      let restored = restore payload
      access.world_scalars[0] := pack_world_scalars restored
      access.world_nodes := copy_nodes_into self (&restored.nodes[0..restored.nodes.length])
      @storage.truncate access.world_history 0
      @storage.truncate access.world_pie 0
      outgoing := program.append (save restored) self
    5 => do:
      let encoded = editor.encode_scene (&access.world_nodes[0..access.world_nodes.length])
      outgoing := program.append encoded self
    6 => do:
      if let $Some loaded = editor.decode_scene payload:
        let next_sel = if loaded.length > 1 then $Some loaded[1].id else if loaded.length > 0 then $Some loaded[0].id else $Nothing
        access.world_nodes := copy_nodes_into self (&loaded[0..loaded.length])
        @storage.truncate access.world_history 0
        @storage.truncate access.world_pie 0
        let s = access.world_scalars[0]
        s.history_cursor := 0
        s.history_limit := 64
        s.history_next_group := 1
        s.pie_active := false
        s.editor_state.playing := false
        s.editor_state.selected_id := next_sel
        access.world_scalars[0] := s
      let encoded = editor.encode_scene (&access.world_nodes[0..access.world_nodes.length])
      outgoing := program.append encoded self
    _ => panic "unexpected session op"
  return (access, outgoing)

func run (terrain_kernel: Kernel [#[F32], #[2; F32], #[4; F32]]) -> host =>
  let incoming: #[F32] = #[]
  let outgoing: #[F32] = #[]
  let access = init_access ()
  use _ <- program.run (execute terrain_kernel) acknowledge access schema true incoming outgoing host
  return ()
