  let lights_start: U32 = stream.output.length
  let lights_count = lanes.integer canonical[at] lanes.max_integer
  at := at + 1
  stream.at := at
  for 0 .. lights_count:
    stream := light_into canonical stream
  at := stream.at
  stream.output[171] := U32.to_f32 lights_count
  let listener_start: U32 = stream.output.length
  let listener_count = lanes.integer canonical[at] lanes.max_integer
  at := at + 1
  stream.at := at
  for 0 .. listener_count:
