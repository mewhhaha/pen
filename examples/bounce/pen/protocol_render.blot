    lanes.bit ui_node.disabled, lanes.bit ui_node.hidden,
    lanes.bit ui_node.modal, U32.to_f32 (ui_node.checked),
    U32.to_f32 (ui_node.expanded), U32.to_f32 (ui_node.selected),
    U32.to_f32 (ui_node.live), ui_node.value, ui_node.minimum, ui_node.maximum,
    ui_node.step, U32.to_f32 (ui_node.actions), U32.to_f32 (ui_node.text_length),
    U32.to_f32 (ui_node.name_length), U32.to_f32 (ui_node.description_length),
