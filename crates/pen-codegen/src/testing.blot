// A separate Blot test drives a real native session through this capability.
// Run with pen test-blot --session. Commands finish before the next runs.
import * as array from "std/array"
import * as protocol from "./protocol"

type Save is data = #Save { schema: U32, state: Array F32 }
type Selector is data = #Selector { role: U32, name: Array U32 }

const button = fn name => #Selector { role: protocol.ui_role_button, name }
const dialog = fn name => #Selector { role: protocol.ui_role_dialog, name }
const named = fn role name => #Selector { role, name }

const text = fn (value: Array U32) => array.concat #[from value.length] (array.map U32.to_f32 value)
const call = fn (driver: Array F32 -> Array F32 ! { Foreign }) op values =>
  driver (array.concat #[1.0, from op] values)

const run = fn driver body => do:
  use body driver
  break call driver protocol.test_driver_op_finish #[]

// initial.state is the game's ordinary payload, not a saved Wasm stack.
const launch = fn driver initial width height => do:
  let #Save { schema, state } = initial
  use call driver protocol.test_driver_op_launch
    (array.concat #[from width, from height, from schema, from state.length] state)
  break ()

const step = fn driver (ticks: U32) => do:
  use call driver protocol.test_driver_op_step #[from ticks]
  break ()

const locate = fn driver op selector ticks => do:
  let #Selector { role, name } = selector
  use call driver op (array.concat #[from role, from ticks] (text name))
  break ()

// Waits advance at 60 ticks/second, with a bounded number of ticks.
const click_within = fn driver selector ticks => locate driver protocol.test_driver_op_click selector ticks
const click = fn driver selector => click_within driver selector 300
const expect_visible = fn driver selector => locate driver protocol.test_driver_op_visible selector 300
const expect_hidden = fn driver selector => locate driver protocol.test_driver_op_hidden selector 300

const press = fn driver key => do:
  use call driver protocol.test_driver_op_press (text key)
  break ()

// Decode or inspect this in the test's own Blot code, using the game's codecs.
const snapshot = fn driver => do:
  use values <- call driver protocol.test_driver_op_snapshot #[]
  break #Save { schema: F32.to_u32 values[0], state: array.slice 1 (values.length - 1) values }

const equal = fn driver label (expected: Array F32) (actual: Array F32) => do:
  use call driver protocol.test_driver_op_equal (array.flatten #[
    text label, #[from expected.length], expected, #[from actual.length], actual,
  ])
  break ()

const picture = fn driver name compare tolerance => do:
  use call driver protocol.test_driver_op_screenshot
    (array.concat #[if compare then 1.0 else 0.0, tolerance] (text name))
  break ()
const screenshot = fn driver name => picture driver name #False 0.0
// RGB RMSE is normalized to 0..1. A missing golden fails unless --update is set.
const expect_screenshot = fn driver name tolerance => picture driver name #True tolerance
