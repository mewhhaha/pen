// Copied worker jobs use isolated invocations and ordinary owned storage.
io const collected = func (value: U32) => @u32.add (@u32.add value value) 42
#kernel func collected_kernel (value: U32): U32 => return @u32.add (@u32.add value value) 42
io const incremented = func (value: U32) => @u32.add value 1
io const captured = func (values: #[U32]) => copy values
// The entry takes its argument over (`own`), so the updates are in place.
io const partitioned = func (owner: own #[U32]) =>
  owner[0] := @u32.add owner[0] 1
  owner[2] := @u32.add owner[2] 2
  return @u32.add owner[0] owner[2]
io const failing = func (value: U32) => @u32.div value 0
io const large_result = func (count: U32) =>
  let output: #[U32] = #[]
  for i in 0 .. count:
    @storage.push output (@u32.add i 1)
  return output
io const repeated = func (count: U32) =>
  let sum = 0
  for index in 0 .. count:
    sum := @u32.add self (@u32.add index 1)
  return sum
