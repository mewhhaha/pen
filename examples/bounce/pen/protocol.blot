// The codes KeyDown and KeyUp carry for named keys; a key that types a character
// carries its code point, a letter its capital's.
const key_arrow_left = 1114368
const key_arrow_right = 1114369
const key_arrow_up = 1114370
const key_arrow_down = 1114371
const key_tab = 1114372
