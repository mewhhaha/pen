// Generated by pen codegen from pen/protocol/schema.json:
// edit the schema and run `pen codegen`, not this file.
//
// The packets' canonical walks (pen-codegen's canonical.rs), which pen's tests
// compare with Rust's. Only tests import this; the game must not.
import * as array from "std/array"
import * as lanes from "./lanes"
import * as protocol from "./protocol"

// An event's walk: its tag, then its fields in the schema's order.
const canonical_event = func (event: protocol.Event) => return case event of
  $protocol.KeyDown value => #[1.0, U32.to_f32 value]
  $protocol.KeyUp value => #[2.0, U32.to_f32 value]
  $protocol.PointerDown { button, x, y } => #[3.0, U32.to_f32 button, x, y]
  $protocol.PointerUp { button, x, y } => #[4.0, U32.to_f32 button, x, y]
  $protocol.PointerMove { x, y } => #[5.0, x, y]
  $protocol.Wheel { x, y, delta } => #[6.0, x, y, delta]
  $protocol.FocusLost => #[7.0]
  $protocol.AssetChanged => #[8.0]
  $protocol.Console { command, argument } => #[9.0, U32.to_f32 command, U32.to_f32 argument]
  $protocol.Preference { index, value } => #[10.0, U32.to_f32 index, value]
  $protocol.Tune { index, value } => #[11.0, U32.to_f32 index, value]
  $protocol.UiAction { node, action, value } => #[12.0, U32.to_f32 node, U32.to_f32 action, value]
  $protocol.ServiceAnswer { request, status, value, length } => #[13.0, U32.to_f32 request, U32.to_f32 status, value, U32.to_f32 length]
  $protocol.ServiceData { request, a, b, c } => #[14.0, U32.to_f32 request, a, b, c]
  $protocol.GamepadConnected { pad, standard } => #[15.0, U32.to_f32 pad, U32.to_f32 standard]
  $protocol.GamepadDisconnected { pad } => #[16.0, U32.to_f32 pad]
  $protocol.GamepadButton { button, pad, value, pressed } => #[17.0, U32.to_f32 button, U32.to_f32 pad, value, U32.to_f32 pressed]
  $protocol.GamepadAxis { axis, pad, value } => #[18.0, U32.to_f32 axis, U32.to_f32 pad, value]
  $protocol.Action { action, value, device } => #[19.0, U32.to_f32 action, value, U32.to_f32 device]
  $protocol.TextInput { character, composing } => #[20.0, U32.to_f32 character, U32.to_f32 composing]
  $protocol.Composition { length, cursor } => #[21.0, U32.to_f32 length, U32.to_f32 cursor]
  $protocol.MouseMotion { dx, dy } => #[22.0, dx, dy]
  $protocol.Touch { id, x, y, phase } => #[23.0, U32.to_f32 id, x, y, U32.to_f32 phase]
  $protocol.Pan { touches, dx, dy } => #[24.0, U32.to_f32 touches, dx, dy]
  $protocol.Pinch { x, y, scale } => #[25.0, x, y, scale]
  $protocol.Player { index } => #[26.0, U32.to_f32 index]
  $protocol.SessionStarted { restored } => #[27.0, U32.to_f32 restored]
  $protocol.RendererReady => #[28.0]

// The input's walk, as pen-protocol's canonical_input makes it: elapsed, the
// viewport's width and height, the events' count and walks, then the state's
// count and lanes.
const canonical_input = func (input: protocol.Input) => return do:
  let $protocol.Input { elapsed, width, height, events, state } = input
  let output: GrowArray F32 = #[elapsed, width, height, U32.to_f32 events.length]
  for event in events:
    array.append_into output (canonical_event event)
  output.push (U32.to_f32 state.length)
  array.append_into output state
  return @storage.freeze output


