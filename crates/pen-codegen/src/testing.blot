// A separate Blot test drives a real native session through this capability.
// Run with pen test-blot --session. Commands finish before the next runs.
import * as array from "std/array"
import * as protocol from "./protocol"

type Save is data = $Save { schema: U32, state: Array F32 }
type Selector is data = $Selector { role: U32, name: Array U32 }

const button = func name => return $Selector { role: protocol.ui_role_button, name }
const dialog = func name => return $Selector { role: protocol.ui_role_dialog, name }
const named = func role -> name => return $Selector { role, name }

const text = func (value: Array U32) => return array.concat #[from value.length] (array.map U32.to_f32 value)
const call = func (driver: Array F32 -> Array F32 ! { Foreign }) -> op -> values => return
  driver (array.concat #[1.0, from op] values)

const run = func driver -> body => return do:
  use body driver
  break call driver protocol.test_driver_op_finish #[]

// initial.state is the game's ordinary payload, not a saved Wasm stack.
const launch = func driver -> initial -> width -> height => return do:
  let $Save { schema, state } = initial
  use call driver protocol.test_driver_op_launch
    (array.concat #[from width, from height, from schema, from state.length] state)
  break ()

const step = func driver -> (ticks: U32) => return do:
  use call driver protocol.test_driver_op_step #[from ticks]
  break ()

const locate = func driver -> op -> selector -> ticks => return do:
  let $Selector { role, name } = selector
  use call driver op (array.concat #[from role, from ticks] (text name))
  break ()

// Waits advance at 60 ticks/second, with a bounded number of ticks.
const click_within = func driver -> selector -> ticks => return locate driver protocol.test_driver_op_click selector ticks
const click = func driver -> selector => return click_within driver selector 300
const expect_visible = func driver -> selector => return locate driver protocol.test_driver_op_visible selector 300
const expect_hidden = func driver -> selector => return locate driver protocol.test_driver_op_hidden selector 300

const press = func driver -> key => return do:
  use call driver protocol.test_driver_op_press (text key)
  break ()

// Decode or inspect this in the test's own Blot code, using the game's codecs.
const snapshot = func driver => return do:
  use values <- call driver protocol.test_driver_op_snapshot #[]
  break $Save { schema: F32.to_u32 values[0], state: array.slice 1 (values.length - 1) values }

const equal = func driver -> label -> (expected: Array F32) -> (actual: Array F32) => return do:
  let packet: GrowArray F32 = #[]
  array.append_into packet (text label)
  packet.push (from expected.length)
  array.append_into packet expected
  packet.push (from actual.length)
  array.append_into packet actual
  use call driver protocol.test_driver_op_equal (@storage.freeze packet)
  break ()

const picture = func driver -> name -> compare -> tolerance => return do:
  use call driver protocol.test_driver_op_screenshot
    (array.concat #[if compare then 1.0 else 0.0, tolerance] (text name))
  break ()
const screenshot = func driver -> name => return picture driver name false 0.0
// RGB RMSE is normalized to 0..1. A missing golden fails unless --update is set.
const expect_screenshot = func driver -> name -> tolerance => return picture driver name true tolerance
