const many = func (value: U32) => return @array.generate 100 (func (i: U32) => return @u32.add i value)
const twice = func value => return @u32.add value value
entry const collected = func (value: U32) => return @task.scope (func group => return do:
  let a = *(twice value)
  let b = *(twice 21)
  let (left, right) = |(a, b)|
  return @u32.add left right)
entry const nested = func (value: U32) => return @task.scope (func group => return do:
  let child = @task.spawn group (func () => return @task.scope (func inner => return do:
    let a = @task.spawn inner (func () => return @u32.add value 1)
    return |a|))
  return |child|)
entry const cancelled = func (value: U32) => return @task.scope (func group => return do:
  let child = @task.spawn group (func () : U32 => return @u32.div value 0)
  @task.cancel child
  return value)
entry const unjoined = func (value: U32) => return @task.scope (func group => return do:
  let child = @task.spawn group (func () => return many value)
  return value)
entry const captured = func (values: Array U32) => return @task.scope (func group => return do:
  let child = @task.spawn group (func () => return values)
  return |child|)
entry const failing = func (value: U32) => return @task.scope (func group => return do:
  let a = @task.spawn group (func () => return @u32.div value 0)
  let b = @task.spawn group (func () => return many value)
  let (a, b) = |(a, b)|
  return a)
entry const partitioned = func (owner: unique (Array U32)) => return do:
  let (owner, result) = @task.split owner ((0, 2), (2, 4)) (func views => return do:
    let (left, right) = views
    return @task.scope (func group => return do:
      let a = @task.spawn group (func () => return do:
        @task.write left 0 (@u32.add (@task.read left 0) 1)
        return @task.read left 0)
      let b = @task.spawn group (func () => return do:
        @task.write right 0 (@u32.add (@task.read right 0) 2)
        return @task.read right 0)
      let (a, b) = |(a, b)|
      return @u32.add a b))
  return result
const allocate = func (count: U32) : Array U32 => return @array.generate count (func (i: U32) => return @u32.add i 1)
entry const large_result = func (count: U32) => return @task.scope (func group => return do:
  let child = @task.spawn group (func () => return allocate count)
  return |child|)
entry const repeated = func (count: U32) => return @task.scope (func group => return do:
  let sum = 0
  for index in 0 .. count:
    let child = @task.spawn group (func () => return @u32.add index 1)
    let value = |child|
    sum := @u32.add self value
  return sum)
