// Generated by pen codegen from pen/protocol/schema.json:
// edit the schema and run `pen codegen`, not this file.
//
// Encode Pen wire records without application dependencies.
import * as array from "std/array"
import * as lanes from "./lanes"
import * as protocol from "./protocol"
import * as types from "./types"

// A Draw's lanes.
const encode_draw = fn (draw: types.Draw) => do:
  let #types.Mat4 { x: transform_x, y: transform_y, z: transform_z, w: transform_w } = draw.transform
  let (parameters_count, parameters) = case draw.parameters of
    #Some value => (4.0, value)
    #Nothing => (0.0, types.zero4)
  return #[
    from draw.mesh, from draw.material, transform_x.x, transform_x.y,
    transform_x.z, transform_x.w, transform_y.x, transform_y.y, transform_y.z,
    transform_y.w, transform_z.x, transform_z.y, transform_z.z, transform_z.w,
    transform_w.x, transform_w.y, transform_w.z, transform_w.w, parameters_count,
    parameters.x, parameters.y, parameters.z, parameters.w,
    from (min draw.extra.length protocol.max_draw_extra),
  ]

// Solid: its faces' count, then each of them.
const encode_solid = fn (solid: types.Solid) => do:
  let faces = solid.faces
  let encoded = @array.fill (protocol.solid_floats + faces.length * protocol.solid_face_floats) 0.0
  encoded[0] := from faces.length
  for index in 0 .. faces.length:
    let face = faces[index]
    let start = protocol.solid_floats + index * protocol.solid_face_floats
    encoded[start] := face.normal.x
    encoded[start + 1] := face.normal.y
    encoded[start + 2] := face.normal.z
    encoded[start + 3] := face.distance
    encoded[start + 4] := from face.material
  return encoded

// Decal: `material`'s texture laid onto the surfaces inside the box, the cube
// -1..1 under `transform`, along its y axis, where their material takes decals;
// `opacity` fades it.
const encode_decal = fn (decal: types.Decal) => do:
  let #types.Mat4 { x: transform_x, y: transform_y, z: transform_z, w: transform_w } = decal.transform
  return #[
    from decal.material, transform_x.x, transform_x.y, transform_x.z,
    transform_x.w, transform_y.x, transform_y.y, transform_y.z, transform_y.w,
    transform_z.x, transform_z.y, transform_z.z, transform_z.w, transform_w.x,
    transform_w.y, transform_w.z, transform_w.w, decal.opacity,
  ]

// Sound: A sound to play once on a bus at the gain, pan, pitch, lowpass cutoff
// and reverb send given, all worked out by the game.
const encode_sound = fn (sound: types.Sound) => do:
  return #[
    from sound.clip, from sound.bus, sound.gain, sound.pan, sound.pitch,
    sound.lowpass, sound.reverb,
  ]

// Sprite: A rectangle over the screen, in pixels from its top left, drawn by its
// material's sprite shader, which reads the four `parameters` as it likes.
const encode_sprite = fn (sprite: types.Sprite) => do:
  return #[
    sprite.x, sprite.y, sprite.width, sprite.height, sprite.u0, sprite.v0,
    sprite.u1, sprite.v1, sprite.color.x, sprite.color.y, sprite.color.z,
    sprite.color.w, from sprite.material, sprite.parameters.x,
    sprite.parameters.y, sprite.parameters.z, sprite.parameters.w,
  ]

// Inset: A small 3D view over the screen, in the rectangle at (x, y).
const encode_inset = fn (inset: types.Inset) => do:
  let #types.Mat4 { x: view_x, y: view_y, z: view_z, w: view_w } = inset.view
  let #types.Mat4 { x: projection_x, y: projection_y, z: projection_z, w: projection_w } = inset.projection
  return #[
    inset.x, inset.y, inset.width, inset.height, view_x.x, view_x.y, view_x.z,
    view_x.w, view_y.x, view_y.y, view_y.z, view_y.w, view_z.x, view_z.y,
    view_z.z, view_z.w, view_w.x, view_w.y, view_w.z, view_w.w, projection_x.x,
    projection_x.y, projection_x.z, projection_x.w, projection_y.x,
    projection_y.y, projection_y.z, projection_y.w, projection_z.x,
    projection_z.y, projection_z.z, projection_z.w, projection_w.x,
    projection_w.y, projection_w.z, projection_w.w, inset.ambient.x,
    inset.ambient.y, inset.ambient.z, inset.light_direction.x,
    inset.light_direction.y, inset.light_direction.z, inset.light_color.x,
    inset.light_color.y, inset.light_color.z, from inset.draws.length,
    inset.pixel_size,
  ]

// FieldPatch: its material, width, height, x, z, columns, rows, then its values.
const encode_field_patch = fn (field_patch: types.FieldPatch) => do:
  return array.concat #[
    from field_patch.material, from field_patch.width, from field_patch.height,
    from field_patch.x, from field_patch.z, from field_patch.columns,
    from field_patch.rows,
  ] field_patch.values

// UiNode: its id, parent, role, x, y, width, height, focusable, focused,
// disabled, hidden, modal, checked, expanded, selected, live, value, minimum,
// maximum, step, actions, text_length, name_length, description_length, then its
// text.
const encode_ui_node = fn (ui_node: types.UiNode) => do:
  return array.concat #[
    from ui_node.id, from ui_node.parent, from ui_node.role, ui_node.x,
    ui_node.y, ui_node.width, ui_node.height, lanes.bit ui_node.focusable,
    lanes.bit ui_node.focused, lanes.bit ui_node.disabled,
    lanes.bit ui_node.hidden, lanes.bit ui_node.modal, from ui_node.checked,
    from ui_node.expanded, from ui_node.selected, from ui_node.live,
    ui_node.value, ui_node.minimum, ui_node.maximum, ui_node.step,
    from ui_node.actions, from ui_node.text_length, from ui_node.name_length,
    from ui_node.description_length,
  ] ui_node.text

// ServiceRequest: its request, service, operation, a, b, c, d, value_count, then
// its values.
const encode_service_request = fn (service_request: types.ServiceRequest) => do:
  return array.concat #[
    from service_request.request, from service_request.service,
    from service_request.operation, service_request.a, service_request.b,
    service_request.c, service_request.d, from service_request.value_count,
  ] service_request.values

// Bus: A bus: the voices and sounds on it mix through its lowpass and gain into
// the master, and `reverb` of that goes to the shared reverb, as do their own
// sends through its lowpass and gain. Bus 0 is the master: everything passes
// through it last, the reverb's return included.
const encode_bus = fn (bu: types.Bus) => do:
  return #[
    bu.gain, bu.lowpass, bu.reverb,
  ]

// Voice: A voice the game keeps playing, declared by every frame that has it,
// whole. Hosts start a new id from `start`, fading in over `fade_in`; fade out
// an id the frame leaves out over its `fade_out` (at least AUDIO_FADE_MS), and
// one that comes back while fading returns where it is (over its `fade_in`, at
// least AUDIO_FADE_MS); start one whose clip or bus changed afresh, the old
// fading out; and glide the values that change (AUDIO_GLIDE_MS). A voice that
// does not loop plays once and is then silent for as long as frames keep it.
const encode_voice = fn (voice: types.Voice) => do:
  return #[
    from voice.id, from voice.clip, from voice.bus, voice.gain, voice.pan,
    voice.pitch, voice.lowpass, voice.reverb, lanes.bit voice.looping,
    voice.start, voice.fade_in, voice.fade_out,
  ]

// Pose: A layer of a skinned draw's pose: clip `clip` of the draw's mesh at
// `time` seconds, counting `weight` among the draw's layers.
const encode_pose = fn (pose: types.Pose) => do:
  return #[
    from pose.draw, from pose.clip, pose.time, pose.weight,
  ]

// Emitter: A particle emitter: `rate` particles a second, each living `lifetime`
// seconds, born in a ball round `transform`'s origin and flying from it under
// gravity and drag, sized and colored over their lives.
const encode_emitter = fn (emitter: types.Emitter) => do:
  let #types.Mat4 { x: transform_x, y: transform_y, z: transform_z, w: transform_w } = emitter.transform
  return #[
    from emitter.material, transform_x.x, transform_x.y, transform_x.z,
    transform_x.w, transform_y.x, transform_y.y, transform_y.z, transform_y.w,
    transform_z.x, transform_z.y, transform_z.z, transform_z.w, transform_w.x,
    transform_w.y, transform_w.z, transform_w.w, from emitter.seed, emitter.time,
    emitter.duration, emitter.rate, emitter.lifetime, emitter.radius,
    emitter.velocity.x, emitter.velocity.y, emitter.velocity.z, emitter.spread,
    emitter.gravity.x, emitter.gravity.y, emitter.gravity.z, emitter.drag,
    emitter.size_start, emitter.size_end, emitter.color_start.r,
    emitter.color_start.g, emitter.color_start.b, emitter.color_start.a,
    emitter.color_end.r, emitter.color_end.g, emitter.color_end.b,
    emitter.color_end.a, lanes.bit emitter.additive,
  ]

// Light: A point light, or a spot light shining along `direction` within a cone,
// lighting what lies within `radius` of `position`.
const encode_light = fn (light: types.Light) => do:
  return #[
    light.position.x, light.position.y, light.position.z, light.radius,
    light.color.x, light.color.y, light.color.z, light.direction.x,
    light.direction.y, light.direction.z, light.inner, light.outer,
  ]

// Listener: A listener: where it is, the way it faces and its up, in world
// units.
const encode_listener = fn (listener: types.Listener) => do:
  return #[
    listener.position.x, listener.position.y, listener.position.z,
    listener.forward.x, listener.forward.y, listener.forward.z, listener.up.x,
    listener.up.y, listener.up.z,
  ]

// Panner: Where a voice or sound is, as a PannerNode places it: from the
// listener, equal-power panned by its azimuth (in place of its pan), and quieted
// by its distance model and its cone. Positions and orientations glide as gains
// do (AUDIO_GLIDE_MS); the rest change at once. A voice that gains or loses its
// panner starts afresh, as one whose bus changed; a panner that places nothing
// is ignored, and of two for one voice or sound hosts take the first.
const encode_panner = fn (panner: types.Panner) => do:
  return #[
    from panner.voice, from panner.sound, panner.position.x, panner.position.y,
    panner.position.z, panner.orientation.x, panner.orientation.y,
    panner.orientation.z, from panner.distance_model, panner.ref_distance,
    panner.max_distance, panner.rolloff, panner.cone_inner, panner.cone_outer,
    panner.cone_outer_gain,
  ]

// A Draw's extra, at most protocol.max_draw_extra of them, for the packet's last
// section.
const encode_draw_extra = fn (draw: types.Draw) => do:
  let kept = min draw.extra.length protocol.max_draw_extra
  return #[lane | index <- array.generate kept identity, lane <- vec4_lanes draw.extra[index]]

const vec4_lanes = fn (v: types.Vec4) => #[v.x, v.y, v.z, v.w]

// The render packet from `packet`, a record of the header's values by their
// names in protocol/schema.json (grouped ones in a record of their group:
// `quality.msaa`), and of the sections: state, draws, solids, decals, sounds,
// sprites, insets, preferences, fields, ui, services, buses, voices, poses,
// emitters, lights, listener, panners. Its records use Pen's wire types.
const encode_render = fn (packet: types.RenderFrame) => do:
  let solids_encoded = #[encode_solid solid | solid <- packet.solids]
  let solids_lanes = array.fold_left (fn total => fn record => total + record.length) 0 solids_encoded
  let inset_draws = array.flatten #[inset.draws | inset <- packet.insets]
  let fields_encoded = #[encode_field_patch field | field <- packet.fields]
  let fields_lanes = array.fold_left (fn total => fn record => total + record.length) 0 fields_encoded
  let ui_encoded = #[encode_ui_node ui | ui <- packet.ui]
  let ui_lanes = array.fold_left (fn total => fn record => total + record.length) 0 ui_encoded
  let services_encoded = #[encode_service_request service | service <- packet.services]
  let services_lanes = array.fold_left (fn total => fn record => total + record.length) 0 services_encoded
  let #types.Mat4 { x: view_x, y: view_y, z: view_z, w: view_w } = packet.view
  let #types.Mat4 { x: projection_x, y: projection_y, z: projection_z, w: projection_w } = packet.projection
  let #types.Mat4 { x: shadow_view_x, y: shadow_view_y, z: shadow_view_z, w: shadow_view_w } = packet.shadow.view
  let #types.Mat4 { x: shadow_projection_x, y: shadow_projection_y, z: shadow_projection_z, w: shadow_projection_w } = packet.shadow.projection
  return array.flatten #[
    #[
      protocol.packet_magic, from packet.schema, from packet.state.length,
      from packet.draws.length, from packet.solids.length, from solids_lanes,
      from packet.decals.length, from packet.sounds.length,
      from packet.sprites.length, from packet.insets.length,
      from inset_draws.length, from packet.preferences.length,
      lanes.bit packet.save_requested, lanes.bit packet.load_requested,
      lanes.bit packet.scene_save_requested,
      lanes.bit packet.scene_load_requested,
      lanes.bit packet.checkpoint_requested, lanes.bit packet.undo_requested,
      lanes.bit packet.redo_requested, lanes.bit packet.exit_requested,
      view_x.x, view_x.y, view_x.z, view_x.w, view_y.x, view_y.y, view_y.z,
      view_y.w, view_z.x, view_z.y, view_z.z, view_z.w, view_w.x, view_w.y,
      view_w.z, view_w.w, projection_x.x, projection_x.y, projection_x.z,
      projection_x.w, projection_y.x, projection_y.y, projection_y.z,
      projection_y.w, projection_z.x, projection_z.y, projection_z.z,
      projection_z.w, projection_w.x, projection_w.y, projection_w.z,
      projection_w.w, packet.clear.r, packet.clear.g, packet.clear.b,
      packet.clear.a, packet.ambient.x, packet.ambient.y, packet.ambient.z,
      packet.light_direction.x, packet.light_direction.y,
      packet.light_direction.z, packet.light_color.x, packet.light_color.y,
      packet.light_color.z, packet.aberration.x, packet.aberration.y,
      from packet.quality.msaa, lanes.bit packet.quality.fxaa,
      packet.quality.scale, from packet.quality.filtering,
      lanes.bit packet.quality.occlusion, lanes.bit packet.quality.sky,
      lanes.bit packet.quality.effects, packet.sky.zenith.x,
      packet.sky.zenith.y, packet.sky.zenith.z, packet.sky.horizon.x,
      packet.sky.horizon.y, packet.sky.horizon.z, packet.sky.ground.x,
      packet.sky.ground.y, packet.sky.ground.z, packet.sky.sun.x,
      packet.sky.sun.y, packet.sky.sun.z, packet.sky.night, packet.fog.radius,
      packet.fog.density, packet.fog.height, shadow_view_x.x, shadow_view_x.y,
      shadow_view_x.z, shadow_view_x.w, shadow_view_y.x, shadow_view_y.y,
      shadow_view_y.z, shadow_view_y.w, shadow_view_z.x, shadow_view_z.y,
      shadow_view_z.z, shadow_view_z.w, shadow_view_w.x, shadow_view_w.y,
      shadow_view_w.z, shadow_view_w.w, shadow_projection_x.x,
      shadow_projection_x.y, shadow_projection_x.z, shadow_projection_x.w,
      shadow_projection_y.x, shadow_projection_y.y, shadow_projection_y.z,
      shadow_projection_y.w, shadow_projection_z.x, shadow_projection_z.y,
      shadow_projection_z.z, shadow_projection_z.w, shadow_projection_w.x,
      shadow_projection_w.y, shadow_projection_w.z, shadow_projection_w.w,
      packet.shadow.texel, from packet.shadow.texels, packet.blur,
      lanes.bit packet.quality.bloom, packet.clouds.cover,
      packet.clouds.drift.x, packet.clouds.drift.z,
      lanes.bit packet.hide_cursor, from packet.fields.length,
      from fields_lanes, from packet.ui.length, from ui_lanes,
      from packet.services.length, from services_lanes,
      from packet.buses.length, from packet.voices.length,
      from packet.poses.length, from packet.emitters.length,
      lanes.bit packet.quality.taa, from packet.lights.length,
      from packet.listener.length, from packet.panners.length,
    ],
    ...array.flatten #[
      #[packet.state],
      #[encode_draw draw | draw <- packet.draws],
      solids_encoded,
      #[encode_decal decal | decal <- packet.decals],
      #[encode_sound sound | sound <- packet.sounds],
      #[encode_sprite sprite | sprite <- packet.sprites],
      #[encode_inset inset | inset <- packet.insets],
      #[encode_draw inset_draw | inset_draw <- inset_draws],
      #[packet.preferences],
      fields_encoded,
      ui_encoded,
      services_encoded,
      #[encode_bus buse | buse <- packet.buses],
      #[encode_voice voice | voice <- packet.voices],
      #[encode_pose pose | pose <- packet.poses],
      #[encode_emitter emitter | emitter <- packet.emitters],
      #[encode_light light | light <- packet.lights],
      #[encode_listener listener | listener <- packet.listener],
      #[encode_panner panner | panner <- packet.panners],
      #[encode_draw_extra draw | draw <- packet.draws],
      #[encode_draw_extra inset_draw | inset_draw <- inset_draws],
    ],
  ]

// The lanes of the game's own sections, to follow encode_render's: none without
// any, else the marker, their count, then each one's tag, length and values. A
// game's generated pen/extensions.blot makes them from its declarations.
const encode_extensions = fn (extensions: Array types.Extension) => do:
  if extensions.is_empty:
    return #[]
  use lanes.require (extensions.length <= protocol.max_extensions)
  return array.flatten #[
    #[protocol.extensions_marker, from extensions.length],
    array.flatten #[array.concat #[from extension.tag, from extension.values.length] extension.values | extension <- extensions],
  ]
