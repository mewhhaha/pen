// A Draw's lanes.
const encode_draw = func (draw: types.Draw) => return do:
  let $types.Mat4 { x: transform_x, y: transform_y, z: transform_z, w: transform_w } = draw.transform
  let (parameters_count, parameters) = case draw.parameters of
    $Some value => (4.0, value)
    $Nothing => (0.0, types.zero4)
  return #[
    U32.to_f32 (draw.mesh), U32.to_f32 (draw.material), transform_x.x,
    transform_x.y, transform_x.z, transform_x.w, transform_y.x, transform_y.y,
    transform_y.z, transform_y.w, transform_z.x, transform_z.y, transform_z.z,
    transform_z.w, transform_w.x, transform_w.y, transform_w.z, transform_w.w,
    parameters_count, parameters.x, parameters.y, parameters.z, parameters.w,
    U32.to_f32 (min draw.extra.length protocol.max_draw_extra),
