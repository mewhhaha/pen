  stream.output[base + 0] := canonical[at + 0]
  stream.output[base + 1] := canonical[at + 1]
  stream.output[base + 2] := canonical[at + 2]
  at := at + 3
  stream.output[base + 3] := canonical[at + 0]
  stream.output[base + 4] := canonical[at + 1]
  stream.output[base + 5] := canonical[at + 2]
  at := at + 3
  stream.output[base + 6] := canonical[at + 0]
  stream.output[base + 7] := canonical[at + 1]
  stream.output[base + 8] := canonical[at + 2]
  at := at + 3
  stream.at := at
  return stream

func panner_into (canonical: #[F32]) -> (stream: own Stream): Stream =>
  let at = stream.at
  let base = stream.output.length
  for 0 .. 15:
    @storage.push stream.output 0.0
  stream.output[base + 0] := canonical[at + 0]
  at := at + 1
  stream.output[base + 1] := canonical[at + 0]
  at := at + 1
  stream.output[base + 2] := canonical[at + 0]
  stream.output[base + 3] := canonical[at + 1]
  stream.output[base + 4] := canonical[at + 2]
  at := at + 3
  stream.output[base + 5] := canonical[at + 0]
  stream.output[base + 6] := canonical[at + 1]
  stream.output[base + 7] := canonical[at + 2]
  at := at + 3
  stream.output[base + 8] := canonical[at + 0]
  at := at + 1
  stream.output[base + 9] := canonical[at + 0]
  at := at + 1
  stream.output[base + 10] := canonical[at + 0]
  at := at + 1
  stream.output[base + 11] := canonical[at + 0]
  at := at + 1
  stream.output[base + 12] := canonical[at + 0]
  at := at + 1
  stream.output[base + 13] := canonical[at + 0]
  at := at + 1
  stream.output[base + 14] := canonical[at + 0]
  at := at + 1
  stream.at := at
  return stream

func instance_into (canonical: #[F32]) -> (stream: own Stream): Stream =>
  let at = stream.at
  let base = stream.output.length
  for 0 .. 26:
    @storage.push stream.output 0.0
  stream.output[base + 0] := canonical[at + 0]
  at := at + 1
  stream.output[base + 1] := canonical[at + 0]
  at := at + 1
  stream.output[base + 2] := canonical[at + 0]
  at := at + 1
  stream.output[base + 3] := canonical[at + 0]
  at := at + 1
  stream.output[base + 4] := canonical[at + 0]
  at := at + 1
  stream.output[base + 5] := canonical[at + 0]
  stream.output[base + 6] := canonical[at + 1]
  stream.output[base + 7] := canonical[at + 2]
  stream.output[base + 8] := canonical[at + 3]
  stream.output[base + 9] := canonical[at + 4]
  stream.output[base + 10] := canonical[at + 5]
  stream.output[base + 11] := canonical[at + 6]
  stream.output[base + 12] := canonical[at + 7]
  stream.output[base + 13] := canonical[at + 8]
  stream.output[base + 14] := canonical[at + 9]
  stream.output[base + 15] := canonical[at + 10]
  stream.output[base + 16] := canonical[at + 11]
  stream.output[base + 17] := canonical[at + 12]
  stream.output[base + 18] := canonical[at + 13]
  stream.output[base + 19] := canonical[at + 14]
  stream.output[base + 20] := canonical[at + 15]
  at := at + 16
  let present = lanes.integer canonical[at] 1
  at := at + 1
  if present == 1:
    stream.output[base + 21] := 4.0
    stream.output[base + 22] := canonical[at + 0]
    stream.output[base + 23] := canonical[at + 1]
    stream.output[base + 24] := canonical[at + 2]
    stream.output[base + 25] := canonical[at + 3]
    at := at + 4
  stream.at := at
  return stream

func instance_removal_into (canonical: #[F32]) -> (stream: own Stream): Stream =>
  let at = stream.at
  let base = stream.output.length
  for 0 .. 2:
    @storage.push stream.output 0.0
  stream.output[base + 0] := canonical[at + 0]
  at := at + 1
  stream.output[base + 1] := canonical[at + 0]
  at := at + 1
  stream.at := at
  return stream

// Canonical render values streamed into the packet it is given and returns.
func render_packet_from_canonical (canonical: #[F32]) -> (output: own #[~F32]): #[~F32] =>
  lanes.finite canonical
  @storage.truncate output 0
  for 0 .. protocol.packet_header_floats:
    @storage.push output 0.0
  let children: #[~F32] = #[]
