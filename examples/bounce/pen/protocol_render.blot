    let face = faces[index]
    let start = protocol.solid_floats + index * protocol.solid_face_floats
    encoded[start] := face.normal.x
    encoded[start + 1] := face.normal.y
    encoded[start + 2] := face.normal.z
    encoded[start + 3] := face.distance
    encoded[start + 4] := U32.to_f32 (face.material)
  return encoded

