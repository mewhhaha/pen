// The game's side of Pen's exact cross-language packet properties.
import * as canonical from "pen/protocol_canonical"
import * as protocol from "pen/protocol"
import * as views from "pen/protocol_views_test"

#entry const input_round_trip = func (lanes: #[F32]) =>
  let events: #[protocol.Event] = #[]
  let input = protocol.decode_input_into lanes events
  return canonical.canonical_input input

const render_packet = func (lanes: #[F32]) =>
  let output: #[F32] = #[]
  return canonical.render_packet_from_canonical lanes output

#entry const render_stream_round_trip = func lanes => render_packet lanes

// The same canonical inputs also pass through the actual production encoder.
#entry const render_round_trip = func lanes =>
  let packet = render_packet lanes
  let destination: #[F32] = #[]
  return views.reencode_views packet destination
