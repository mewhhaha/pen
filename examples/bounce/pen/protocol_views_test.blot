  let collections = { state, draws, solids, decals, sounds, sprites, insets, preferences, fields, ui, services, buses, voices, poses, emitters, lights, probes, listener, panners, instances, instance_removals }
  let project = { draw_metadata, draw_transform, draw_parameters, extra_count, append_extra, inset_draws, sprite_rect, sprite_color, sprite_parameters, instance_metadata, instance_transform, instance_parameters, solid: project_solid, decal: project_decal, sound: project_sound, inset: project_inset, inset_draw: project_inset_draw, field: project_field, ui: project_ui, service: project_service, buse: project_buse, voice: project_voice, pose: project_pose, emitter: project_emitter, light: project_light, probe: project_probe, listener: project_listener, panner: project_panner, instance_removal: project_instance_removal }
  return renderer.encode_render_views header collections project context destination
