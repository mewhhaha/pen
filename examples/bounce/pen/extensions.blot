// Generated by pen codegen from this checkout's pen.json `protocol`:
// declare the game's events and sections there and run `pen codegen`, not this file.
//
// The game's own events and render sections, which its pen.json declares
// under `protocol`, beside pen's. Its `main` serves it with `run` here.
import * as array from "std/array"
import * as lanes from "./lanes"
import * as program from "./program"
import * as protocol from "./protocol"
import * as render from "./protocol_render"
import * as types from "./types"

// Each event's and section's tag.
const kick_tag = 1
const score_tag = 1

// The events the host sends: pen's, and the game's own.
// Kick: Pushes the ball: adds to its velocity along x and z, in units a second.
type Event is data =
  | #Pen protocol.Event
  | #Kick { x: F32, z: F32 }

type Input is data = #Input { elapsed: F32, width: F32, height: F32, events: Array Event, state: Array F32 }

// An event's lanes from `start`: one of pen's, or one of the game's, which
// travels as pen's Game event: its tag, then its values in the lanes after,
// those it has no field for zero.
const decode_event = fn (values: Array F32) => fn (start: U32) => do:
  if values[start] != U32.to_f32 protocol.game_tag:
    return #Pen (protocol.decode_event values start)
  let tag = lanes.integer values[start + 1] protocol.max_extension_tag
  let lanes_after = #[values[start + 2], values[start + 3], values[start + 4]]
  return case tag of
    1 => do:
      use lanes.require (lanes_after[2] == 0.0)
      return #Kick { x: lanes_after[0], z: lanes_after[1] }
    _ => @panic "unknown game event"

// The input packet, as protocol.decode_input reads it, with the game's own
// events.
const decode_input = fn (values: Array F32) => do:
  use lanes.require (values.length >= protocol.frame_header_floats)
  use lanes.finite values
  let elapsed = values[0]
  use lanes.require (elapsed >= 0.0)
  let width = values[1]
  let height = values[2]
  use lanes.require (width > 0.0)
  use lanes.require (height > 0.0)
  let event_count = lanes.integer values[3] protocol.max_events
  let state_count = lanes.integer values[4] protocol.max_state_floats
  let state_start = protocol.frame_header_floats + event_count * protocol.event_floats
  use lanes.require (values.length == state_start + state_count)
  return #Input {
    state: array.slice state_start state_count values,
    elapsed, width, height,
    events: array.generate event_count (fn index => decode_event values (protocol.frame_header_floats + index * protocol.event_floats)),
  }

// Score: How the ball is doing, every frame: how often it has hit a wall, and
// how fast it goes.
type Score is data = #Score { bounces: U32, speed: F32 }
const score_floats = 2
// The section of these Scores, for the frame's extensions.
const encode_score = fn (records: Array Score) => #types.Extension {
  tag: score_tag,
  values: array.flatten #[#[from record.bounces, record.speed] | record <- records],
}

// One frame through pen's packets with the game's own: `step` takes a world and
// the input, and returns the next world, the frame to draw and the game's
// sections (each from its encode_ function).
const step_packets = fn step => fn world => fn (payload: Array F32) => do:
  let (next, drawn, extensions) = step world (decode_input payload)
  return (next, array.concat (render.encode_render drawn) (render.encode_extensions extensions))

// program.run with the game's own events and sections: `game` has program.run's
// schema, create, save and restore, and step_packets' `step`.
const run = fn game => fn host => program.serve {
  schema: game.schema,
  create: game.create,
  frame: step_packets game.step,
  save: game.save,
  restore: game.restore,
} host
