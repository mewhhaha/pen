const panner_list_from = fn (canonical: Array F32) => fn (at: U32) => do:
  let count = lanes.integer canonical[at] lanes.max_integer
  let items = #[]
  let next = at + 1
  for 0 .. count:
    let (item, item_end) = panner_from canonical next
    items := array.push item self
    next := item_end
  return (items, next)

const quality_from = fn (canonical: Array F32) => fn (at: U32) => do:
  let (msaa, msaa_end) = u32_from canonical at
  let (fxaa, fxaa_end) = bool_from canonical msaa_end
  let (scale, scale_end) = f32_from canonical fxaa_end
  let (filtering, filtering_end) = u32_from canonical scale_end
  let (occlusion, occlusion_end) = bool_from canonical filtering_end
  let (sky, sky_end) = bool_from canonical occlusion_end
  let (effects, effects_end) = bool_from canonical sky_end
  let (bloom, bloom_end) = bool_from canonical effects_end
  let (taa, taa_end) = bool_from canonical bloom_end
  let built = #types.Quality {
    msaa, fxaa, scale, filtering, occlusion, sky, effects, bloom, taa,
  }
  return (built, taa_end)

const sky_from = fn (canonical: Array F32) => fn (at: U32) => do:
  let (zenith, zenith_end) = vector_from canonical at
  let (horizon, horizon_end) = vector_from canonical zenith_end
  let (ground, ground_end) = vector_from canonical horizon_end
  let (sun, sun_end) = vector_from canonical ground_end
  let (night, night_end) = f32_from canonical sun_end
  return (#types.Sky { zenith, horizon, ground, sun, night }, night_end)

const fog_from = fn (canonical: Array F32) => fn (at: U32) => do:
  let (radius, radius_end) = f32_from canonical at
  let (density, density_end) = f32_from canonical radius_end
  let (height, height_end) = f32_from canonical density_end
  return (#types.Fog { radius, density, height }, height_end)

const shadow_from = fn (canonical: Array F32) => fn (at: U32) => do:
  let (view, view_end) = mat4_from canonical at
  let (projection, projection_end) = mat4_from canonical view_end
  let (texel, texel_end) = f32_from canonical projection_end
  let (texels, texels_end) = u32_from canonical texel_end
  return (#types.Shadow { view, projection, texel, texels }, texels_end)

const clouds_from = fn (canonical: Array F32) => fn (at: U32) => do:
  let (cover, cover_end) = f32_from canonical at
  let (drift, drift_end) = drift_from canonical cover_end
  return (#types.Clouds { cover, drift }, drift_end)

// The record the game encodes, from the render walk pen-protocol's
// canonical_render makes of a frame, its schema and its state. Anything else
// traps.
const render_from_canonical = fn (canonical: Array F32) => do:
  let (schema, schema_end) = u32_from canonical 0
  let (save_requested, save_requested_end) = bool_from canonical schema_end
  let (load_requested, load_requested_end) = bool_from canonical save_requested_end
  let (scene_save_requested, scene_save_requested_end) = bool_from canonical load_requested_end
  let (scene_load_requested, scene_load_requested_end) = bool_from canonical scene_save_requested_end
  let (checkpoint_requested, checkpoint_requested_end) = bool_from canonical scene_load_requested_end
  let (undo_requested, undo_requested_end) = bool_from canonical checkpoint_requested_end
  let (redo_requested, redo_requested_end) = bool_from canonical undo_requested_end
  let (exit_requested, exit_requested_end) = bool_from canonical redo_requested_end
  let (view, view_end) = mat4_from canonical exit_requested_end
  let (projection, projection_end) = mat4_from canonical view_end
  let (clear, clear_end) = color_from canonical projection_end
  let (ambient, ambient_end) = vector_from canonical clear_end
  let (light_direction, light_direction_end) = vector_from canonical ambient_end
  let (light_color, light_color_end) = vector_from canonical light_direction_end
  let (aberration, aberration_end) = aberration_from canonical light_color_end
  let (quality, quality_end) = quality_from canonical aberration_end
  let (sky, sky_end) = sky_from canonical quality_end
  let (fog, fog_end) = fog_from canonical sky_end
  let (shadow, shadow_end) = shadow_from canonical fog_end
  let (blur, blur_end) = f32_from canonical shadow_end
  let (clouds, clouds_end) = clouds_from canonical blur_end
  let (hide_cursor, hide_cursor_end) = bool_from canonical clouds_end
  let (loading, loading_end) = bool_from canonical hide_cursor_end
  let (show_captions, show_captions_end) = bool_from canonical loading_end
  let (state, state_end) = floats_from canonical show_captions_end
  let (draws, draws_end) = draw_list_from canonical state_end
  let (solids, solids_end) = solid_list_from canonical draws_end
  let (decals, decals_end) = decal_list_from canonical solids_end
  let (sounds, sounds_end) = sound_list_from canonical decals_end
  let (sprites, sprites_end) = sprite_list_from canonical sounds_end
  let (insets, insets_end) = inset_list_from canonical sprites_end
  let (preferences, preferences_end) = maybe_floats_from canonical insets_end
  let (fields, fields_end) = field_patch_list_from canonical preferences_end
  let (ui, ui_end) = ui_node_list_from canonical fields_end
  let (services, services_end) = service_request_list_from canonical ui_end
  let (buses, buses_end) = bus_list_from canonical services_end
  let (voices, voices_end) = voice_list_from canonical buses_end
  let (poses, poses_end) = pose_list_from canonical voices_end
  let (emitters, emitters_end) = emitter_list_from canonical poses_end
  let (lights, lights_end) = light_list_from canonical emitters_end
  let (listener, listener_end) = listener_list_from canonical lights_end
  let (panners, panners_end) = panner_list_from canonical listener_end
  use lanes.require (panners_end == canonical.length)
  return #types.RenderFrame {
    schema, save_requested, load_requested, scene_save_requested,
    scene_load_requested, checkpoint_requested, undo_requested, redo_requested,
    exit_requested, view, projection, clear, ambient, light_direction,
    light_color, aberration, quality, sky, fog, shadow, blur, clouds,
    hide_cursor, loading, show_captions, state, draws, solids, decals, sounds,
    sprites, insets, preferences, fields, ui, services, buses, voices, poses,
    emitters, lights, listener, panners,
  }
